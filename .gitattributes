# 文本文件统一仓库存LF，Windows检出为CRLF
* text=auto eol=lf

# 专门针对你的工程文件强制LF（嵌入式编译刚需）
*.c        text eol=lf
*.h        text eol=lf
*.ld       text eol=lf
*.Makefile text eol=lf
Makefile*  text eol=lf
*.py       text eol=lf
*.txt      text eol=lf
*.yaml     text eol=lf
*.j2       text eol=lf
.gitignore text eol=lf

# 二进制文件不处理换行
*.bin      binary
*.elf      binary
*.hex      binary
*.pdf      binary
*.png      binary