$(FREERTOS_DIR)/portable/MemMang/heap_4.c \
$(FREERTOS_DIR)/portable/GCC/ARM_CM0/port.c \
$(FREERTOS_DIR)/portable/GCC/ARM_CM0/portasm.c

# User application
C_SOURCES += \
./src/main.c \
./src/gpio.c \
./src/sleep.c \
./src/stm32g0xx_it.c \
./src/event_mgr.c \
./src/stm32g0xx_hal_timebase_tim.c \
./src/statemachine.c \
./src/drivers/drv_rtc.c \
./src/drivers/drv_uart_debug.c \
./src/drivers/drv_log.c \

# Assembly startup
ASM_SOURCES = $(STARTUP_DIR)/startup_stm32g0b1xx.s

# Include paths
INCLUDES  = \
-I$(HAL_DIR)/Inc \
-I$(CMSIS_DEVICE_DIR)/Include \
-I$(CMSIS_CORE_DIR) \
-I$(FREERTOS_DIR)/include \
-I$(FREERTOS_DIR)/portable/GCC/ARM_CM0 \
-I./src \
-I./src/drivers \
-I./config

# Compiler / Linker flags
CFLAGS   = $(MCU_FLAGS) $(CPU_DEFINE) $(CLOCK_DEFINE) \
           -Og -g3 -Wall -fdata-sections -ffunction-sections \
           $(INCLUDES) -DSTM32G0B1xx -DUSE_HAL_DRIVER

# ---------------------------------------------------------------------------
# Linker flags (common)
# ---------------------------------------------------------------------------
LDFLAGS  = $(MCU_FLAGS) -T$(LINKER_SCRIPT) -specs=nano.specs -specs=nosys.specs \
           -Wl,--gc-sections -Wl,-Map=$(BUILD_DIR)/$(PROJECT_NAME).map

# ---------------------------------------------------------------------------
# Object files (flat structure inside build/)
# ---------------------------------------------------------------------------
BUILD_DIR   = build
C_OBJS      = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o)))
ASM_OBJS    = $(addprefix $(BUILD_DIR)/,$(notdir $(ASM_SOURCES:.s=.o)))
OBJS        = $(C_OBJS) $(ASM_OBJS)

# ---------------------------------------------------------------------------
# Build rules
# ---------------------------------------------------------------------------
.PHONY: all flash flash-daplink clean test coverage
all: $(BUILD_DIR)/$(PROJECT_NAME).elf $(BUILD_DIR)/$(PROJECT_NAME).bin $(BUILD_DIR)/$(PROJECT_NAME).hex

# ----- Build directory (order-only, cross-platform) -----
$(BUILD_DIR):
	@mkdir $@ 2>nul || mkdir $@ 2>/dev/null || true

# ----- User source files -----
$(BUILD_DIR)/%.o: ./src/%.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

# ----- HAL source files -----
$(BUILD_DIR)/%.o: $(HAL_DIR)/Src/%.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

# ----- CMSIS Device system file -----
$(BUILD_DIR)/system_stm32g0xx.o: $(CMSIS_DEVICE_DIR)/Source/Templates/system_stm32g0xx.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

# ----- FreeRTOS Kernel source files -----
$(BUILD_DIR)/%.o: $(FREERTOS_DIR)/%.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/port.o: $(FREERTOS_DIR)/portable/GCC/ARM_CM0/port.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/portasm.o: $(FREERTOS_DIR)/portable/GCC/ARM_CM0/portasm.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/heap_4.o: $(FREERTOS_DIR)/portable/MemMang/heap_4.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

# ----- Driver source files -----
$(BUILD_DIR)/%.o: ./src/drivers/%.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@


# ----- Startup assembly -----
$(BUILD_DIR)/%.o: $(STARTUP_DIR)/%.s | $(BUILD_DIR)
	$(AS) $(MCU_FLAGS) -c $< -o $@

# ----- Link -----
$(BUILD_DIR)/$(PROJECT_NAME).elf: $(OBJS)
	$(CC) $(LDFLAGS) $(OBJS) -o $@
	$(SZ) $@

# ----- Binary / Hex -----
$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf
	$(CP) -O binary $< $@

$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf
	$(CP) -O ihex $< $@

# ----- Flash (ST-Link) -----
flash: $(BUILD_DIR)/$(PROJECT_NAME).bin
	"$(STM32_PROG_CLI)" -c port=SWD -w $< 0x08000000 -rst

# ----- Flash (DAP-Link) -----
flash-daplink: $(BUILD_DIR)/$(PROJECT_NAME).bin
	"$(OPENOCD)" $(OPENOCD_IFACE_CFG) $(OPENOCD_TARGET_CFG) $(OPENOCD_EXTRA) -c "program $< 0x08000000 verify reset exit"


# ----- Clean -----
clean:
	-rm -rf $(BUILD_DIR)

# ----- Unit tests -----
test:
	python test/run_tests.py

coverage:
	python test/run_tests.py --coverage

