#include "unity.h"
#include "mock_hal.h"
#include <string.h>

/* 提供 event_queue 供 defer 使用 */
QueueHandle_t event_queue = NULL;
#include "../src/drivers/drv_rtc.c"
#include "../src/statemachine.c"

static int led_notify_count = 0;
void led_task_notify(void) {
    led_notify_count++;
}

void setUp(void) {
    led_notify_count = 0;
    statemachine_init();
}

void tearDown(void) {}

/* 测试子状态进入：BUTTON_PRESS 进入 PROCESS，应自动进入子状态 STEP1 */
void test_enter_substate_on_button_press(void) {
    event_t evt = { .id = EVENT_BUTTON_PRESS };
    statemachine_process(&evt);
    /* 状态应变为 PROCESS，但子状态栈顶部为 PROCESS，当前状态应为 STEP1 */
    /* 由于无法直接读取静态变量，我们通过触发 RTC_TICK 观察行为 */
    /* 当前在 STEP1，触发 RTC_TICK 会进入 STEP2 */
    event_t tick = { .id = EVENT_RTC_TICK };
    statemachine_process(&tick);
    /* 在 STEP2 再触发一次 RTC_TICK 应触发 return，最终回到 IDLE */
    statemachine_process(&tick);
    /* 检查 LED 翻转次数：进入 PROCESS 时 toggle_led 一次，
       defer 动作不影响，return 后回到 IDLE 又 toggle_led 一次，
       整个过程共 2 次 LED 通知（IDLE->PROCESS 一次，PROCESS->IDLE 一次） */
    TEST_ASSERT_EQUAL(2, led_notify_count);
}

/* 测试 return 动作是否正确产生 EVENT_RETURN 并回到父状态 */
void test_return_from_substate(void) {
    /* 先进入 PROCESS */
    event_t press = { .id = EVENT_BUTTON_PRESS };
    statemachine_process(&press);
    /* 此时在 STEP1，发送 RTC_TICK 到 STEP2 */
    event_t tick1 = { .id = EVENT_RTC_TICK };
    statemachine_process(&tick1);
    /* 现在在 STEP2，再次发送 RTC_TICK 触发 return */
    event_t tick2 = { .id = EVENT_RTC_TICK };
    statemachine_process(&tick2);
    /* return 动作产生 EVENT_RETURN，父状态 PROCESS 的转换应被触发，进入 IDLE */
    /* LED 应已翻转两次（同上） */
    TEST_ASSERT_EQUAL(2, led_notify_count);
    /* 再发送一次 RTC_TICK，不应有任何动作 */
    led_notify_count = 0;
    event_t tick3 = { .id = EVENT_RTC_TICK };
    statemachine_process(&tick3);
    TEST_ASSERT_EQUAL(0, led_notify_count);
}

int main(void) {
    UNITY_BEGIN();
    RUN_TEST(test_enter_substate_on_button_press);
    RUN_TEST(test_return_from_substate);
    return UNITY_END();
}