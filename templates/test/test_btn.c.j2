/**
 * @file  test_btn.c
 * @brief Button component unit tests — gesture detection (generated by hw2c)
 *
 * Injects raw BUTTON_PRESS/BUTTON_RELEASE events into a mock btn_queue,
 * then calls btn_step() to advance the gesture detection state machine.
 * Verifies the correct high-level gesture event is published to event_queue.
 */

#include "unity.h"
#include "mock_hal.h"
#include "../src/component_registry.h"
#include "../src/event_mgr.h"
#include "../src/btn_component.h"
{% if has_params %}
#include "../src/param_registry.h"
{% endif %}

/* ---- Stubs needed by included component sources ---- */
uint32_t rtc_uptime_sec = 0;

/* ---- event_queue / btn_queue — defined here for btn_component.c ---- */
QueueHandle_t event_queue = NULL;
QueueHandle_t btn_queue = NULL;

/* ---- Include source files directly (SIL pattern) ---- */
{% if has_params %}
#include "../src/param_registry.c"
{% endif %}
#include "../src/btn_component.c"

/* ---- Test context ---- */
static component_t btn_comp;

/* Helpers: create a raw event_t */
static event_t make_raw_event(uint32_t id, uint32_t param)
{
    event_t e;
    e.id = id;
    e.param = param;
    return e;
}

void setUp(void)
{
    memset(&btn_comp, 0, sizeof(btn_comp));
    mock_queue_reset();
    mock_task_set_tick_count(0);
    /* Use distinct pointers so queue identity checks work */
    event_queue = (QueueHandle_t)0x1000;
    btn_queue    = (QueueHandle_t)0x2000;
{% if has_params %}
    param_init();
{% endif %}
}

void tearDown(void) {}

/* --------------------------------------------------------------------------
 * Init tests
 * -------------------------------------------------------------------------- */

void test_btn_init_sets_context(void)
{
    int ret = btn_init(&btn_comp, NULL);
    TEST_ASSERT_EQUAL_INT(0, ret);
    TEST_ASSERT_NOT_NULL(btn_comp.ctx);
}

/* --------------------------------------------------------------------------
 * SHORT PRESS detection
 *   press → release (<long threshold) → timeout → SHORT_PRESS
 * -------------------------------------------------------------------------- */

void test_btn_short_press_emits_event(void)
{
    btn_init(&btn_comp, NULL);

    /* Inject PRESS */
    event_t raw_press = make_raw_event(EVENT_BUTTON_PRESS, GPIO_PIN_13);
    mock_queue_inject(btn_queue, &raw_press, sizeof(raw_press));
    btn_step(&btn_comp);

    /* Inject RELEASE (held < long_press threshold, default 1000ms i.e. 1000 ticks) */
    event_t raw_release = make_raw_event(EVENT_BUTTON_RELEASE, GPIO_PIN_13);
    mock_queue_inject(btn_queue, &raw_release, sizeof(raw_release));
    btn_step(&btn_comp);

    /* Advance time past double-click window (500ms default) */
    mock_task_set_tick_count(501);
    btn_step(&btn_comp);

    /* Verify SHORT_PRESS was published to event_queue */
    TEST_ASSERT_EQUAL_PTR(event_queue, mock_xQueueSend_get_last_queue());
    {
        event_t published;
        mock_xQueueSend_get_last_item(&published, sizeof(published));
        TEST_ASSERT_EQUAL_UINT32(EVENT_BUTTON_SHORT_PRESS, published.id);
    }
}

/* --------------------------------------------------------------------------
 * LONG PRESS detection
 *   press → hold ≥ long_press_threshold → release → LONG_PRESS
 * -------------------------------------------------------------------------- */

void test_btn_long_press_emits_event(void)
{
    btn_init(&btn_comp, NULL);

    /* Inject PRESS at tick 0 */
    mock_task_set_tick_count(0);
    event_t raw_press = make_raw_event(EVENT_BUTTON_PRESS, GPIO_PIN_13);
    mock_queue_inject(btn_queue, &raw_press, sizeof(raw_press));
    btn_step(&btn_comp);

    /* Inject RELEASE after 3001 ticks (>= 3000ms threshold) */
    mock_task_set_tick_count(3001);
    event_t raw_release = make_raw_event(EVENT_BUTTON_RELEASE, GPIO_PIN_13);
    mock_queue_inject(btn_queue, &raw_release, sizeof(raw_release));
    btn_step(&btn_comp);

    /* Verify LONG_PRESS was published */
    {
        event_t published;
        mock_xQueueSend_get_last_item(&published, sizeof(published));
        TEST_ASSERT_EQUAL_UINT32(EVENT_BUTTON_LONG_PRESS, published.id);
    }
}

/* --------------------------------------------------------------------------
 * DOUBLE PRESS detection
 *   press1 → release1 → press2 (within window) → DOUBLE_PRESS
 * -------------------------------------------------------------------------- */

void test_btn_double_press_emits_event(void)
{
    btn_init(&btn_comp, NULL);

    /* First PRESS at tick 0 */
    mock_task_set_tick_count(0);
    event_t press1 = make_raw_event(EVENT_BUTTON_PRESS, GPIO_PIN_13);
    mock_queue_inject(btn_queue, &press1, sizeof(press1));
    btn_step(&btn_comp);

    /* RELEASE at tick 100 (short press) */
    mock_task_set_tick_count(100);
    event_t release1 = make_raw_event(EVENT_BUTTON_RELEASE, GPIO_PIN_13);
    mock_queue_inject(btn_queue, &release1, sizeof(release1));
    btn_step(&btn_comp);

    /* Second PRESS at tick 300 (within 500ms window) */
    mock_task_set_tick_count(300);
    event_t press2 = make_raw_event(EVENT_BUTTON_PRESS, GPIO_PIN_13);
    mock_queue_inject(btn_queue, &press2, sizeof(press2));
    btn_step(&btn_comp);

    /* Verify DOUBLE_PRESS was published */
    {
        event_t published;
        mock_xQueueSend_get_last_item(&published, sizeof(published));
        TEST_ASSERT_EQUAL_UINT32(EVENT_BUTTON_DOUBLE_PRESS, published.id);
    }
}

/* --------------------------------------------------------------------------
 * Bounce / edge case tests
 * -------------------------------------------------------------------------- */

void test_btn_idle_release_is_ignored(void)
{
    btn_init(&btn_comp, NULL);

    /* RELEASE while IDLE (bounce) — should not publish anything */
    event_t raw = make_raw_event(EVENT_BUTTON_RELEASE, GPIO_PIN_13);
    mock_queue_inject(btn_queue, &raw, sizeof(raw));
    btn_step(&btn_comp);

    /* No event should have been sent (queue remains NULL) */
    TEST_ASSERT_NULL(mock_xQueueSend_get_last_queue());
}

void test_btn_pressed_twice_is_ignored(void)
{
    btn_init(&btn_comp, NULL);

    /* First PRESS */
    event_t p1 = make_raw_event(EVENT_BUTTON_PRESS, GPIO_PIN_13);
    mock_queue_inject(btn_queue, &p1, sizeof(p1));
    btn_step(&btn_comp);

    /* Second PRESS while already PRESSED (bounce) */
    event_t p2 = make_raw_event(EVENT_BUTTON_PRESS, GPIO_PIN_13);
    mock_queue_inject(btn_queue, &p2, sizeof(p2));
    btn_step(&btn_comp);

    /* Release and check — should emit SHORT_PRESS (not DOUBLE_PRESS) */
    mock_task_set_tick_count(100);
    event_t rel = make_raw_event(EVENT_BUTTON_RELEASE, GPIO_PIN_13);
    mock_queue_inject(btn_queue, &rel, sizeof(rel));
    btn_step(&btn_comp);

    mock_task_set_tick_count(601);
    btn_step(&btn_comp);

    {
        event_t published;
        mock_xQueueSend_get_last_item(&published, sizeof(published));
        TEST_ASSERT_EQUAL_UINT32(EVENT_BUTTON_SHORT_PRESS, published.id);
    }
}

