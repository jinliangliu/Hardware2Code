{#
    test_cli.c.j2 - hw2c_cli engine unit tests

    Exercises the actual CLI engine used by the generated shell driver:
    line editor, tokenizer, command dispatch, unknown-command handling,
    help listing, and buffer overflow protection.  The engine is pure C
    (IO via callback), so no HAL/FreeRTOS mocks are required.
#}
#include "unity.h"
#include <string.h>
#include <stdio.h>

#include "hw2c_cli.h"
#include "../../../static/hw2c_cli/hw2c_cli.c"

/* ---------- output capture ---------- */
static char  g_out[1024];
static int   g_out_len = 0;

static void test_putc(char c)
{
    if (g_out_len < (int)sizeof(g_out) - 1) {
        g_out[g_out_len++] = c;
    }
}

static void out_reset(void)
{
    g_out_len = 0;
    g_out[0] = '\0';
}

static const char *out_str(void)
{
    g_out[g_out_len] = '\0';
    return g_out;
}

/* ---------- test commands ---------- */
static int  g_cmd1_calls = 0;
static int  g_cmd2_argc  = 0;
static char g_cmd2_argv[4][32];

static void cmd_test1(int argc, char *argv[], hw2c_cli_t *cli)
{
    (void)argc;
    (void)argv;
    g_cmd1_calls++;
    hw2c_cli_puts(cli, "cmd1 ok\r\n");
}

static void cmd_test2(int argc, char *argv[], hw2c_cli_t *cli)
{
    int i;
    g_cmd2_argc = argc;
    for (i = 0; i < argc && i < 4; i++) {
        strncpy(g_cmd2_argv[i], argv[i], sizeof(g_cmd2_argv[i]) - 1);
        g_cmd2_argv[i][sizeof(g_cmd2_argv[i]) - 1] = '\0';
    }
    hw2c_cli_puts(cli, "cmd2 ok\r\n");
}

static void cmd_help(int argc, char *argv[], hw2c_cli_t *cli)
{
    (void)argc;
    (void)argv;
    hw2c_cli_print_help(cli);
}

static const hw2c_cli_cmd_t test_cmds[] = {
    {"test1", "Test command one",  cmd_test1},
    {"test2", "Test command two",  cmd_test2},
    {"help",  "Show help listing", cmd_help},
};

/* ---------- fixture ---------- */
static hw2c_cli_t  g_cli;
static char        g_line[HW2C_CLI_CFG_MAX_CMD_LEN];
static char        g_hist[HW2C_CLI_CFG_HISTORY_DEPTH * HW2C_CLI_CFG_MAX_CMD_LEN];

static void cli_setup(void)
{
    memset(&g_cli, 0, sizeof(g_cli));
    g_cli.line_buf  = g_line;
    g_cli.line_size = sizeof(g_line);
    g_cli.putc      = test_putc;
#if HW2C_CLI_CFG_HISTORY
    g_cli.hist_buf  = g_hist;
#endif
    hw2c_cli_init(&g_cli);
    hw2c_cli_register_static(&g_cli, test_cmds,
                             (uint16_t)(sizeof(test_cmds) / sizeof(test_cmds[0])));
    g_cmd1_calls = 0;
    g_cmd2_argc  = 0;
    out_reset();
}

void setUp(void)    { cli_setup(); }
void tearDown(void) { }

/* ---------- tests ---------- */

void test_cli_echo_printable_char(void)
{
    hw2c_cli_input(&g_cli, (uint8_t)'a');
    TEST_ASSERT_EQUAL_CHAR('a', g_line[0]);
    TEST_ASSERT_EQUAL_INT(1, (int)g_cli.line_len);
}

void test_cli_executes_registered_command(void)
{
    const char *cmd = "test1\r";
    const char *p = cmd;
    while (*p) {
        hw2c_cli_input(&g_cli, (uint8_t)*p);
        p++;
    }
    TEST_ASSERT_EQUAL_INT(1, g_cmd1_calls);
    TEST_ASSERT_TRUE(strstr(out_str(), "cmd1 ok") != NULL);
}

void test_cli_tokenizes_arguments(void)
{
    const char *cmd = "test2 alpha beta gamma\r";
    const char *p = cmd;
    while (*p) {
        hw2c_cli_input(&g_cli, (uint8_t)*p);
        p++;
    }
    TEST_ASSERT_EQUAL_INT(4, g_cmd2_argc);
    TEST_ASSERT_EQUAL_STRING("test2",   g_cmd2_argv[0]);
    TEST_ASSERT_EQUAL_STRING("alpha",   g_cmd2_argv[1]);
    TEST_ASSERT_EQUAL_STRING("beta",    g_cmd2_argv[2]);
    TEST_ASSERT_EQUAL_STRING("gamma",   g_cmd2_argv[3]);
}

void test_cli_unknown_command_prints_help_hint(void)
{
    const char *cmd = "nosuchcmd\r";
    const char *p = cmd;
    while (*p) {
        hw2c_cli_input(&g_cli, (uint8_t)*p);
        p++;
    }
    /* Engine must not crash and should respond with an unknown hint. */
    TEST_ASSERT_TRUE(g_out_len > 0);
}

void test_cli_help_lists_registered_commands(void)
{
    const char *cmd = "help\r";
    const char *p = cmd;
    while (*p) {
        hw2c_cli_input(&g_cli, (uint8_t)*p);
        p++;
    }
    TEST_ASSERT_TRUE(strstr(out_str(), "test1") != NULL);
    TEST_ASSERT_TRUE(strstr(out_str(), "test2") != NULL);
}

void test_cli_backspace_edits_line(void)
{
    hw2c_cli_input(&g_cli, (uint8_t)'x');
    hw2c_cli_input(&g_cli, (uint8_t)'y');
    hw2c_cli_input(&g_cli, (uint8_t)0x08);   /* backspace */
    hw2c_cli_input(&g_cli, (uint8_t)'\r');
    /* Line is now "x", which is not a command: no handler must fire. */
    TEST_ASSERT_EQUAL_INT(0, g_cmd1_calls);
}

void test_cli_long_line_does_not_overflow(void)
{
    int i;
    for (i = 0; i < (int)(HW2C_CLI_CFG_MAX_CMD_LEN * 2); i++) {
        hw2c_cli_input(&g_cli, (uint8_t)('a' + (i % 26)));
    }
    hw2c_cli_input(&g_cli, (uint8_t)'\r');
    /* Must not crash; unknown-command path is hit safely. */
    TEST_ASSERT_TRUE(g_out_len >= 0);
}

int main(void)
{
    UNITY_BEGIN();
    RUN_TEST(test_cli_echo_printable_char);
    RUN_TEST(test_cli_executes_registered_command);
    RUN_TEST(test_cli_tokenizes_arguments);
    RUN_TEST(test_cli_unknown_command_prints_help_hint);
    RUN_TEST(test_cli_help_lists_registered_commands);
    RUN_TEST(test_cli_backspace_edits_line);
    RUN_TEST(test_cli_long_line_does_not_overflow);
    return UNITY_END();
}
