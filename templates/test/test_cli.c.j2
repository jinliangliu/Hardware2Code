void test_cli_backspace_corrects_line(void)
{
    cli_register_builtin_commands();
    mock_HAL_UART_Transmit_reset();
    /* Type "ab", backspace, then "c", then enter.
     * The resulting line should be "ac", which is unknown. */
    cli_test_inject_str("ab\bc\r\n");
    cli_test_simulate_one_command();
    const char *tx = cli_test_get_output();
    TEST_ASSERT(strstr(tx, "Unknown command: ac") != NULL);
}

void test_cli_empty_line_no_error(void)
{
    cli_register_builtin_commands();
    mock_HAL_UART_Transmit_reset();
    /* Inject just \r\n — no command to dispatch, just prompt */
    cli_test_inject_str("\r\n");
    cli_test_simulate_one_command();
    const char *tx = cli_test_get_output();
    TEST_ASSERT(strstr(tx, "Unknown command") == NULL);
}

void test_cli_custom_command_handler(void)
{
    cli_register_builtin_commands();
    mock_HAL_UART_Transmit_reset();
    cli_register_command("mytest", "Custom test command", dummy_cmd_handler);
    custom_cmd_called = false;
    cli_test_inject_and_process("mytest");
    TEST_ASSERT_TRUE(custom_cmd_called);
    const char *tx = cli_test_get_output();
    TEST_ASSERT(strstr(tx, "custom handler: OK") != NULL);
}

void test_cli_long_line_truncation(void)
{
    cli_register_builtin_commands();
    mock_HAL_UART_Transmit_reset();
    /* Build a command longer than CLI_MAX_CMD_LEN */
    char long_cmd[CLI_MAX_CMD_LEN + 10];
    memset(long_cmd, 'x', CLI_MAX_CMD_LEN + 2);
    long_cmd[CLI_MAX_CMD_LEN + 2] = '\0';
    cli_test_inject_str(long_cmd);
    cli_test_inject_str("\r\n");
    cli_test_simulate_one_command();
    /* Should not crash */
    TEST_ASSERT_TRUE(1);
}

