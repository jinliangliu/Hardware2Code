void setUp(void)
{
    mock_HAL_UART_Transmit_reset();
    mock_HAL_GPIO_WritePin_reset();
    mock_NVIC_SystemReset_reset();
    mock_task_set_tick_count(5000);
    test_line_pos = 0;
    memset(test_line_buf, 0, sizeof(test_line_buf));
    custom_cmd_called = false;
    /* Reset command table to prevent cross-test pollution */
    cli_cmd_count = 0;
    memset(cli_commands, 0, sizeof(cli_commands));
    /* Reset ring buffer to prevent stale chars leaking between tests */
    cli_ringbuf_head = 0;
    cli_ringbuf_tail = 0;
    cli_init(&mock_huart_storage);
}

void tearDown(void)
{
    /* Nothing */
}

/* ==================================================================
 *  Ring Buffer Tests
 * ================================================================== */

void test_ringbuf_put_get_basic(void)
{
    TEST_ASSERT_TRUE(ringbuf_put('H'));
    TEST_ASSERT_TRUE(ringbuf_put('e'));
    TEST_ASSERT_TRUE(ringbuf_put('y'));
    TEST_ASSERT_EQUAL('H', ringbuf_get());
    TEST_ASSERT_EQUAL('e', ringbuf_get());
    TEST_ASSERT_EQUAL('y', ringbuf_get());
}

void test_ringbuf_empty_returns_negative(void)
{
    TEST_ASSERT_EQUAL(-1, ringbuf_get());
}

void test_ringbuf_overflow_protection(void)
{
    /* Fill all usable slots (CLI_RINGBUF_SIZE - 1) */
    for (int i = 0; i < CLI_RINGBUF_SIZE - 1; i++) {
        bool ok = ringbuf_put((uint8_t)(i & 0xFF));
        TEST_ASSERT_TRUE(ok);
    }
    /* Next put must fail (buffer full) */
    TEST_ASSERT_FALSE(ringbuf_put(0xFF));
}

void test_ringbuf_wraparound(void)
{
    /* Fill buffer completely */
    for (int i = 0; i < CLI_RINGBUF_SIZE - 1; i++) {
        ringbuf_put((uint8_t)(i & 0xFF));
    }
    /* Drain first 50 bytes */
    for (int i = 0; i < 50; i++) {
        ringbuf_get();
    }
    /* Put 50 more — must wrap around */
    for (int i = 0; i < 50; i++) {
        TEST_ASSERT_TRUE(ringbuf_put((uint8_t)((100 + i) & 0xFF)));
    }
    /* Verify remaining original data */
    for (int i = 50; i < CLI_RINGBUF_SIZE - 1; i++) {
        int val = ringbuf_get();
        if (val < 0) break;
        TEST_ASSERT_EQUAL((i & 0xFF), val);
    }
    /* Verify wrapped-around data */
    for (int i = 0; i < 50; i++) {
        int val = ringbuf_get();
        if (val < 0) break;
        TEST_ASSERT_EQUAL(((100 + i) & 0xFF), val);
    }
}

/* ==================================================================
 *  Tokenizer Tests
 * ================================================================== */

void test_tokenize_simple(void)
{
    char line[] = "cmd arg1 arg2";
    char *argv[CLI_MAX_ARGS + 1];
    int argc = cli_tokenize(line, argv, CLI_MAX_ARGS);
    TEST_ASSERT_EQUAL(3, argc);
    TEST_ASSERT_EQUAL_STRING("cmd", argv[0]);
    TEST_ASSERT_EQUAL_STRING("arg1", argv[1]);
    TEST_ASSERT_EQUAL_STRING("arg2", argv[2]);
    TEST_ASSERT_NULL(argv[3]);
}

void test_tokenize_single_arg(void)
{
    char line[] = "cmd";
    char *argv[CLI_MAX_ARGS + 1];
    int argc = cli_tokenize(line, argv, CLI_MAX_ARGS);
    TEST_ASSERT_EQUAL(1, argc);
    TEST_ASSERT_EQUAL_STRING("cmd", argv[0]);
    TEST_ASSERT_NULL(argv[1]);
}

void test_tokenize_empty_string(void)
{
    char line[] = "";
    char *argv[CLI_MAX_ARGS + 1];
    int argc = cli_tokenize(line, argv, CLI_MAX_ARGS);
    TEST_ASSERT_EQUAL(0, argc);
    TEST_ASSERT_NULL(argv[0]);
}

void test_tokenize_leading_whitespace(void)
{
    char line[] = "   cmd   arg  ";
    char *argv[CLI_MAX_ARGS + 1];
    int argc = cli_tokenize(line, argv, CLI_MAX_ARGS);
    TEST_ASSERT_EQUAL(2, argc);
    TEST_ASSERT_EQUAL_STRING("cmd", argv[0]);
    TEST_ASSERT_EQUAL_STRING("arg", argv[1]);
}

void test_tokenize_max_args_limit(void)
{
    char line[] = "a b c d e f g h i j k l";
    char *argv[CLI_MAX_ARGS + 1];
    int argc = cli_tokenize(line, argv, 4);
    TEST_ASSERT_EQUAL(4, argc);
}

/* ==================================================================
 *  Command Table Tests
 * ================================================================== */

void test_register_and_find_command(void)
{
    cli_register_command("test1", "Test command 1", NULL);
    cli_register_command("test2", "Test command 2", NULL);

    cli_command_t *cmd = cli_find_command("test1");
    TEST_ASSERT_NOT_NULL(cmd);
    TEST_ASSERT_EQUAL_STRING("test1", cmd->name);

    cmd = cli_find_command("test2");
    TEST_ASSERT_NOT_NULL(cmd);
    TEST_ASSERT_EQUAL_STRING("Test command 2", cmd->help);
}

void test_find_command_nonexistent(void)
{
    cli_command_t *cmd = cli_find_command("nonexistent");
    TEST_ASSERT_NULL(cmd);
}

void test_register_command_overflow(void)
{
    /* Use static 2-D array so each command name has stable storage
     * (plain local char[] would leave all entries pointing to the
     *  same overwritten buffer, causing a dangling-pointer bug). */
    static char names[CLI_MAX_COMMANDS][8];
    for (int i = 0; i < CLI_MAX_COMMANDS; i++) {
        snprintf(names[i], sizeof(names[0]), "cmd%d", i);
        cli_register_command(names[i], "overflow test", NULL);
    }
    /* 33rd register should be silently ignored */
    cli_register_command("extra", "extra cmd", NULL);
    /* Verify cmd0 is findable */
    cli_command_t *cmd = cli_find_command("cmd0");
    TEST_ASSERT_NOT_NULL(cmd);
    /* Verify extra was NOT registered (table was full) */
    cmd = cli_find_command("extra");
    TEST_ASSERT_NULL(cmd);
}

