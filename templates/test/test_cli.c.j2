{#
    test_cli.c.j2 - CLI debug shell unit test template
    Tests ring buffer, tokenizer, command table, output capture,
    and full command pipeline (inject → process → verify).
#}
#include "unity.h"
#include "mock_hal.h"
#include <string.h>
#include <stdio.h>

/*
 * UART_HandleTypeDef is typedef void in mock_hal.h — cannot declare
 * a variable of that type. Use an int for storage and pass its address.
 */
static int mock_huart_storage;

/* Include CLI source under test to access all static functions */
#include "../src/drivers/drv_cli.c"

/* ==================================================================
 *  Test injection & processing helpers
 *  (defined AFTER drv_cli.c include to access static vars/funcs)
 * ================================================================== */

/* Line buffer state for simulating cli_task's inner loop */
static char   test_line_buf[CLI_MAX_CMD_LEN + 1];
static uint16_t test_line_pos = 0;
static char  *test_argv_data[CLI_MAX_ARGS + 1];

static void cli_test_inject_char(uint8_t c)
{
    cli_rx_byte = c;
    HAL_UART_RxCpltCallback(&mock_huart_storage);
}

static void cli_test_inject_str(const char *str)
{
    while (*str) {
        cli_test_inject_char((uint8_t)(*str));
        str++;
    }
}

/**
 * @brief  Simulate one pass of cli_task's inner loop:
 *         take semaphore, drain ring buffer, process up to one
 *         complete command (stopping at the first \r or \n).
 */
static void cli_test_simulate_one_command(void)
{
    if (xSemaphoreTake(cli_rx_sem, pdMS_TO_TICKS(0)) == pdTRUE) {
        int c;
        while ((c = ringbuf_get()) >= 0) {
            if (c == '\r' || c == '\n') {
                test_line_buf[test_line_pos] = '\0';
                if (test_line_pos > 0) {
                    int argc = cli_tokenize(test_line_buf,
                                            test_argv_data,
                                            CLI_MAX_ARGS);
                    if (argc > 0) {
                        cli_command_t *cmd = cli_find_command(test_argv_data[0]);
                        if (cmd) {
                            cmd->handler(argc, test_argv_data, cli_output);
                        } else {
                            cli_output("Unknown command: %s. "
                                       "Type 'help' for available commands.\r\n",
                                       test_argv_data[0]);
                        }
                    }
                }
                test_line_pos = 0;
                return;
            } else if (c == 0x08 || c == 0x7F) {
                /* Backspace / DEL */
                if (test_line_pos > 0) {
                    test_line_pos--;
                }
            } else if (c >= 0x20 && c <= 0x7E) {
                /* Printable ASCII */
                if (test_line_pos < CLI_MAX_CMD_LEN) {
                    test_line_buf[test_line_pos++] = (char)c;
                }
            }
        }
    }
}

/**
 * @brief  Inject a complete command string (without \r\n) and simulate
 *         processing once (one command dispatched).
 */
static void cli_test_inject_and_process(const char *cmd)
{
    char full_cmd[CLI_MAX_CMD_LEN + 4];
    snprintf(full_cmd, sizeof(full_cmd), "%s\r\n", cmd);
    cli_test_inject_str(full_cmd);
    cli_test_simulate_one_command();
}

/**
 * @brief  Retrieve captured UART TX output as a null-terminated C string.
 */
static const char *cli_test_get_output(void)
{
    uint8_t *buf;
    uint16_t len;
    mock_HAL_UART_Transmit_get_tx_data(&buf, &len);
    static char str_buf[MOCK_UART_TX_BUF_SIZE + 1];
    if (len > MOCK_UART_TX_BUF_SIZE) len = MOCK_UART_TX_BUF_SIZE;
    memcpy(str_buf, buf, len);
    str_buf[len] = '\0';
    return str_buf;
}

/* ==================================================================
 *  Custom command handler for registration test
 * ================================================================== */
static bool custom_cmd_called = false;

static void dummy_cmd_handler(int argc, char *argv[], cli_output_fn out)
{
    (void)argc; (void)argv;
    custom_cmd_called = true;
    out("custom handler: OK\r\n");
}

