/**
 * @file    test_fota_protocol.c
 * @brief   Unit tests for FOTA protocol state machine (drv_fota.c)
 *          Tests: init/reset, CRC16, BKP4R persistence, flag operations.
 *          Full state machine transitions require hardware UART, not tested here.
 */
#include "unity.h"
#include "mock_hal.h"
#include <string.h>
#include <stdint.h>
#include <stdbool.h>

/* ---- Stubs for functions referenced by drv_fota.c but not tested here ---- */

static int fota_bspatch_apply(uint32_t old_base, uint32_t old_size, uint32_t new_base)
{
    (void)old_base; (void)old_size; (void)new_base;
    return 0;
}

static bool UART_IsRxComplete(void)       { return false; }
static uint16_t UART_GetRxCount(void)     { return 0; }
static void UART_SendByte(uint8_t byte)   { (void)byte; }
static void UART_StartRx_IT(uint8_t *buf, uint16_t size) { (void)buf; (void)size; }

/* Include the source under test to access static functions */
#include "../src/drivers/drv_fota.c"

/* ---- CRC-16/CCITT reference: "123456789" -> 0x29B1 ---- */

void setUp(void)
{
    mock_cmsis_reset();
    mock_flash_reset();
    fota_init();
}

void tearDown(void) {}

/* ---- Init/reset tests ---- */

void test_fota_init_sets_state_idle(void)
{
    TEST_ASSERT_EQUAL(FOTA_STATE_IDLE, fota_get_state());
}

void test_fota_init_clears_bkp_flags(void)
{
    /* bkp_read() should return 0 after init */
    uint32_t val = bkp_read();
    TEST_ASSERT_EQUAL_UINT32(0, val);
}

void test_fota_get_progress_starts_zero(void)
{
    TEST_ASSERT_EQUAL_UINT32(0, fota_get_progress());
}

/* ---- BKP4R flag persistence ---- */

void test_bkp_write_read_roundtrip(void)
{
    bkp_write(0xDEADBEEFUL);
    TEST_ASSERT_EQUAL_UINT32(0xDEADBEEFUL, bkp_read());
}

void test_bkp_set_flag_single_bit(void)
{
    bkp_write(0);
    bkp_set_flag(FOTA_FLAG_IN_PROGRESS);
    TEST_ASSERT_EQUAL_UINT32(FOTA_FLAG_IN_PROGRESS, bkp_read());
}

void test_bkp_set_flag_multiple_bits(void)
{
    bkp_write(0);
    bkp_set_flag(FOTA_FLAG_IN_PROGRESS);
    bkp_set_flag(FOTA_FLAG_PATCH_READY);
    uint32_t expected = FOTA_FLAG_IN_PROGRESS | FOTA_FLAG_PATCH_READY;
    TEST_ASSERT_EQUAL_UINT32(expected, bkp_read());
}

void test_bkp_clear_flags_wipes_all(void)
{
    bkp_write(FOTA_FLAG_IN_PROGRESS | FOTA_FLAG_PATCH_READY | FOTA_FLAG_VERIFY_FAIL);
    bkp_clear_flags();
    TEST_ASSERT_EQUAL_UINT32(0, bkp_read());
}

void test_bkp_flag_constants_distinct(void)
{
    /* Ensure flag bits don't overlap */
    TEST_ASSERT_EQUAL_UINT32(0, FOTA_FLAG_IN_PROGRESS & FOTA_FLAG_PATCH_READY);
    TEST_ASSERT_EQUAL_UINT32(0, FOTA_FLAG_IN_PROGRESS & FOTA_FLAG_VERIFY_FAIL);
    TEST_ASSERT_EQUAL_UINT32(0, FOTA_FLAG_IN_PROGRESS & FOTA_FLAG_APPLY_FAIL);
    TEST_ASSERT_EQUAL_UINT32(0, FOTA_FLAG_PATCH_READY & FOTA_FLAG_VERIFY_FAIL);
    TEST_ASSERT_EQUAL_UINT32(0, FOTA_FLAG_PATCH_READY & FOTA_FLAG_APPLY_FAIL);
    TEST_ASSERT_EQUAL_UINT32(0, FOTA_FLAG_VERIFY_FAIL & FOTA_FLAG_APPLY_FAIL);
}

/* ---- CRC16 computation tests ---- */

void test_crc16_empty_returns_ffff(void)
{
    uint16_t crc = crc16_compute(NULL, 0);
    TEST_ASSERT_EQUAL_HEX16(0xFFFF, crc);
}

void test_crc16_known_vector_123456789(void)
{
    /* ITU-T CRC-16: hex "313233343536373839" -> 0x29B1 */
    const uint8_t test_data[] = {'1','2','3','4','5','6','7','8','9'};
    uint16_t crc = crc16_compute(test_data, sizeof(test_data));
    TEST_ASSERT_EQUAL_HEX16(0x29B1, crc);
}

void test_crc16_known_vector_A(void)
{
    /* Single byte 'A' (0x41) with CRC-16/CCITT-FALSE (init=0xFFFF) */
    const uint8_t test_data[] = {'A'};
    uint16_t crc = crc16_compute(test_data, sizeof(test_data));
    TEST_ASSERT_EQUAL_HEX16(0xB915, crc);
}

void test_crc16_all_zeros(void)
{
    /* 8 zero bytes with CRC-16/CCITT-FALSE (init=0xFFFF) */
    const uint8_t test_data[8] = {0};
    uint16_t crc = crc16_compute(test_data, sizeof(test_data));
    TEST_ASSERT_EQUAL_HEX16(0x313E, crc);
}

void test_crc16_idempotent(void)
{
    /* Running CRC on same data twice produces same result */
    const uint8_t test_data[] = {0xAA, 0xBB, 0xCC, 0xDD};
    uint16_t crc1 = crc16_compute(test_data, sizeof(test_data));
    uint16_t crc2 = crc16_compute(test_data, sizeof(test_data));
    TEST_ASSERT_EQUAL_HEX16(crc1, crc2);
}

/* ---- Protocol constants ---- */

void test_fota_chunk_size_is_1024(void)
{
    TEST_ASSERT_EQUAL_UINT16(1024, FOTA_CHUNK_SIZE);
}

void test_start_cmd_magic(void)
{
    TEST_ASSERT_EQUAL_HEX16(0xF00AU, FOTA_PROTOCOL_START_CMD);
}

void test_end_cmd_magic(void)
{
    TEST_ASSERT_EQUAL_HEX16(0xF00EU, FOTA_PROTOCOL_END_CMD);
}

void test_protocol_flag_values(void)
{
    TEST_ASSERT_EQUAL_HEX8(0x06U, FOTA_PROTOCOL_ACK);
    TEST_ASSERT_EQUAL_HEX8(0x15U, FOTA_PROTOCOL_NAK);
}

/* ---- FOTA version encoding mask ---- */

void test_version_mask_isolates_upper_24_bits(void)
{
    uint32_t raw = 0x123456ABUL;
    uint32_t version = (raw & FOTA_VERSION_MASK) >> FOTA_VERSION_SHIFT;
    TEST_ASSERT_EQUAL_HEX32(0x00123456UL, version);
}

void test_version_mask_ignores_lower_8_bits(void)
{
    uint32_t raw = 0x00000001UL;
    uint32_t version = (raw & FOTA_VERSION_MASK) >> FOTA_VERSION_SHIFT;
    TEST_ASSERT_EQUAL_HEX32(0x00000000UL, version);
}

int main(void)
{
    UNITY_BEGIN();
    RUN_TEST(test_fota_init_sets_state_idle);
    RUN_TEST(test_fota_init_clears_bkp_flags);
    RUN_TEST(test_fota_get_progress_starts_zero);
    RUN_TEST(test_bkp_write_read_roundtrip);
    RUN_TEST(test_bkp_set_flag_single_bit);
    RUN_TEST(test_bkp_set_flag_multiple_bits);
    RUN_TEST(test_bkp_clear_flags_wipes_all);
    RUN_TEST(test_bkp_flag_constants_distinct);
    RUN_TEST(test_crc16_empty_returns_ffff);
    RUN_TEST(test_crc16_known_vector_123456789);
    RUN_TEST(test_crc16_known_vector_A);
    RUN_TEST(test_crc16_all_zeros);
    RUN_TEST(test_crc16_idempotent);
    RUN_TEST(test_fota_chunk_size_is_1024);
    RUN_TEST(test_start_cmd_magic);
    RUN_TEST(test_end_cmd_magic);
    RUN_TEST(test_protocol_flag_values);
    RUN_TEST(test_version_mask_isolates_upper_24_bits);
    RUN_TEST(test_version_mask_ignores_lower_8_bits);
    return UNITY_END();
}
