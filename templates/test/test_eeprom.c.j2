/* test_eeprom.c.j2 - EEPROM driver unit tests (shared i2c_api bus) */
#include "unity.h"
#include "mock_hal.h"
#include <string.h>

{% set eeprom_peri = peripherals | selectattr('type', 'in', ['I2C_EEPROM']) | first %}
{% set eeprom_addr = eeprom_peri.get('address', eeprom_peri.get('model', {}).get('i2c_addr', 0x50)) %}

/* i2c_api references hi2c1 via extern (declared in main.c) */
I2C_HandleTypeDef hi2c1;
#include "../src/drivers/i2c_api.c"
#include "../src/drivers/drv_{{ eeprom_peri.name }}.c"

void setUp(void)
{
    mock_i2c_reset();
    mock_i2c_add_device({{ eeprom_addr }}, NULL, 0);
}

void tearDown(void) {}

void test_init_returns_ok(void)
{
    i2c_handle_t bus = i2c_open("i2c1", NULL);
    TEST_ASSERT_EQUAL_INT(0, eeprom_init(bus, {{ eeprom_addr }}));
}

void test_init_null_bus(void)
{
    TEST_ASSERT_EQUAL_INT(-1, eeprom_init(NULL, {{ eeprom_addr }}));
}

void test_write_read_byte_roundtrip(void)
{
    uint8_t data = 0xFF;
    i2c_handle_t bus = i2c_open("i2c1", NULL);

    eeprom_init(bus, {{ eeprom_addr }});
    TEST_ASSERT_EQUAL_INT(0, eeprom_write_byte(0x0005, 0x42));
    TEST_ASSERT_EQUAL_INT(0, eeprom_read_byte(0x0005, &data));
    TEST_ASSERT_EQUAL_UINT8(0x42, data);
}

void test_write_read_page_roundtrip(void)
{
    uint8_t in[8]  = {0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08};
    uint8_t out[8] = {0};
    i2c_handle_t bus = i2c_open("i2c1", NULL);

    eeprom_init(bus, {{ eeprom_addr }});
    TEST_ASSERT_EQUAL_INT(0, eeprom_write_page(0x0010, in, sizeof(in)));
    TEST_ASSERT_EQUAL_INT(0, eeprom_read_page(0x0010, out, sizeof(out)));
    TEST_ASSERT_EQUAL_UINT8_ARRAY(in, out, 8);
}

void test_read_fails_when_device_absent(void)
{
    uint8_t data = 0;
    i2c_handle_t bus = i2c_open("i2c1", NULL);

    mock_i2c_reset();                 /* no device at 0x50 */
    eeprom_init(bus, {{ eeprom_addr }});
    TEST_ASSERT_TRUE(eeprom_read_byte(0x0000, &data) < 0);
}

int main(void)
{
    UNITY_BEGIN();
    RUN_TEST(test_init_returns_ok);
    RUN_TEST(test_init_null_bus);
    RUN_TEST(test_write_read_byte_roundtrip);
    RUN_TEST(test_write_read_page_roundtrip);
    RUN_TEST(test_read_fails_when_device_absent);
    return UNITY_END();
}
