# Test Makefile generated by Hardware2Code
# Requires MinGW GCC in PATH (tested with x86_64 native gcc)

CC = gcc
CFLAGS = -Wall -Wextra -I. -I../src -I../src/drivers -Iunity -I../config -DTEST

UNITY_SRC = unity/unity.c
MOCK_SRC = mock_hal.c

# Test programs to build (dynamically generated)
TEST_PROGS = test_gpio
{% if has_rtc %}
TEST_PROGS += test_rtc test_event_mgr
{% endif %}
{% if has_fota %}
TEST_PROGS += test_fota_protocol test_fota_bspatch
{% endif %}
{% if has_rs485 %}
TEST_PROGS += test_rs485
{% endif %}
{% if has_modbus %}
TEST_PROGS += test_modbus
{% endif %}
{% if has_ir %}
TEST_PROGS += test_ir
{% endif %}
{% if has_cellular %}
TEST_PROGS += test_cellular
{% endif %}
{% if has_mqtt %}
TEST_PROGS += test_mqtt
{% endif %}
{% if has_cli %}
TEST_PROGS += test_cli
{% endif %}
{% for p in peripherals %}
{% if p.type == 'I2C_Sensor_MPU6050' %}
TEST_PROGS += test_mpu6050
{% endif %}
{% endfor %}

.PHONY: test clean

test: $(TEST_PROGS)
	@for t in $(TEST_PROGS); do echo "==== Running $$t ===="; ./$$t || exit 1; done

test_gpio: $(UNITY_SRC) $(MOCK_SRC) test_gpio.c
	$(CC) $(CFLAGS) $^ -o $@

{% if has_rtc %}
test_rtc: $(UNITY_SRC) $(MOCK_SRC) test_rtc.c
	$(CC) $(CFLAGS) $^ -o $@

test_event_mgr: $(UNITY_SRC) $(MOCK_SRC) test_event_mgr.c
	$(CC) $(CFLAGS) $^ -o $@
{% endif %}

{% if has_rs485 %}
test_rs485: $(UNITY_SRC) $(MOCK_SRC) test_rs485.c
	$(CC) $(CFLAGS) $^ -o $@
{% endif %}
{% if has_modbus %}
test_modbus: $(UNITY_SRC) $(MOCK_SRC) test_modbus.c
	$(CC) $(CFLAGS) $^ -o $@
{% endif %}
{% if has_ir %}
test_ir: $(UNITY_SRC) $(MOCK_SRC) test_ir.c
	$(CC) $(CFLAGS) $^ -o $@
{% endif %}
{% if has_cellular %}
test_cellular: $(UNITY_SRC) test_cellular.c
	$(CC) $(CFLAGS) $^ -o $@
{% endif %}
{% if has_mqtt %}
test_mqtt: $(UNITY_SRC) mock_hal.c test_mqtt.c
	$(CC) $(CFLAGS) $^ -o $@
{% endif %}
{% if has_cli %}
test_cli: $(UNITY_SRC) $(MOCK_SRC) test_cli.c
	$(CC) $(CFLAGS) $^ -o $@
{% endif %}

{% for p in peripherals %}
{% if p.type == 'I2C_Sensor_MPU6050' %}
test_mpu6050: $(UNITY_SRC) $(MOCK_SRC) test_mpu6050.c
	$(CC) $(CFLAGS) $^ -o $@
{% endif %}
{% endfor %}

{% if has_fota %}
test_fota_protocol: $(UNITY_SRC) $(MOCK_SRC) test_fota_protocol.c
	$(CC) $(CFLAGS) $^ -o $@

test_fota_bspatch: $(UNITY_SRC) $(MOCK_SRC) test_fota_bspatch.c
	$(CC) $(CFLAGS) $^ -o $@
{% endif %}

clean:
	rm -f $(TEST_PROGS)