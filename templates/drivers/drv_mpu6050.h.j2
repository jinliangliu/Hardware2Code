/**
 * @file  drv_{{ peripheral.name }}.h
 * @brief MPU6050/MPU6500 IMU driver header (generated by hw2c)
 *
 * Transport-agnostic: register access goes through i2c_api (I2C model,
 * device addressed by 7-bit slave address) or spi_api (SPI model, device
 * addressed by chip-select GPIO).  The register map and scaling are
 * shared, so the component/attitude layers never change with the bus.
 */
{% set mpu = peripheral.get('extra', {}) %}
{% set accel_fs = mpu.get('accel_fs', 2) %}
{% set gyro_fs = mpu.get('gyro_fs', 250) %}

#ifndef __DRV_{{ peripheral.name | upper }}_H
#define __DRV_{{ peripheral.name | upper }}_H

#include <stdint.h>
{% if model.interface == 'SPI' %}
#include "spi_api.h"
{% else %}
#include "i2c_api.h"
{% endif %}

#ifdef __cplusplus
extern "C" {
#endif

/* ---- Register map (shared by MPU6050 and MPU6500) ---- */
#define MPU6050_PWR_MGMT_1    {{ model.registers.PWR_MGMT_1 }}
#define MPU6050_CONFIG        {{ model.registers.CONFIG }}
#define MPU6050_GYRO_CONFIG   {{ model.registers.GYRO_CONFIG }}
#define MPU6050_ACCEL_CONFIG  {{ model.registers.ACCEL_CONFIG }}
#define MPU6050_SMPLRT_DIV    {{ model.registers.SMPLRT_DIV }}
#define MPU6050_WHO_AM_I      {{ model.registers.WHO_AM_I }}
#define MPU6050_ACCEL_XOUT_H  {{ model.registers.ACCEL_XOUT_H }}
#define MPU6050_TEMP_OUT_H    {{ model.registers.TEMP_OUT_H }}

/* ---- Calibrated full-scale settings ---- */
#define MPU6050_ACCEL_FS_G    {{ accel_fs }}
#define MPU6050_GYRO_FS_DPS   {{ gyro_fs }}

/* ---- Data output ---- */
typedef struct {
    int16_t raw_ax, raw_ay, raw_az;      /* raw ADC counts        */
    int16_t raw_gx, raw_gy, raw_gz;
    int16_t raw_temp;
    float   accel_g[3];                  /* X, Y, Z in g          */
    float   gyro_dps[3];                 /* X, Y, Z in deg/s      */
    float   temp_c;                      /* die temperature in C  */
} {{ peripheral.name }}_data_t;

/* ---- API (bus type depends on the model interface) ----
 * I2C:  (i2c_handle_t bus, uint8_t dev_addr)
 * SPI:  (spi_handle_t bus, const char *cs_name)   CS = GPIO label
 */
{% if model.interface == 'SPI' %}
int {{ peripheral.name }}_init(spi_handle_t bus, const char *cs_name);
int {{ peripheral.name }}_who_am_i(spi_handle_t bus, const char *cs_name, uint8_t *out);
int {{ peripheral.name }}_read(spi_handle_t bus, const char *cs_name,
                              {{ peripheral.name }}_data_t *out);
int {{ peripheral.name }}_set_full_scale(spi_handle_t bus, const char *cs_name,
                                        uint8_t accel_fs_g, uint16_t gyro_fs_dps);
{% else %}
int {{ peripheral.name }}_init(i2c_handle_t bus, uint8_t dev_addr);
int {{ peripheral.name }}_who_am_i(i2c_handle_t bus, uint8_t dev_addr, uint8_t *out);
int {{ peripheral.name }}_read(i2c_handle_t bus, uint8_t dev_addr,
                              {{ peripheral.name }}_data_t *out);
int {{ peripheral.name }}_set_full_scale(i2c_handle_t bus, uint8_t dev_addr,
                                        uint8_t accel_fs_g, uint16_t gyro_fs_dps);
{% endif %}

#ifdef __cplusplus
}
#endif

#endif /* __DRV_{{ peripheral.name | upper }}_H */
