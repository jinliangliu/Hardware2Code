#ifndef __DRV_{{ peripheral.name | upper }}_H
#define __DRV_{{ peripheral.name | upper }}_H
#include <stdint.h>

/* Modbus function codes */
#define MODBUS_FC_READ_HOLDING_REGS    0x03
#define MODBUS_FC_WRITE_SINGLE_REG     0x06
#define MODBUS_FC_WRITE_MULTIPLE_REGS  0x10

/* Exception codes */
#define MODBUS_EX_ILLEGAL_FUNCTION     0x01
#define MODBUS_EX_ILLEGAL_ADDRESS      0x02
#define MODBUS_EX_ILLEGAL_DATA         0x03

/* Broadcast address */
#define MODBUS_BROADCAST_ADDR          0x00

/* Frame timeout in milliseconds (3.5 characters at 9600 baud) */
#define MODBUS_FRAME_TIMEOUT_MS        4

void modbus_init(uint8_t slave_id, uint16_t reg_count, void *tx_func, void *rx_func,
                 void *read_cb, void *write_cb);
void modbus_process(void);

/* ---- Master (client) API ----
 * Return 0 on success; negative values are errors
 * (-4..-99 = Modbus exception code negated, others = protocol errors). */
int modbus_master_read_regs(uint8_t slave, uint16_t addr, uint16_t count,
                            uint16_t *out, uint32_t timeout_ms);
int modbus_master_write_single(uint8_t slave, uint16_t addr, uint16_t value,
                               uint32_t timeout_ms);
int modbus_master_write_multiple(uint8_t slave, uint16_t addr,
                                 const uint16_t *values, uint16_t count,
                                 uint32_t timeout_ms);

#endif
