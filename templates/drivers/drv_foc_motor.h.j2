/**
 * @file  drv_{{ peripheral.name }}.h
 * @brief TIM1 direct-drive FOC motor driver header (generated by hw2c)
 *
 * Runs the current loop (Clarke -> Park -> PI -> inverse Park -> SVPWM)
 * on TIM1's complementary 3-phase PWM, samples phase currents with ADC1
 * and reads the rotor angle from an I2C magnetic encoder (AS5600-style).
 * One TIM1 = one BLDC/PMSM — the natural single-motor FOC building block.
 */

#ifndef __DRV_{{ peripheral.name | upper }}_H
#define __DRV_{{ peripheral.name | upper }}_H

#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

typedef struct {
    float iq_meas;          /* measured q-axis current (A)  */
    float id_meas;          /* measured d-axis current (A)  */
    float ia, ib, ic;       /* latest phase currents (A)    */
    float angle_rad;        /* mechanical angle (rad)       */
    float velocity_radps;   /* mechanical speed (rad/s)     */
    float torque_nm;        /* last commanded torque (N*m)  */
} {{ peripheral.name }}_state_t;

/* Inits TIM1 complementary PWM, ADC1 sampling and the I2C encoder.
 * Returns 0 on success. */
int {{ peripheral.name }}_init(void);

/* Commands q-axis current (A). */
int {{ peripheral.name }}_set_iq(float iq_a);

/* Commands torque (N*m) via torque = KT * iq. */
int {{ peripheral.name }}_set_torque(float torque_nm);

/* Reads latest state (currents/angle/velocity/torque). */
int {{ peripheral.name }}_get_state({{ peripheral.name }}_state_t *out);

/* Calibrates the encoder zero: current mechanical angle becomes the
 * electrical zero (run once with the rotor at a known alignment). */
int {{ peripheral.name }}_calibrate(void);

/* Current-loop ISR body.  Call from the TIM1 update interrupt
 * (or manually in host tests). */
void {{ peripheral.name }}_isr(void);

#ifdef __cplusplus
}
#endif

#endif /* __DRV_{{ peripheral.name | upper }}_H */
