{#
    drv_i2c_mpu6050.c.j2 - MPU6050 driver source template
    Generates: src/drivers/drv_{{ peripheral.name }}.c
    Requires context variables: peripheral (name, address, extra, _mpu6050), model (registers)
#}
{% set i2c_addr = peripheral.get('address', model.get('address', 0x68)) %}
{% set mpu = peripheral._mpu6050 | default({}) %}
#include "drv_{{ peripheral.name }}.h"

static I2C_HandleTypeDef *i2c_handle = NULL;

/* MPU6050 register definitions */
#define MPU6050_PWR_MGMT_1   {{ model.registers.PWR_MGMT_1 }}
#define MPU6050_GYRO_CONFIG  {{ model.registers.GYRO_CONFIG }}
#define MPU6050_ACCEL_CONFIG {{ model.registers.ACCEL_CONFIG }}
#define MPU6050_SMPLRT_DIV   {{ model.registers.SMPLRT_DIV }}
#define MPU6050_ACCEL_XOUT_H {{ model.registers.ACCEL_XOUT_H }}

void {{ peripheral.name }}_init(I2C_HandleTypeDef *hi2c) {
    i2c_handle = hi2c;

    /* Wake up the sensor */
    uint8_t init_data[2] = { MPU6050_PWR_MGMT_1, 0x00 };
    if (HAL_I2C_Master_Transmit(i2c_handle, {{ i2c_addr }} << 1, init_data, 2, 100) != HAL_OK) {
        Error_Handler();
    }

    /* Configure gyroscope full scale -> {{ mpu.gyro_fs | default(250) }}°/s */
    uint8_t gyro_data[2] = { MPU6050_GYRO_CONFIG, {{ mpu.gyro_fs_val | default('0x00') }} };
    if (HAL_I2C_Master_Transmit(i2c_handle, {{ i2c_addr }} << 1, gyro_data, 2, 100) != HAL_OK) {
        Error_Handler();
    }

    /* Configure accelerometer full scale -> +/-{{ mpu.accel_fs | default(2) }}g */
    uint8_t accel_data[2] = { MPU6050_ACCEL_CONFIG, {{ mpu.accel_fs_val | default('0x00') }} };
    if (HAL_I2C_Master_Transmit(i2c_handle, {{ i2c_addr }} << 1, accel_data, 2, 100) != HAL_OK) {
        Error_Handler();
    }

    /* Set sample rate divider */
    uint8_t rate_data[2] = { MPU6050_SMPLRT_DIV, {{ peripheral.extra.sample_rate_div | default(0) }} };
    if (HAL_I2C_Master_Transmit(i2c_handle, {{ i2c_addr }} << 1, rate_data, 2, 100) != HAL_OK) {
        Error_Handler();
    }
}

void {{ peripheral.name }}_read({{ peripheral.name }}_data_t *data) {
    uint8_t buffer[14];
    if (HAL_I2C_Mem_Read(i2c_handle, {{ i2c_addr }} << 1, MPU6050_ACCEL_XOUT_H,
                    I2C_MEMADD_SIZE_8BIT, buffer, 14, 100) != HAL_OK) {
        Error_Handler();
    }

    /* Extract raw values */
    int16_t ax = (buffer[0] << 8) | buffer[1];
    int16_t ay = (buffer[2] << 8) | buffer[3];
    int16_t az = (buffer[4] << 8) | buffer[5];
    int16_t gx = (buffer[8] << 8) | buffer[9];
    int16_t gy = (buffer[10] << 8) | buffer[11];
    int16_t gz = (buffer[12] << 8) | buffer[13];

    /* Scale factors (from YAML peripheral.extra config) */
    float accel_scale = {{ mpu.accel_scale | default('16384.0') }}f;
    float gyro_scale = {{ mpu.gyro_scale | default('131.0') }}f;
    data->accel_x = ax / accel_scale;
    data->accel_y = ay / accel_scale;
    data->accel_z = az / accel_scale;
    data->gyro_x = gx / gyro_scale;
    data->gyro_y = gy / gyro_scale;
    data->gyro_z = gz / gyro_scale;
}