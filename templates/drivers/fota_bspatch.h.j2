#ifndef __FOTA_BSPATCH_H
#define __FOTA_BSPATCH_H

#ifdef TEST
#include "mock_hal.h"
#else
#include <stdint.h>
#endif

/*
 * Maximum patch buffer size (stored in RAM during receive).
 * Total diff for ~15KB firmware is typically <5KB, so 8KB is generous.
 */
#define FOTA_PATCH_BUF_MAX_SIZE  8192

/*
 * BSDIFF40 control block reading buffer
 */
#define FOTA_CTRL_BUF_SIZE       512

/**
 * @brief   Apply a BSDIFF40 patch from RAM buffer to Flash
 *
 * Reads old firmware from `old_base` Flash address, applies diff from
 * internal patch buffer, writes new firmware to `new_base` Flash address.
 *
 * @param   old_base   Old firmware Flash address (Slot A: 0x08002000)
 * @param   old_size   Old firmware image size (from its header)
 * @param   new_base   New firmware Flash address (Slot B: 0x08040000)
 * @return  0 on success, negative on error
 */
int fota_bspatch_apply(uint32_t old_base, uint32_t old_size, uint32_t new_base);

#endif /* __FOTA_BSPATCH_H */
