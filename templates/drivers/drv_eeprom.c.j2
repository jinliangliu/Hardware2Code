{#
    drv_eeprom.c.j2 - I2C EEPROM driver (e.g. AT24C32 / AT24C256)

    Transport-agnostic: all access goes through i2c_api with the device's
    own 7-bit address, so the EEPROM can share a physical bus with other
    I2C devices (MPU6050, sensors, ...).
#}

#include "drv_{{ peripheral.name }}.h"
#include <stddef.h>
#ifndef TEST
#include "stm32g0xx_hal.h"   /* HAL_Delay for write-cycle wait */
#endif

/* Private variables */
static i2c_handle_t eeprom_bus;
static uint8_t      eeprom_addr;

/**
 * @brief   Initialize the I2C EEPROM driver on a shared bus
 * @param   bus:      i2c_api handle of the physical bus (already opened)
 * @param   dev_addr: 7-bit slave address (e.g. 0x50)
 * @return  0 on success, -1 on error
 */
int eeprom_init(i2c_handle_t bus, uint8_t dev_addr)
{
    if (bus == NULL) {
        return -1;
    }
    eeprom_bus  = bus;
    eeprom_addr = dev_addr;
    return 0;
}

/**
 * @brief   Read a single byte from EEPROM
 * @param   mem_addr: memory address in EEPROM (16-bit)
 * @param   data: output pointer for the read byte
 * @return  0 on success, -1 on error
 */
int eeprom_read_byte(uint16_t mem_addr, uint8_t *data)
{
    if (data == NULL || eeprom_bus == NULL) {
        return -1;
    }
    return (i2c_mem_read(eeprom_bus, eeprom_addr, mem_addr,
                         I2C_MEMADDR_SIZE_16BIT, data, 1, 100) == 0) ? 0 : -1;
}

/**
 * @brief   Write a single byte to EEPROM
 * @param   mem_addr: memory address in EEPROM (16-bit)
 * @param   data: byte value to write
 * @return  0 on success, -1 on error
 */
int eeprom_write_byte(uint16_t mem_addr, uint8_t data)
{
    if (eeprom_bus == NULL) {
        return -1;
    }
    if (i2c_mem_write(eeprom_bus, eeprom_addr, mem_addr,
                      I2C_MEMADDR_SIZE_16BIT, &data, 1, 100) != 0) {
        return -1;
    }

#ifdef TEST
    /* No delay in test mode */
#else
    HAL_Delay(5);
#endif
    return 0;
}

/**
 * @brief   Read multiple bytes from EEPROM (sequential read)
 * @param   mem_addr: starting memory address
 * @param   buf: output buffer
 * @param   len: number of bytes to read
 * @return  0 on success, -1 on error
 */
int eeprom_read_page(uint16_t mem_addr, uint8_t *buf, uint16_t len)
{
    if (buf == NULL || eeprom_bus == NULL) {
        return -1;
    }
    return (i2c_mem_read(eeprom_bus, eeprom_addr, mem_addr,
                         I2C_MEMADDR_SIZE_16BIT, buf, len, 200) == 0) ? 0 : -1;
}

/**
 * @brief   Write multiple bytes to EEPROM (page write, limited to one page)
 * @param   mem_addr: starting memory address
 * @param   buf: data buffer
 * @param   len: number of bytes to write
 * @return  0 on success, -1 on error
 */
int eeprom_write_page(uint16_t mem_addr, const uint8_t *buf, uint16_t len)
{
    if (buf == NULL || eeprom_bus == NULL) {
        return -1;
    }
    if (i2c_mem_write(eeprom_bus, eeprom_addr, mem_addr,
                      I2C_MEMADDR_SIZE_16BIT, buf, len, 200) != 0) {
        return -1;
    }

#ifdef TEST
    /* No delay in test mode */
#else
    HAL_Delay(5);
#endif
    return 0;
}
