#define __HAL_RCC_PWR_CLK_ENABLE()
#define RCC                 ((RCC_TypeDef *)0)
#define RTC                 ((RTC_TypeDef *)0)
#define RCC_BDCR_LSERDY     0x00000000U
#define RCC_CSR_LSIRDY      0x00000000U
#define RTC_SR_WUTF         0x00000000U
#define RTC_SCR_CWUTF       0x00000000U
#define RTC_CR_WUTE         0x00000000U
#define SET_BIT(reg, bit)   do { (void)(reg); (void)(bit); } while(0)
#define CLEAR_BIT(reg, bit) do { (void)(reg); (void)(bit); } while(0)
#define WRITE_REG(reg, val) do { (void)(reg); (void)(val); } while(0)
#define MODIFY_REG(reg, msk, val) do { (void)(reg); (void)(msk); (void)(val); } while(0)
