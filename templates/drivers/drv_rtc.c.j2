#include "drv_rtc.h"
#include "event_mgr.h"

/* Private handle (用于 HAL 时间函数) */
static RTC_HandleTypeDef hrtc;

/* 软件定时器链表 */
typedef struct rtc_timer {
    uint32_t            period_ms;
    uint32_t            remaining_ms;
    uint8_t             mode;
    rtc_timer_cb_t      callback;
    void                *arg;
    struct rtc_timer    *next;
} rtc_timer_t;

static rtc_timer_t *timer_head = NULL;
static QueueHandle_t timer_queue = NULL;
extern QueueHandle_t event_queue;

/* 分钟/小时定时器回调 */
static void minute_timer_cb(void *arg) {
    event_t evt = { .id = EVENT_MINUTE_TICK, .param = 0 };
    xQueueSend(event_queue, &evt, 0);
}
static void hour_timer_cb(void *arg) {
    event_t evt = { .id = EVENT_HOUR_TICK, .param = 0 };
    xQueueSend(event_queue, &evt, 0);
}

#ifndef TEST
/* ========== 硬件实现区域 ========== */
/* 硬件初始化：配置时钟、预分频器、唤醒定时器，但不使能中断 */
void RTC_Init(void)
{
    /* 关闭全局中断，保证原子操作 */
    __disable_irq();

    /* 1. 使能 PWR 时钟并强制解锁备份域 */
    RCC->APBENR1 |= RCC_APBENR1_PWREN;
    PWR->CR1 |= PWR_CR1_DBP;

    /* 2. 启动 LSI 并等待就绪 */
    RCC->CSR |= RCC_CSR_LSION;
    while ((RCC->CSR & RCC_CSR_LSIRDY) == 0);

    /* 3. 选择 LSI (0x02) 并使能 RTC 时钟 */
    uint32_t bdcr = RCC->BDCR;
    bdcr &= ~(RCC_BDCR_RTCSEL | RCC_BDCR_RTCEN);
    bdcr |= (0x02UL << RCC_BDCR_RTCSEL_Pos) | RCC_BDCR_RTCEN;
    RCC->BDCR = bdcr;

    /* 等待 RTCEN 被硬件接受 */
    while (!(RCC->BDCR & RCC_BDCR_RTCEN));

    /* 4. 稳定延时 */
    volatile uint32_t delay = 200000;
    while (delay--);

    /* 5. 如果 RTC 已经处于初始化模式，先退出 */
    if (RTC->ICSR & RTC_ICSR_INITF) {
        RTC->ICSR &= ~RTC_ICSR_INIT;
        delay = 100000; while (delay--);
    }

    /* 6. 进入初始化模式 */
    SET_BIT(RTC->ICSR, RTC_ICSR_INIT);
    delay = 100000;
    while (!(RTC->ICSR & RTC_ICSR_INITF)) {
        if (--delay == 0) break;
    }

    /* 7. 配置预分频器 (1Hz) */
    RTC->PRER = (127U << 16) | (255U);
    /* 24 小时格式，关闭输出 */
    RTC->CR = (RTC->CR & ~(RTC_CR_FMT | RTC_CR_OSEL)) | RTC_HOURFORMAT_24;
    RTC->SCR = 0x00;

    /* 退出初始化模式 */
    RTC->ICSR &= ~RTC_ICSR_INIT;
    delay = 100000;
    while (RTC->ICSR & RTC_ICSR_INITF) {
        if (--delay == 0) break;
    }

    /* 等待同步 RSF */
    delay = 100000;
    while (!(RTC->ICSR & RTC_ICSR_RSF)) {
        if (--delay == 0) break;
    }

    /* 8. 配置唤醒定时器（不使能中断） */
    MODIFY_REG(RTC->CR, RTC_CR_WUCKSEL, (0x01UL << RTC_CR_WUCKSEL_Pos));
    WRITE_REG(RTC->WUTR, 204U);
    SET_BIT(RTC->CR, RTC_CR_WUTE);   /* 只使能唤醒定时器，不使能中断 */

    /* 9. 重新开启全局中断 */
    __enable_irq();

    /* 给 hrtc 赋值 Instance 以兼容 HAL 时间读写 */
    hrtc.Instance = RTC;
}

/* 启动 RTC：使能中断，创建软件定时器 */
void RTC_Start(void)
{
    /* 使能唤醒中断 */
    SET_BIT(RTC->CR, RTC_CR_WUTIE);
    HAL_NVIC_SetPriority(RTC_TAMP_IRQn, 5, 0);
    HAL_NVIC_EnableIRQ(RTC_TAMP_IRQn);

    /* 创建软件定时器队列和分钟/小时定时器 */
    timer_queue = xQueueCreate(10, sizeof(rtc_timer_cb_t));
    rtc_timer_handle_t t_min = RTC_TimerCreate(60000, RTC_TIMER_MODE_PERIODIC, minute_timer_cb, NULL);
    rtc_timer_handle_t t_hour = RTC_TimerCreate(3600000, RTC_TIMER_MODE_PERIODIC, hour_timer_cb, NULL);
    RTC_TimerStart(t_min);
    RTC_TimerStart(t_hour);
}

void RTC_TAMP_IRQHandler(void)
{
    if (RTC->SR & RTC_SR_WUTF) {
        RTC->SCR = RTC_SCR_CWUTF;   /* 写 1 清除标志 */
        BaseType_t xHigherPriorityTaskWoken = pdFALSE;
        event_t evt = { .id = EVENT_RTC_TICK, .param = 0 };
        xQueueSendFromISR(event_queue, &evt, &xHigherPriorityTaskWoken);
        portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
    }
}

void RTC_SetWakeUpCounter(uint32_t wake_up_counter)
{
    CLEAR_BIT(RTC->CR, RTC_CR_WUTE);
    WRITE_REG(RTC->WUTR, wake_up_counter);
    SET_BIT(RTC->CR, RTC_CR_WUTE);
}

