static void Error_Handler(void)
{
    __disable_irq();
    while (1) {}
}

/*
 * ARM Alarm A to match timer_head->deadline_sec (or disable if queue empty).
 * Converts uptime deadline back to RTC calendar time for HAL programming.
 */
static void rtc_arm_alarm_a(void)
{
    if (!timer_head || !rtc_ready) {
        HAL_RTC_DeactivateAlarm(&hrtc, RTC_ALARM_A);
        return;
    }

    uint32_t abs_sec = (rtc_init_sec_of_day + timer_head->deadline_sec) % 86400;
    uint8_t  hh = (uint8_t)(abs_sec / 3600);
    uint8_t  mm = (uint8_t)((abs_sec % 3600) / 60);
    uint8_t  ss = (uint8_t)(abs_sec % 60);

    RTC_AlarmTypeDef sAlarm = {0};
    sAlarm.AlarmTime.Hours          = hh;
    sAlarm.AlarmTime.Minutes        = mm;
    sAlarm.AlarmTime.Seconds        = ss;
    sAlarm.AlarmTime.SubSeconds     = 0;
    sAlarm.AlarmTime.DayLightSaving = RTC_DAYLIGHTSAVING_NONE;
    sAlarm.AlarmTime.StoreOperation = RTC_STOREOPERATION_RESET;
    sAlarm.AlarmMask                = RTC_ALARMMASK_DATEWEEKDAY;
    sAlarm.AlarmSubSecondMask       = RTC_ALARMSUBSECONDMASK_ALL;
    sAlarm.AlarmDateWeekDaySel      = RTC_ALARMDATEWEEKDAYSEL_DATE;
    sAlarm.AlarmDateWeekDay         = 1;
    sAlarm.Alarm                    = RTC_ALARM_A;

    HAL_RTC_SetAlarm_IT(&hrtc, &sAlarm, RTC_FORMAT_BIN);
}

/*
 * Calculate next deadline for PERIODIC_MINUTE / HOUR / DAY.
 * Aligns to the next calendar boundary matching the target pattern.
 * Returns deadline in uptime seconds.
 */
static uint32_t rtc_calc_next_cyclic(uint32_t period_sec, uint8_t mode)
{
    uint32_t now_sod     = (rtc_init_sec_of_day + rtc_uptime_sec) % 86400;
    uint32_t today_start = (rtc_init_sec_of_day + rtc_uptime_sec) - now_sod;
    uint32_t target;

    switch (mode) {
    case RTC_TIMER_MODE_ONE_SHOT:
    case RTC_TIMER_MODE_PERIODIC_SEC:
        /* cyclic modes that don't align to calendar boundaries
         * are handled by simply adding period_sec to deadline_sec */
        return rtc_uptime_sec + period_sec;

    case RTC_TIMER_MODE_PERIODIC_MINUTE: {
        /* period_sec = target second (0-59) */
        uint8_t  ts = (uint8_t)period_sec;
        uint32_t minute_bound = now_sod - (now_sod % 60);
        target = minute_bound + ts;
        if (target <= now_sod) target += 60;
        if (target >= 86400) target -= 86400;
        break;
    }
    case RTC_TIMER_MODE_PERIODIC_HOUR: {
        /* period_sec = target minute * 60 + target second */
        uint8_t  tm = (uint8_t)(period_sec / 60);
        uint8_t  ts = (uint8_t)(period_sec % 60);
        uint32_t hour_bound = now_sod - (now_sod % 3600);
        target = hour_bound + tm * 60 + ts;
        if (target <= now_sod) target += 3600;
        if (target >= 86400) target -= 86400;
        break;
    }
    case RTC_TIMER_MODE_PERIODIC_DAY: {
        /* period_sec = target_h*3600 + target_m*60 + target_s */
        uint8_t  th = (uint8_t)(period_sec / 3600);
        uint8_t  tm = (uint8_t)((period_sec % 3600) / 60);
        uint8_t  ts = (uint8_t)(period_sec % 60);
        target = th * 3600 + tm * 60 + ts;
        if (target <= now_sod) target += 86400;
        break;
    }
    default:
        return 0;
    }

    /* target is an absolute sec-of-day; convert to uptime deadline */
    return (uint32_t)((int32_t)(today_start + target) - (int32_t)rtc_init_sec_of_day);
}

/* ---------- ISR: fire all expired timers, re-arm Alarm A ---------- */
static void rtc_fire_expired(void)
{
    while (timer_head && timer_head->deadline_sec <= rtc_uptime_sec) {
        rtc_timer_t *t = timer_head;
        timer_head = t->next;   /* unlink before callback (may re-insert) */

        if (t->callback) t->callback(t->arg);

        switch (t->mode) {
        case RTC_TIMER_MODE_ONE_SHOT:
            vPortFree(t);
            break;
        case RTC_TIMER_MODE_PERIODIC_SEC:
            t->deadline_sec += t->period_sec;
            t->next = NULL;
            /* re-insert sorted */
            goto reinsert;
        case RTC_TIMER_MODE_PERIODIC_MINUTE:
        case RTC_TIMER_MODE_PERIODIC_HOUR:
        case RTC_TIMER_MODE_PERIODIC_DAY:
            t->deadline_sec = rtc_calc_next_cyclic(t->period_sec, t->mode);
            t->next = NULL;
            /* re-insert sorted */
            goto reinsert;
        default:
            vPortFree(t);
            break;
        }
        continue;  /* t freed, skip re-insert */

    reinsert:
        {
            /* insert t back into sorted list */
            if (!timer_head || t->deadline_sec <= timer_head->deadline_sec) {
                t->next = timer_head;
                timer_head = t;
            } else {
                rtc_timer_t *p = timer_head;
                while (p->next && p->next->deadline_sec < t->deadline_sec)
                    p = p->next;
                t->next = p->next;
                p->next = t;
            }
        }
    }
    rtc_arm_alarm_a();
}

/* ========================================================================
 *  MSP init + RTC_Init
 * ======================================================================== */

void HAL_RTC_MspInit(RTC_HandleTypeDef* hrtc)
{
    if (hrtc->Instance == RTC) {
        __HAL_RCC_PWR_CLK_ENABLE();
        HAL_PWR_EnableBkUpAccess();

        RCC_PeriphCLKInitTypeDef PeriphClkInit = {0};
        PeriphClkInit.PeriphClockSelection = RCC_PERIPHCLK_RTC;

        {% if peripheral._clock_source == 'LSE' %}
        __HAL_RCC_LSI_ENABLE();
        while (!__HAL_RCC_GET_FLAG(RCC_FLAG_LSIRDY)) {}

        {
            RCC_OscInitTypeDef RCC_OscInitStruct = {0};
            RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_LSE;
            RCC_OscInitStruct.LSEState = RCC_LSE_ON;

            if (HAL_RCC_OscConfig(&RCC_OscInitStruct) == HAL_OK) {
                PeriphClkInit.RTCClockSelection = RCC_RTCCLKSOURCE_LSE;
                log_info("RTC clock source: LSE (32.768kHz)");
            } else {
                log_warn("LSE startup failed, falling back to LSI");
                RCC_OscInitStruct.LSEState = RCC_LSE_OFF;
                HAL_RCC_OscConfig(&RCC_OscInitStruct);
                PeriphClkInit.RTCClockSelection = RCC_RTCCLKSOURCE_LSI;
            }
        }
        {% else %}
        __HAL_RCC_LSI_ENABLE();
        while (!__HAL_RCC_GET_FLAG(RCC_FLAG_LSIRDY));
        PeriphClkInit.RTCClockSelection = RCC_RTCCLKSOURCE_LSI;
        {% endif %}

        if (HAL_RCCEx_PeriphCLKConfig(&PeriphClkInit) != HAL_OK) {
            Error_Handler();
        }

        __HAL_RCC_RTC_ENABLE();
        __HAL_RCC_RTCAPB_CLK_ENABLE();
    }
}

/* WakeUp Timer: fixed 1-second period (ck_spre = 1 Hz) */
static void RTC_WakeUp_Config(void)
{
    /* CK_SPRE = 1 Hz → wakeup after 1 cycle = 1 second */
    HAL_RTCEx_SetWakeUpTimer_IT(&hrtc, 0, RTC_WAKEUPCLOCK_CK_SPRE_17BITS);
}

void RTC_Init(void)
{
    hrtc.Instance = RTC;
    hrtc.Init.HourFormat    = RTC_HOURFORMAT_24;
    hrtc.Init.AsynchPrediv  = {{ rtc_async_prediv }};
    hrtc.Init.SynchPrediv   = {{ rtc_sync_prediv }};
    hrtc.Init.OutPut        = RTC_OUTPUT_DISABLE;
    hrtc.Init.OutPutRemap   = RTC_OUTPUT_REMAP_NONE;
    hrtc.Init.OutPutPolarity= RTC_OUTPUT_POLARITY_HIGH;
    hrtc.Init.OutPutType    = RTC_OUTPUT_TYPE_OPENDRAIN;
    hrtc.Init.OutPutPullUp  = RTC_OUTPUT_PULLUP_NONE;

    if (HAL_RTC_Init(&hrtc) != HAL_OK) {
        Error_Handler();
    }

    /* force prescaler write (HAL skips when backup domain INITS=1) */
    __HAL_RTC_WRITEPROTECTION_DISABLE(&hrtc);
    if (RTC_EnterInitMode(&hrtc) == HAL_OK) {
        hrtc.Instance->PRER  = (uint32_t){{ rtc_sync_prediv }};
        hrtc.Instance->PRER |= (uint32_t)({{ rtc_async_prediv }} << RTC_PRER_PREDIV_A_Pos);
        RTC_ExitInitMode(&hrtc);
    }
    __HAL_RTC_WRITEPROTECTION_ENABLE(&hrtc);

    /* clear stale flags from backup-domain-preserved state */
    __HAL_RTC_WAKEUPTIMER_CLEAR_FLAG(&hrtc, RTC_FLAG_WUTF);
    __HAL_RTC_ALARM_CLEAR_FLAG(&hrtc, RTC_FLAG_ALRAF);

{% if rtc_init_time %}
    /* set initial RTC calendar time */
    {
        RTC_TimeTypeDef sTime = {0};
        RTC_DateTypeDef sDate = {0};
        sTime.Hours   = {{ rtc_init_time.hour }};
        sTime.Minutes = {{ rtc_init_time.min }};
        sTime.Seconds = {{ rtc_init_time.sec }};
        sDate.Year    = {{ rtc_init_time.year }};
        sDate.Month   = {{ rtc_init_time.month }};
        sDate.Date    = {{ rtc_init_time.day }};
        HAL_RTC_SetTime(&hrtc, &sTime, RTC_FORMAT_BIN);
        HAL_RTC_SetDate(&hrtc, &sDate, RTC_FORMAT_BIN);

        rtc_init_sec_of_day = {{ rtc_init_time.hour }} * 3600
                            + {{ rtc_init_time.min }} * 60
                            + {{ rtc_init_time.sec }};
    }
{% endif %}

    /* fixed 1-second wakeup heartbeat */
    RTC_WakeUp_Config();

    HAL_NVIC_SetPriority(RTC_TAMP_IRQn, 1, 0);
    HAL_NVIC_EnableIRQ(RTC_TAMP_IRQn);

    /* create built-in periodic timers */
    rtc_timer_handle_t t_min  = RTC_TimerCreate(0, RTC_TIMER_MODE_PERIODIC_MINUTE, minute_timer_cb, NULL);
    rtc_timer_handle_t t_hour = RTC_TimerCreate(0, RTC_TIMER_MODE_PERIODIC_HOUR,  hour_timer_cb, NULL);
    RTC_TimerStart(t_min);
    RTC_TimerStart(t_hour);
{% for alarm in rtc_alarms %}
    {
        rtc_timer_handle_t t_{{ alarm.event | lower }} =
            RTC_TimerCreate({{ alarm.period_ms }} / 1000, RTC_TIMER_MODE_PERIODIC_SEC,
                            alarm_{{ alarm.event | lower }}_cb, NULL);
        RTC_TimerStart(t_{{ alarm.event | lower }});
    }
{% endfor %}

    rtc_ready = true;
}

void RTC_Start(void) {}

/* ========================================================================
 *  ISR callbacks
 * ======================================================================== */

/* 1-second heartbeat: increment uptime, fire expired, re-arm Alarm A */
void HAL_RTCEx_WakeUpTimerEventCallback(RTC_HandleTypeDef *hrtc)
{
    (void)hrtc;
    BaseType_t xHigherPriorityTaskWoken = pdFALSE;

    rtc_uptime_sec++;
    rtc_fire_expired();

    portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
}

/* Alarm A fires at exact head->deadline */
void HAL_RTCEx_AlarmAEventCallback(RTC_HandleTypeDef *hrtc)
{
    (void)hrtc;
    BaseType_t xHigherPriorityTaskWoken = pdFALSE;

    rtc_uptime_sec = (timer_head && timer_head->deadline_sec > rtc_uptime_sec)
                     ? timer_head->deadline_sec
                     : rtc_uptime_sec;
    rtc_fire_expired();

    portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
}

void RTC_TAMP_IRQHandler(void)
{
    HAL_RTCEx_WakeUpTimerIRQHandler(&hrtc);
    HAL_RTC_AlarmIRQHandler(&hrtc);
}

void RTC_SetWakeUpCounter(uint32_t wake_up_counter)
{
    CLEAR_BIT(RTC->CR, RTC_CR_WUTE);
    WRITE_REG(RTC->WUTR, wake_up_counter);
    SET_BIT(RTC->CR, RTC_CR_WUTE);
}

void RTC_RestoreTickConfig(void)
{
    RTC_WakeUp_Config();
}

