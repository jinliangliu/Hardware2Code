{#
    drv_rs485.c.j2 - RS485 half-duplex driver

    Uses the POSIX-style uart_api / gpio_api interfaces instead of direct
    HAL calls, so the driver is hardware-agnostic and consistent with the
    component framework.  DE direction control is a plain GPIO output.
#}
#ifdef TEST
#include "mock_hal.h"
#else
#include "stm32g0xx_hal.h"
#endif
#include "uart_api.h"
#include "gpio_api.h"
#include "drv_{{ peripheral.name }}.h"

#ifndef TEST
static uart_handle_t g_uart_handle;
static gpio_handle_t g_de_handle;
#endif

void rs485_init(uart_handle_t uart, gpio_handle_t de_gpio)
{
#ifndef TEST
    g_uart_handle = uart;
    g_de_handle   = de_gpio;
    /* DE low = receive mode by default */
    gpio_write(g_de_handle, 0);
#else
    (void)uart;
    (void)de_gpio;
    mock_HAL_GPIO_WritePin_set(0, GPIO_PIN_RESET);
#endif
}

void rs485_set_tx(void)
{
#ifndef TEST
    gpio_write(g_de_handle, 1);
#else
    mock_HAL_GPIO_WritePin_set(0, GPIO_PIN_SET);
#endif
}

void rs485_set_rx(void)
{
#ifndef TEST
    gpio_write(g_de_handle, 0);
#else
    mock_HAL_GPIO_WritePin_set(0, GPIO_PIN_RESET);
#endif
}

void rs485_send(uint8_t *data, uint16_t len)
{
#ifndef TEST
    rs485_set_tx();
    /* Blocking write completes when the frame is shifted out; DE is
     * released right after, which is sufficient for Modbus timing. */
    uart_write(g_uart_handle, data, len);
    rs485_set_rx();
#else
    (void)data;
    (void)len;
    rs485_set_tx();
    mock_uart_write_called_flag();
    rs485_set_rx();
#endif
}

int32_t rs485_recv(uint8_t *data, uint16_t len, uint32_t timeout)
{
#ifndef TEST
    return uart_read(g_uart_handle, data, len, timeout);
#else
    (void)data;
    (void)len;
    (void)timeout;
    mock_uart_read_called_flag();
    return 0;
#endif
}
