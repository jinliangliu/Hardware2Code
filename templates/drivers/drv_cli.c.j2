/* ==================================================================
 *  cli_init  —  set up NVIC and start interrupt-driven RX
 * ================================================================== */

void cli_init(void *huart)
{
    cli_huart = (UART_HandleTypeDef *)huart;

    /* LwRB ring buffer for ISR → task byte delivery */
    lwrb_init(&cli_ringbuf, cli_ringbuf_data, CLI_RINGBUF_SIZE);

    /* hw2c_cli engine — handles all interactive terminal logic */
    cli_inst.line_buf  = cli_line_buf;
    cli_inst.line_size = sizeof(cli_line_buf);
    cli_inst.putc      = cli_uart_putc;
    cli_inst.prompt    = cli_prompt;
    cli_inst.hist_buf  = cli_hist_buf;
    hw2c_cli_init(&cli_inst);

    cli_rx_sem = xSemaphoreCreateBinary();

    /* Enable RXNE interrupt — no HAL state machine needed.
     * cli_uart_irq_handler() handles RX in the ISR directly. */
    SET_BIT(cli_huart->Instance->CR1, USART_CR1_RXNEIE_RXFNEIE);
}

/* ==================================================================
 *  cli_uart_irq_handler  —  ISR: RXNE → LwRB → semaphore
 *
 *  Called from USART2_LPUART2_IRQHandler (stm32g0xx_it.c).
 *  Direct register access avoids HAL_UART_IRQHandler which
 *  pulls in DMA dependencies we don't use.
 * ================================================================== */

void cli_uart_irq_handler(void)
{
    /* cli_huart may be NULL if ISR fires before cli_init */
    if (cli_huart == NULL) return;

    USART_TypeDef *uart = cli_huart->Instance;
    uint32_t isr = uart->ISR;

    /* RX not empty → push byte to ring buffer, wake CLI task */
    if (isr & USART_ISR_RXNE_RXFNE) {
        uint8_t ch = (uint8_t)(uart->RDR & 0xFF);
        lwrb_write(&cli_ringbuf, &ch, 1);
        {
            BaseType_t xHigherPriorityTaskWoken = pdFALSE;
            xSemaphoreGiveFromISR(cli_rx_sem, &xHigherPriorityTaskWoken);
            portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
        }
    }

    /* Clear overrun / framing / noise errors */
    if (isr & (USART_ISR_ORE | USART_ISR_FE | USART_ISR_NE)) {
        (void)uart->RDR;                     /* flush the byte that caused the error */
        uart->ICR = USART_ICR_ORECF | USART_ICR_FECF | USART_ICR_NECF;
    }
}

/* ==================================================================
 *  cli_task  —  FreeRTOS task: bridge LwRB → hw2c_cli_input
 *
 *  All line editing, VT100 escape parsing, history navigation, and
 *  tab completion are handled by hw2c_cli internally.  This task
 *  simply drains the ring buffer and feeds bytes one at a time.
 * ================================================================== */

void cli_task(void *arg)
{
    (void)arg;

    cli_register_builtin_commands();

    for (;;) {
        /* Wait for at least one character */
        if (xSemaphoreTake(cli_rx_sem, pdMS_TO_TICKS(100)) == pdTRUE) {
            uint8_t ch;
            while (lwrb_read(&cli_ringbuf, &ch, 1) > 0) {
                hw2c_cli_input(&cli_inst, ch);
            }
        }
    }
}
