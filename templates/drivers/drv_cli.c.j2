CLI_HW2C_WRAPPER(gpio)
{% endif %}
{% if has_led %}
CLI_HW2C_WRAPPER(led)
{% endif %}
{% if has_rtc %}
CLI_HW2C_WRAPPER(rtc)
{% endif %}
{% if has_modbus %}
