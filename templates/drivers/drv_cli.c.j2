/* ==================================================================
 *  Static module state
 * ================================================================== */

static UART_HandleTypeDef *cli_huart;
static SemaphoreHandle_t   cli_rx_sem = NULL;

/* Ring buffer — powered by LwRB (third-party, MIT) */
static uint8_t      cli_ringbuf_data[CLI_RINGBUF_SIZE];
static lwrb_t       cli_ringbuf;

/* hw2c_cli engine — handles line editing, VT100, history, tab */
static hw2c_cli_t   cli_inst;
static char          cli_line_buf[HW2C_CLI_CFG_MAX_CMD_LEN];
static char          cli_hist_buf[HW2C_CLI_CFG_HISTORY_DEPTH
                                  * HW2C_CLI_CFG_MAX_CMD_LEN];

/* Legacy command table (kept for backward compat with tests) */
static cli_command_t  cli_commands[CLI_MAX_COMMANDS];
static int            cli_cmd_count = 0;
static const char    *cli_prompt = CLI_PROMPT_DEFAULT;

/* ==================================================================
 *  UART output helpers
 * ================================================================== */

static void cli_uart_putc(char c)
{
    HAL_UART_Transmit((UART_HandleTypeDef *)cli_huart, (uint8_t *)&c, 1, 100);
}

void cli_output(const char *fmt, ...)
{
    char buf[128];
    va_list args;
    va_start(args, fmt);
    (void)vsnprintf(buf, sizeof(buf), fmt, args);
    va_end(args);
    buf[sizeof(buf) - 1] = '\0';
    hw2c_cli_puts(&cli_inst, buf);
}

/* ==================================================================
 *  Command table management (legacy — kept for test/shell compat)
 * ================================================================== */

void cli_register_command(const char *name, const char *help,
                          cli_cmd_handler_t handler)
{
    if (cli_cmd_count >= CLI_MAX_COMMANDS) {
        return;
    }
    cli_commands[cli_cmd_count].name    = name;
    cli_commands[cli_cmd_count].help    = help;
    cli_commands[cli_cmd_count].handler = handler;
    cli_cmd_count++;
}

static cli_command_t *cli_find_command(const char *name)
{
    int i;
    for (i = 0; i < cli_cmd_count; i++) {
        if (strcmp(cli_commands[i].name, name) == 0) {
            return &cli_commands[i];
        }
    }
    return NULL;
}

/* ==================================================================
 *  Built-in command handlers  (legacy cli_output_fn signature)
 * ================================================================== */

static void cmd_help(int argc, char *argv[], cli_output_fn out)
{
    int i;
    (void)argc;
    (void)argv;
    out("Available commands:\r\n");
    for (i = 0; i < cli_cmd_count; i++) {
        out("  %-16s - %s\r\n", cli_commands[i].name, cli_commands[i].help);
    }
}

static void cmd_version(int argc, char *argv[], cli_output_fn out)
{
    (void)argc;
    (void)argv;
{% if fw_version is defined %}
    out("Firmware version: %d.%d.%d\r\n",
        ({{ fw_version }} >> 16) & 0xFF,
        ({{ fw_version }} >> 8) & 0xFF,
        {{ fw_version }} & 0xFF);
{% else %}
    out("Firmware version: 1.0.0\r\n");
{% endif %}
    out("Build: %s %s\r\n", __DATE__, __TIME__);
}

static void cmd_uptime(int argc, char *argv[], cli_output_fn out)
{
    (void)argc;
    (void)argv;
    {
        TickType_t ticks   = xTaskGetTickCount();
        uint32_t   seconds = ticks / 1000;
        uint32_t   hours   = seconds / 3600;
        uint32_t   minutes = (seconds % 3600) / 60;
        uint32_t   secs    = seconds % 60;
        out("Uptime: %lu:%02lu:%02lu\r\n", hours, minutes, secs);
    }
}

static void cmd_free(int argc, char *argv[], cli_output_fn out)
{
    (void)argc;
    (void)argv;
    out("Free heap: %lu bytes\r\n", xPortGetFreeHeapSize());
}

{% if has_temp_sensor %}
extern uint32_t _etext;  /* linker symbol: end of .text in flash */

static void cmd_sysinfo(int argc, char *argv[], cli_output_fn out)
{
    (void)argc;
    (void)argv;

    {
        int16_t temp_raw = temp_sensor_read_celsius();
        int16_t temp_offset = (int16_t){{ temp_offset_deci }};  /* configurable from hardware.yaml */
        int16_t temp_cal = temp_raw + temp_offset;
        int16_t temp_int = temp_cal / 10;
        int16_t temp_dec = (temp_cal < 0) ? (-temp_cal) % 10 : temp_cal % 10;
        out("Temperature : %d.%d C\r\n", temp_int, temp_dec);
    }

    {
        size_t free_heap = xPortGetFreeHeapSize();
        size_t used_heap = configTOTAL_HEAP_SIZE - free_heap;
        out("Heap        : %u / %u bytes (used / total)\r\n",
            (unsigned)used_heap, (unsigned)configTOTAL_HEAP_SIZE);
    }

    {
        unsigned long used_flash  = (unsigned long)&_etext - 0x08000000UL;
        unsigned long total_flash = {{ flash_kb }}UL * 1024UL;
        out("Flash       : %lu / %lu bytes (used / total)\r\n",
            used_flash, total_flash);
    }
}
{% endif %}

static void cmd_tasks(int argc, char *argv[], cli_output_fn out)
{
    (void)argc;
    (void)argv;
    {
        char task_buf[512];
        vTaskList(task_buf);
        out("%s", task_buf);
    }
}

static void cmd_reset(int argc, char *argv[], cli_output_fn out)
{
    (void)argc;
    (void)argv;
    out("Resetting...\r\n");
    vTaskDelay(100);
    NVIC_SystemReset();
}

/* ==================================================================
 *  Conditional command: GPIO
 * ================================================================== */

{% if has_led or pins|length > 0 %}
/* Named cli_strcasecmp to avoid conflict with libc strcasecmp on host */
static int cli_strcasecmp(const char *a, const char *b)
{
    while (*a && *b) {
        char ca = (*a >= 'A' && *a <= 'Z') ? *a + 32 : *a;
        char cb = (*b >= 'A' && *b <= 'Z') ? *b + 32 : *b;
        if (ca != cb) return ca - cb;
        a++; b++;
    }
    return *a - *b;
}

static int cli_pin_lookup(const char *name, GPIO_TypeDef **port,
                          uint16_t *pin_num)
{
{% for pin in pins %}
    if (cli_strcasecmp(name, "{{ pin.id }}") == 0) {
        *port = GPIO{{ pin.id[1] }};
        *pin_num = GPIO_PIN_{{ pin.id[2:] }};
        return 0;
    }
{% endfor %}
    return -1;
}

static void cmd_gpio(int argc, char *argv[], cli_output_fn out)
{
    if (argc < 2) {
        out("Usage: gpio read <pin> | gpio write <pin> <0|1>\r\n");
        out("Available pins: {% for pin in pins %}{{ pin.id }} {% endfor %}\r\n");
        return;
    }
    if (strcmp(argv[1], "read") == 0) {
        GPIO_TypeDef *port;
        uint16_t      pn;
        if (argc < 3) { out("Usage: gpio read <pin>\r\n"); return; }
        if (cli_pin_lookup(argv[2], &port, &pn) != 0) {
            out("Unknown pin: %s\r\n", argv[2]);
            return;
        }
        {
            GPIO_PinState state = HAL_GPIO_ReadPin(port, pn);
            out("%s: %d\r\n", argv[2], state);
        }
    } else if (strcmp(argv[1], "write") == 0) {
        GPIO_TypeDef *port;
        uint16_t      pn;
        if (argc < 4) { out("Usage: gpio write <pin> <0|1>\r\n"); return; }
        if (cli_pin_lookup(argv[2], &port, &pn) != 0) {
            out("Unknown pin: %s\r\n", argv[2]);
            return;
        }
        {
            GPIO_PinState val = (argv[3][0] == '1') ? GPIO_PIN_SET
                                                    : GPIO_PIN_RESET;
            HAL_GPIO_WritePin(port, pn, val);
            out("%s -> %d\r\n", argv[2], val);
        }
    } else {
        out("Unknown gpio subcommand: %s\r\n", argv[1]);
    }
}
{% endif %}

/* ==================================================================
 *  Conditional command: LED
 * ================================================================== */

{% if has_led %}
static void cmd_led(int argc, char *argv[], cli_output_fn out)
{
    GPIO_TypeDef *port;
    uint16_t      pn;

    if (argc < 2) { out("Usage: led on|off|toggle\r\n"); return; }
{% for pin in pins %}
{% if pin.label == 'LED' %}
    port = GPIO{{ pin.id[1] }};
    pn   = GPIO_PIN_{{ pin.id[2:] }};
{% endif %}
{% endfor %}
    if (strcmp(argv[1], "on") == 0) {
        HAL_GPIO_WritePin(port, pn,
            {% if led_active_low %}GPIO_PIN_RESET{% else %}GPIO_PIN_SET{% endif %});
        out("LED ON\r\n");
    } else if (strcmp(argv[1], "off") == 0) {
        HAL_GPIO_WritePin(port, pn,
            {% if led_active_low %}GPIO_PIN_SET{% else %}GPIO_PIN_RESET{% endif %});
        out("LED OFF\r\n");
    } else if (strcmp(argv[1], "toggle") == 0) {
        HAL_GPIO_TogglePin(port, pn);
        out("LED TOGGLED\r\n");
    } else {
        out("Usage: led on|off|toggle\r\n");
    }
}
{% endif %}

/* ==================================================================
 *  Conditional commands: RTC, Modbus, Cellular, MQTT, FOTA
