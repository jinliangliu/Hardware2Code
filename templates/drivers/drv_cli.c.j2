{% if has_cellular %}
static void cmd_cellular(int argc, char *argv[], cli_output_fn out)
{
    if (argc < 2) {
        out("Usage: cellular status|imei|csq\r\n");
        return;
    }
    if (strcmp(argv[1], "status") == 0) {
        int reg = cellular_get_reg_status();
        out("Network registration: %d\r\n", reg);
    } else if (strcmp(argv[1], "imei") == 0) {
        char imei[32];
        if (cellular_get_imei(imei, sizeof(imei)) == 0) {
            out("IMEI: %s\r\n", imei);
        } else {
            out("Failed to get IMEI\r\n");
        }
    } else if (strcmp(argv[1], "csq") == 0) {
        int csq = cellular_get_csq();
        out("Signal quality (CSQ): %d\r\n", csq);
    } else {
        out("Unknown cellular subcommand: %s\r\n", argv[1]);
    }
}
{% endif %}

{% if has_mqtt %}
static void cmd_mqtt(int argc, char *argv[], cli_output_fn out)
{
    if (argc < 2) {
        out("Usage: mqtt status | mqtt publish <topic> <payload>\r\n");
        return;
    }
    if (strcmp(argv[1], "status") == 0) {
        int connected = mqtt_is_connected();
        out("MQTT: %s\r\n", connected ? "CONNECTED" : "DISCONNECTED");
    } else if (strcmp(argv[1], "publish") == 0) {
        int result;
        if (argc < 4) {
            out("Usage: mqtt publish <topic> <payload>\r\n");
            return;
        }
        result = mqtt_publish(argv[2], argv[3], strlen(argv[3]), 0);
        out("Publish result: %d\r\n", result);
    } else {
        out("Unknown mqtt subcommand: %s\r\n", argv[1]);
    }
}
{% endif %}

{% if has_fota %}
static void cmd_fota(int argc, char *argv[], cli_output_fn out)
{
    if (argc < 2) {
        out("Usage: fota status | fota progress\r\n");
        return;
    }
    if (strcmp(argv[1], "status") == 0) {
        static const char *state_names[] = {
            "IDLE", "RECEIVING", "APPLYING", "VERIFYING", "COMPLETE", "ERROR"
        };
        fota_state_t state = fota_get_state();
        out("FOTA state: %s\r\n",
            (state <= FOTA_STATE_ERROR) ? state_names[state] : "UNKNOWN");
    } else if (strcmp(argv[1], "progress") == 0) {
        uint32_t progress = fota_get_progress();
        out("FOTA progress: %lu%%\r\n", progress);
    } else {
        out("Unknown fota subcommand: %s\r\n", argv[1]);
    }
}
{% endif %}

/* ==================================================================
 *  hw2c_cli wrappers — bridge hw2c_cli dispatch to old handlers
 *
 *  Each built-in command is registered with hw2c_cli via a thin
 *  wrapper that forwards (argc, argv) to the legacy handler with
 *  cli_output as the output function.
 * ================================================================== */

#define CLI_HW2C_WRAPPER(name) \
    static void _hw2c_##name(int argc, char *argv[], hw2c_cli_t *cli) \
    { \
        (void)cli; \
        cmd_##name(argc, argv, cli_output); \
    }

