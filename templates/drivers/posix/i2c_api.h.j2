/**
 * @file  i2c_api.h
 * @brief POSIX-style I2C bus driver API (generated by hw2c)
 *
 * One physical I2C bus maps to one opaque handle.  Devices sharing the
 * same physical bus are distinguished by their 7-bit slave address in
 * every call, so any number of I2C devices (MPU6050, EEPROM, ...) can
 * live on a single bus without driver changes.
 *
 * Auto-generated — do not edit manually.
 */

#ifndef __I2C_API_H
#define __I2C_API_H

#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

/* ---- Opaque bus handle ---- */
typedef struct i2c_dev *i2c_handle_t;

/* ---- Open configuration (optional, NULL = defaults) ---- */
typedef struct {
    uint32_t timeout_ms;   /* default transfer timeout; 0 = 100 ms */
} i2c_cfg_t;

/* Memory-address width constants (mirror HAL I2C_MEMADD_SIZE_*) */
#define I2C_MEMADDR_SIZE_8BIT    1U
#define I2C_MEMADDR_SIZE_16BIT   2U

/* ---- Bus lifecycle ---- */
/* Opens a physical bus by name ("i2c1").  Opening an already-open bus
 * returns the same handle (a bus is a shared resource).  NULL on error. */
i2c_handle_t i2c_open(const char *bus_name, const i2c_cfg_t *cfg);
const char  *i2c_name(i2c_handle_t h);

/* ---- Register access (8-bit register address, e.g. MPU6050) ----
 * dev_addr is the 7-bit slave address (0x68, not 0xD0).
 * Returns 0 on success, negative on error. */
int32_t i2c_read_reg(i2c_handle_t h, uint8_t dev_addr, uint8_t reg,
                     uint8_t *buf, uint32_t len, uint32_t timeout_ms);
int32_t i2c_write_reg(i2c_handle_t h, uint8_t dev_addr, uint8_t reg,
                      const uint8_t *buf, uint32_t len, uint32_t timeout_ms);

/* ---- Memory access (8/16-bit memory address, e.g. EEPROM) ---- */
int32_t i2c_mem_read(i2c_handle_t h, uint8_t dev_addr, uint16_t mem_addr,
                     uint8_t mem_addr_size,
                     uint8_t *buf, uint32_t len, uint32_t timeout_ms);
int32_t i2c_mem_write(i2c_handle_t h, uint8_t dev_addr, uint16_t mem_addr,
                      uint8_t mem_addr_size,
                      const uint8_t *buf, uint32_t len, uint32_t timeout_ms);

/* ---- Raw transfer ---- */
int32_t i2c_transmit(i2c_handle_t h, uint8_t dev_addr,
                     const uint8_t *buf, uint32_t len, uint32_t timeout_ms);
int32_t i2c_receive(i2c_handle_t h, uint8_t dev_addr,
                    uint8_t *buf, uint32_t len, uint32_t timeout_ms);

/* ---- Bus probing / scan ---- */
int32_t i2c_is_device_ready(i2c_handle_t h, uint8_t dev_addr, uint32_t tries);
/* Scans 1..127 and stores found 7-bit addresses in found[].
 * Returns the number of devices found (may exceed max_count). */
int32_t i2c_scan(i2c_handle_t h, uint8_t *found, uint32_t max_count, uint32_t tries);

#ifdef __cplusplus
}
