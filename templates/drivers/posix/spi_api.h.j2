/**
 * @file  spi_api.h
 * @brief POSIX-style SPI bus driver API (generated by hw2c)
 *
 * One physical SPI bus maps to one opaque handle.  Devices sharing the
 * same bus are distinguished by their chip-select GPIO (CS) in every
 * call, so any number of SPI devices can live on one bus without driver
 * changes — the SPI equivalent of i2c_api's device-address model.
 *
 * CS is controlled in software through gpio_api (open-drain/active-low
 * GPIO labelled in hardware.yaml), keeping the transport independent of
 * the physical SPI peripheral.
 *
 * Auto-generated — do not edit manually.
 */

#ifndef __SPI_API_H
#define __SPI_API_H

#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

/* ---- Opaque bus handle ---- */
typedef struct spi_dev *spi_handle_t;

/* ---- Open configuration (optional, NULL = defaults) ---- */
typedef struct {
    uint32_t timeout_ms;   /* HAL poll timeout; 0 = 100 ms */
} spi_cfg_t;

/* ---- Bus lifecycle ---- */
/* Opens a physical bus by name ("spi1").  Idempotent: opening an
 * already-open bus returns the same handle (a bus is a shared resource).
 * NULL on error. */
spi_handle_t spi_open(const char *bus_name, const spi_cfg_t *cfg);
const char  *spi_name(spi_handle_t h);

/* ---- Register access (8-bit register address + R/W bit, e.g. MPU6500)
 * cs_name is the GPIO label of the device's chip-select (active low).
 * Read sets the address MSB (R/W=1) and keeps CS asserted for the whole
 * burst; write clears it (R/W=0).
 * Returns 0 on success, negative on error. */
int32_t spi_read_reg(spi_handle_t h, const char *cs_name, uint8_t reg,
                     uint8_t *buf, uint32_t len, uint32_t timeout_ms);
int32_t spi_write_reg(spi_handle_t h, const char *cs_name, uint8_t reg,
                      const uint8_t *buf, uint32_t len, uint32_t timeout_ms);

/* ---- Raw transfer ---- */
int32_t spi_transfer(spi_handle_t h, const char *cs_name,
                     const uint8_t *tx, uint8_t *rx, uint32_t len,
                     uint32_t timeout_ms);
int32_t spi_transmit(spi_handle_t h, const char *cs_name,
                     const uint8_t *tx, uint32_t len, uint32_t timeout_ms);
int32_t spi_receive(spi_handle_t h, const char *cs_name,
                    uint8_t *rx, uint32_t len, uint32_t timeout_ms);

#ifdef __cplusplus
}
#endif

#endif /* __SPI_API_H */
