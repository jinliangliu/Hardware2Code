# Makefile generated by Hardware2Code
# MCU: {{ mcu.part }} (Cortex-M0+)
# Core Clock: {{ mcu.core_clock_mhz }} MHz
{% if hil_mode %}
# ** HIL TEST FIRMWARE **
{% else %}
# FreeRTOS Kernel: included from static
{% endif %}

SHELL = cmd
PROJECT_NAME = {{ project_name | default('hw2code') }}

# ---------------------------------------------------------------------------
# Toolchain
# ---------------------------------------------------------------------------
CC      = arm-none-eabi-gcc
AS      = arm-none-eabi-gcc -x assembler-with-cpp
CP      = arm-none-eabi-objcopy
SZ      = arm-none-eabi-size
GDB     = arm-none-eabi-gdb

# ---------------------------------------------------------------------------
# Flash programming tools
# ---------------------------------------------------------------------------
ST_PROG ?= C:/Program Files/STMicroelectronics/STM32Cube/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe
OPENOCD ?= openocd
OPENOCD_IFACE_CFG ?= -f interface/cmsis-dap.cfg
OPENOCD_TARGET_CFG ?= -f target/stm32g0x.cfg
OPENOCD_EXTRA ?=

# ---------------------------------------------------------------------------
# MCU Flags (Cortex-M0+, no FPU)
# ---------------------------------------------------------------------------
MCU_FLAGS     = -mcpu=cortex-m0plus -mthumb
CPU_DEFINE    = -D{{ mcu.part | upper }}
CLOCK_DEFINE  = -DHSE_VALUE={{ mcu.hse_freq | default(8000000) }} -DHCLK_FREQ={{ mcu.core_clock_mhz * 1000000 }}

# ---------------------------------------------------------------------------
# Directories (static library is set via environment if needed)
# ---------------------------------------------------------------------------
HARDWARE2CODE_STATIC ?= {{ static_dir_absolute }}
HAL_DIR             = $(HARDWARE2CODE_STATIC)/HAL
CMSIS_DEVICE_DIR    = $(HARDWARE2CODE_STATIC)/CMSIS/Device/ST/STM32G0xx
CMSIS_CORE_DIR      = $(HARDWARE2CODE_STATIC)/CMSIS/Core
STARTUP_DIR         = $(CMSIS_DEVICE_DIR)/Source/Templates/gcc
LINKER_SCRIPT       = ./linker/{{ 'app_slot_a.ld' if has_bootloader else 'STM32G0B1RETx_FLASH.ld' }}

{% if hil_mode %}
# ---------------------------------------------------------------------------
# HIL Test Firmware sources
# ---------------------------------------------------------------------------
UNITY_DIR = ./unity
C_SOURCES  = \
{% for src in hal_sources %}
$(HAL_DIR)/Src/{{ src }} \
{% endfor %}
$(CMSIS_DEVICE_DIR)/Source/Templates/system_stm32g0xx.c \
$(UNITY_DIR)/unity.c \
./src/main.c

ASM_SOURCES = $(STARTUP_DIR)/startup_stm32g0b1xx.s

# Include paths
INCLUDES  = \
-I$(HAL_DIR)/Inc \
-I$(CMSIS_DEVICE_DIR)/Include \
-I$(CMSIS_CORE_DIR) \
-I$(UNITY_DIR) \
-I./config \
-I./src

# Compiler / Linker flags
CFLAGS   = $(MCU_FLAGS) $(CPU_DEFINE) $(CLOCK_DEFINE) \
           -Og -g3 -Wall -fdata-sections -ffunction-sections \
           $(INCLUDES) -DSTM32G0B1xx -DUSE_HAL_DRIVER

{% else %}
# ---------------------------------------------------------------------------
# FreeRTOS Kernel directory
# ---------------------------------------------------------------------------
FREERTOS_DIR        = $(HARDWARE2CODE_STATIC)/FreeRTOS-Kernel

# ---------------------------------------------------------------------------
# Source files (HAL + CMSIS + FreeRTOS + User + Startup)
# ---------------------------------------------------------------------------
C_SOURCES  = \
{% for src in hal_sources %}
$(HAL_DIR)/Src/{{ src }} \
{% endfor %}
{% if has_log %}
$(HAL_DIR)/Src/stm32g0xx_hal_uart.c \
$(HAL_DIR)/Src/stm32g0xx_hal_uart_ex.c \
{% endif %}
$(CMSIS_DEVICE_DIR)/Source/Templates/system_stm32g0xx.c

# FreeRTOS Kernel sources
C_SOURCES += \
$(FREERTOS_DIR)/tasks.c \
$(FREERTOS_DIR)/queue.c \
$(FREERTOS_DIR)/list.c \
$(FREERTOS_DIR)/timers.c \
$(FREERTOS_DIR)/event_groups.c \
$(FREERTOS_DIR)/stream_buffer.c \
$(FREERTOS_DIR)/portable/MemMang/heap_4.c \
$(FREERTOS_DIR)/portable/GCC/ARM_CM0/port.c \
$(FREERTOS_DIR)/portable/GCC/ARM_CM0/portasm.c

# User application
C_SOURCES += \
./src/main.c \
./src/gpio.c \
./src/sleep.c \
./src/stm32g0xx_it.c \
./src/event_mgr.c \
{% if has_rtc %}
./src/stm32g0xx_hal_timebase_tim.c \
{% endif %}
{% if has_business_flow %}
./src/statemachine.c \
{% endif %}
{% if has_bootloader %}
./src/boot_app.c \
{% endif %}
{% for drv in drivers %}
./src/drivers/drv_{{ drv.name }}.c \
{% endfor %}
{% if has_log %}
./src/drivers/drv_log.c \
{% endif %}

# Assembly startup
ASM_SOURCES = $(STARTUP_DIR)/startup_stm32g0b1xx.s

# Include paths
INCLUDES  = \
-I$(HAL_DIR)/Inc \
-I$(CMSIS_DEVICE_DIR)/Include \
-I$(CMSIS_CORE_DIR) \
-I$(FREERTOS_DIR)/include \
-I$(FREERTOS_DIR)/portable/GCC/ARM_CM0 \
-I./src \
-I./src/drivers \
-I./config

# Compiler / Linker flags
CFLAGS   = $(MCU_FLAGS) $(CPU_DEFINE) $(CLOCK_DEFINE) \
           -Og -g3 -Wall -fdata-sections -ffunction-sections \
           $(INCLUDES) -DSTM32G0B1xx -DUSE_HAL_DRIVER{% if has_bootloader %} -DVECT_TAB_OFFSET={{ boot_config.app_a_offset | default(0x2000) }}U{% endif %}

{% endif %}

# ---------------------------------------------------------------------------
# Linker flags (common)
# ---------------------------------------------------------------------------
LDFLAGS  = $(MCU_FLAGS) -T$(LINKER_SCRIPT) -specs=nano.specs -specs=nosys.specs \
           -Wl,--gc-sections -Wl,-Map=$(BUILD_DIR)/$(PROJECT_NAME).map

# ---------------------------------------------------------------------------
# Object files (flat structure inside build/)
# ---------------------------------------------------------------------------
BUILD_DIR   = build
C_OBJS      = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o)))
ASM_OBJS    = $(addprefix $(BUILD_DIR)/,$(notdir $(ASM_SOURCES:.s=.o)))
OBJS        = $(C_OBJS) $(ASM_OBJS)

# ---------------------------------------------------------------------------
# Build rules
# ---------------------------------------------------------------------------
.PHONY: all flash flash-daplink clean test coverage{% if hil_mode %} hil-flash{% endif %}{% if has_bootloader %} bootloader app combined flash-combined{% if has_fota %} fota-diff fota-send{% endif %}{% endif %}

all: $(BUILD_DIR)/$(PROJECT_NAME).elf $(BUILD_DIR)/$(PROJECT_NAME).bin $(BUILD_DIR)/$(PROJECT_NAME).hex

# ----- User source files -----
$(BUILD_DIR)/%.o: ./src/%.c
	@if not exist $(BUILD_DIR) mkdir $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

# ----- HAL source files -----
$(BUILD_DIR)/%.o: $(HAL_DIR)/Src/%.c
	@if not exist $(BUILD_DIR) mkdir $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

# ----- CMSIS Device system file -----
$(BUILD_DIR)/system_stm32g0xx.o: $(CMSIS_DEVICE_DIR)/Source/Templates/system_stm32g0xx.c
	@if not exist $(BUILD_DIR) mkdir $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

{% if not hil_mode %}
# ----- FreeRTOS Kernel source files -----
$(BUILD_DIR)/%.o: $(FREERTOS_DIR)/%.c
	@if not exist $(BUILD_DIR) mkdir $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/port.o: $(FREERTOS_DIR)/portable/GCC/ARM_CM0/port.c
	@if not exist $(BUILD_DIR) mkdir $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/portasm.o: $(FREERTOS_DIR)/portable/GCC/ARM_CM0/portasm.c
	@if not exist $(BUILD_DIR) mkdir $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/heap_4.o: $(FREERTOS_DIR)/portable/MemMang/heap_4.c
	@if not exist $(BUILD_DIR) mkdir $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

# ----- Driver source files -----
$(BUILD_DIR)/%.o: ./src/drivers/%.c
	@if not exist $(BUILD_DIR) mkdir $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

{% else %}
# ----- Unity source file -----
$(BUILD_DIR)/unity.o: $(UNITY_DIR)/unity.c
	@if not exist $(BUILD_DIR) mkdir $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@
{% endif %}

# ----- Startup assembly -----
$(BUILD_DIR)/%.o: $(STARTUP_DIR)/%.s
	@if not exist $(BUILD_DIR) mkdir $(BUILD_DIR)
	$(AS) $(MCU_FLAGS) -c $< -o $@

# ----- Link -----
$(BUILD_DIR)/$(PROJECT_NAME).elf: $(OBJS)
	$(CC) $(LDFLAGS) $(OBJS) -o $@
	$(SZ) $@

# ----- Binary / Hex -----
$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf
	$(CP) -O binary $< $@

$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf
	$(CP) -O ihex $< $@

# ----- Flash (ST-Link) -----
{% if has_bootloader %}
# With bootloader: flash combined image (bootloader + app)
flash: combined
	"$(ST_PROG)" -c port=SWD -w build\combined.bin 0x08000000 -rst

# Flash app-only to its slot (for OTA update, with CRC)
flash-app: app
	"$(ST_PROG)" -c port=SWD -w build\{{ project_name }}_crc.bin 0x08002000 -rst

{% else %}
flash: $(BUILD_DIR)/$(PROJECT_NAME).bin
	"$(ST_PROG)" -c port=SWD -w $< 0x08000000 -rst
{% endif %}

# ----- Flash (DAP-Link) -----
{% if has_bootloader %}
flash-daplink: combined
	"$(OPENOCD)" $(OPENOCD_IFACE_CFG) $(OPENOCD_TARGET_CFG) $(OPENOCD_EXTRA) -c "program build/combined.bin 0x08000000 verify reset exit"

flash-daplink-app: app
	"$(OPENOCD)" $(OPENOCD_IFACE_CFG) $(OPENOCD_TARGET_CFG) $(OPENOCD_EXTRA) -c "program build/{{ project_name }}_crc.bin 0x08002000 verify reset exit"
{% else %}
flash-daplink: $(BUILD_DIR)/$(PROJECT_NAME).bin
	"$(OPENOCD)" $(OPENOCD_IFACE_CFG) $(OPENOCD_TARGET_CFG) $(OPENOCD_EXTRA) -c "program $< 0x08000000 verify reset exit"
{% endif %}

{% if hil_mode %}
# ----- HIL Flash & Run Listener -----
hil-flash: flash
	@echo "HIL test firmware flashed. Run 'python hil_runner.py' to see results."
{% endif %}

# ----- Clean -----
clean:
	@if exist $(BUILD_DIR) rmdir /S /Q $(BUILD_DIR)

{% if not hil_mode %}
# ----- Unit tests -----
test:
	python test/run_tests.py

coverage:
	python test/run_tests.py --coverage

{% if has_bootloader %}
# ----- Bootloader build (uses separate Makefile in bootloader/) -----
bootloader:
	cd bootloader && $(MAKE) all

app: all
	@echo "Patching CRC32 into App firmware..."
	python patch_crc.py build\{{ project_name }}.bin --version $(FOTA_VERSION) -o build\{{ project_name }}_crc.bin
	@echo "App firmware with CRC: build\{{ project_name }}_crc.bin"

# ----- Combined flash image: Bootloader + App Slot A -----
combined: bootloader app
	@echo "Padding bootloader to {{ boot_config.size_kb }}KB and merging with app..."
	python -c "import sys; bl=open('bootloader/build/bootloader.bin','rb').read(); bl_padded=bl+b'\xFF'*({{ boot_config.size_kb * 1024 }}-len(bl)); app=open('build/{{ project_name }}_crc.bin','rb').read(); open('build/combined.bin','wb').write(bl_padded+app)"
	$(SZ) build\{{ project_name }}.elf
	@echo "Combined image: build\combined.bin"

# ----- Flash combined image -----
flash-combined: combined
	"$(ST_PROG)" -c port=SWD -w build\combined.bin 0x08000000 -rst

# ----- Flash combined with DAP-Link -----
flash-daplink-combined: combined
	"$(OPENOCD)" $(OPENOCD_IFACE_CFG) $(OPENOCD_TARGET_CFG) $(OPENOCD_EXTRA) -c "program build/combined.bin 0x08000000 verify reset exit"

{% if has_fota %}
# ----- FOTA: generate diff patch from previous firmware -----
# Usage:
#   make FOTA_PREV_FW=build/v1.0_crc.bin FOTA_VERSION=0x02 fota-diff
#   make FOTA_PORT=COM4 fota-send
FOTA_VERSION ?= 1
FOTA_PREV_FW ?= build/prev_firmware_crc.bin

fota-diff: app
	@echo "Generating BSDIFF patch..."
	@echo "  Old: $(FOTA_PREV_FW)"
	@echo "  New: build/{{ project_name }}_crc.bin"
	python generator/bsdiff_tool.py $(FOTA_PREV_FW) build/{{ project_name }}_crc.bin -o build/{{ project_name }}_diff.patch
	@echo "Diff patch: build/{{ project_name }}_diff.patch"

fota-send:
	python generator/fota_sender.py $(FOTA_PORT) build/{{ project_name }}_diff.patch --baud $(FOTA_BAUD)
{% endif %}
{% endif %}
{% endif %}