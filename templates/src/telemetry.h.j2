 *
 * Auto-generated -- do not edit manually.
 */

#ifndef __TELEMETRY_H
#define __TELEMETRY_H

#include <stdint.h>
#include <stdbool.h>

#ifdef __cplusplus
extern "C" {
#endif

/**
 * @brief Maximum number of tasks monitored for stack usage
 */
#define TELEMETRY_MAX_TASKS  16

/**
 * @brief Task stack snapshot entry
 */
typedef struct {
    const char *name;           /**< Task name (FreeRTOS) */
    uint16_t    peak_usage;     /**< Peak stack words used */
    uint16_t    total_stack;    /**< Total stack words allocated */
    uint16_t    watermark;      /**< Stack high-water mark (words remaining) */
    uint32_t    cpu_ticks;      /**< Runtime tick count (requires TRACE_FACILITY) */
} telemetry_task_t;

/**
 * @brief System health snapshot
 */
typedef struct {
    /* Heartbeat */
    uint32_t    uptime_sec;         /**< System uptime in seconds */
    uint32_t    heartbeat_count;     /**< Global heartbeat counter */

    /* Memory */
    uint32_t    heap_free;          /**< Free heap bytes */
    uint32_t    heap_min_free;      /**< Minimum free heap observed */
    uint32_t    heap_size;          /**< Total heap size */

    /* Tasks */
    uint32_t    task_count;         /**< Number of running tasks */
    uint32_t    min_stack_free;     /**< Minimum free stack across all tasks */
    telemetry_task_t tasks[TELEMETRY_MAX_TASKS];  /**< Per-task stack stats */

    /* Components */
    uint32_t    comp_total;         /**< Total registered components */
    uint32_t    comp_running;       /**< Components in RUNNING state */
    uint32_t    comp_error;         /**< Components in ERROR state */
    uint32_t    total_errors;       /**< Cumulative error count across all components */
} telemetry_snapshot_t;

/**
 * @brief Callback type for telemetry snapshot consumers
 * @param snap  Pointer to a filled telemetry_snapshot_t (read-only)
 * @param ctx   User-provided context pointer
 */
typedef void (*telemetry_callback_t)(const telemetry_snapshot_t *snap, void *ctx);

/* ---- Telemetry API ---- */

/**
 * @brief  Initialize the telemetry subsystem
 */
void telemetry_init(void);

/**
 * @brief  Register a callback to be invoked on each telemetry snapshot
 * @param  cb   Callback function
 * @param  ctx  User context (passed to callback)
 * @return 0 on success, -1 if callback slots exhausted
 */
int telemetry_register_callback(telemetry_callback_t cb, void *ctx);

/**
 * @brief  Collect a full system health snapshot
 * @param  snap  Pointer to caller-allocated snapshot struct
 * @return 0 on success
 *
 * Collects heap, stack, task, and component health data.
 * Caller must provide a pre-allocated telemetry_snapshot_t.
 * Safe to call from any task context.
 */
int telemetry_collect(telemetry_snapshot_t *snap);

/**
 * @brief  Log the current telemetry snapshot at INFO level
