/**
 * @brief  Increment error counter for a specific component
 * @param  comp_name  Component name (must match registry)
 *
 * Called automatically by component_step_all() on step() failure.
 * Also callable from user code for manual error counting.
 */
void telemetry_inc_error(const char *comp_name);

/**
 * @brief  Mark a heartbeat from a specific component
 * @param  comp_name  Component name (must match registry)
 *
 * Called automatically by component_step_all() on each successful step().
 */
void telemetry_heartbeat(const char *comp_name);

#ifdef __cplusplus
}
