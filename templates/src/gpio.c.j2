{#
 gpio.c.j2 - GPIO initialization template
 Generates: src/gpio.c
 Requires context variables: pins
For each pin: enables GPIO clock, configures mode/pull/speed/AF, and enables NVIC if EXTI is set.
#}
#ifdef TEST
#include "mock_hal.h"
#else
#include "stm32g0xx_hal.h"
#endif

void MX_GPIO_Init(void)
{
    GPIO_InitTypeDef GPIO_InitStruct = {0};

    /* SYSCFG clock must be enabled for EXTI line mapping (STM32G0) */
    __HAL_RCC_SYSCFG_CLK_ENABLE();

{% for pin in pins %}
    /* {{ pin.label }} ({{ pin.id }}) */
    __HAL_RCC_GPIO{{ pin.id[1] }}_CLK_ENABLE();
    GPIO_InitStruct.Pin = GPIO_PIN_{{ pin.id[2:] }};

{% if pin.function == 'GPIO_Output' %}
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
{% elif pin.function == 'GPIO_Input' %}
{% if pin.exti and pin.exti.enable %}
{% if pin.exti.trigger == 'both' %}
    GPIO_InitStruct.Mode = GPIO_MODE_IT_RISING_FALLING;
{% elif pin.exti.trigger == 'rising' %}
    GPIO_InitStruct.Mode = GPIO_MODE_IT_RISING;
{% else %}
    GPIO_InitStruct.Mode = GPIO_MODE_IT_FALLING;
{% endif %}
{% else %}
    GPIO_InitStruct.Mode = GPIO_MODE_INPUT;
{% endif %}
    GPIO_InitStruct.Pull = {% if pin.pull == 'up' %}GPIO_PULLUP{% else %}GPIO_NOPULL{% endif %};
{% elif 'I2C' in pin.function %}
    GPIO_InitStruct.Mode = GPIO_MODE_AF_OD;
    GPIO_InitStruct.Pull = GPIO_PULLUP;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_HIGH;
    GPIO_InitStruct.Alternate = {{ pin.af }};
{% elif 'SPI' in pin.function %}
    GPIO_InitStruct.Mode = GPIO_MODE_AF_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_HIGH;
    GPIO_InitStruct.Alternate = {{ pin.af }};
{% elif 'TIM' in pin.function %}
    GPIO_InitStruct.Mode = GPIO_MODE_AF_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
    GPIO_InitStruct.Alternate = {{ pin.af }};
{% elif 'UART' in pin.function or 'USART' in pin.function or 'LPUART' in pin.function %}
    GPIO_InitStruct.Mode = GPIO_MODE_AF_PP;
    GPIO_InitStruct.Pull = GPIO_PULLUP;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_HIGH;
    GPIO_InitStruct.Alternate = {{ pin.af }};
{% elif pin.function == 'CELL_PWR' or pin.function == 'CELL_RST' %}
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
{% elif 'ADC' in pin.function %}
    GPIO_InitStruct.Mode = GPIO_MODE_ANALOG;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
{% elif pin.function == 'IR_OUT' %}
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_HIGH;
{% elif pin.function == 'IR_IN' %}
    GPIO_InitStruct.Mode = GPIO_MODE_INPUT;
    GPIO_InitStruct.Pull = GPIO_PULLUP;
{% elif pin.function == 'RS485_DE' %}
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
{% endif %}

    HAL_GPIO_Init(GPIO{{ pin.id[1] }}, &GPIO_InitStruct);

{% if pin.function == 'GPIO_Output' and pin.active_level == 'low' %}
    /* 初始输出高电平，LED 熄灭（低电平有效） */
    HAL_GPIO_WritePin(GPIO{{ pin.id[1] }}, GPIO_PIN_{{ pin.id[2:] }}, GPIO_PIN_SET);
{% endif %}
{% if pin.function == 'RS485_DE' %}
    /* RS485 DE pin: initial LOW = receive mode */
    HAL_GPIO_WritePin(GPIO{{ pin.id[1] }}, GPIO_PIN_{{ pin.id[2:] }}, GPIO_PIN_RESET);
{% endif %}
{% if pin.function == 'CELL_PWR' or pin.function == 'CELL_RST' %}
    /* Cellular control pin: initial HIGH = power disabled / reset inactive */
    HAL_GPIO_WritePin(GPIO{{ pin.id[1] }}, GPIO_PIN_{{ pin.id[2:] }}, GPIO_PIN_SET);
{% endif %}
    {% if pin.exti and pin.exti.enable %}
    /* Set EXTI priority to FreeRTOS-safe level (>= configLIBRARY_MAX_SYSCALL_INTERRUPT_PRIORITY) */
    HAL_NVIC_SetPriority({{ pin.id | exti_irq_name }}, 1, 0);
    HAL_NVIC_EnableIRQ({{ pin.id | exti_irq_name }});
    {% endif %}
{% endfor %}
}
