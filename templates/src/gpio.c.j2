#include "stm32g0xx_hal.h"

void MX_GPIO_Init(void)
{
    GPIO_InitTypeDef GPIO_InitStruct = {0};

{% for pin in pins %}
    /* {{ pin.label }} ({{ pin.id }}) */
    __HAL_RCC_GPIO{{ pin.id[1] }}_CLK_ENABLE();
    GPIO_InitStruct.Pin = GPIO_PIN_{{ pin.id[2:] }};
{% if pin.function == 'GPIO_Output' %}
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
{% elif pin.function == 'GPIO_Input' %}
    GPIO_InitStruct.Mode = GPIO_MODE_IT_FALLING;
    GPIO_InitStruct.Pull = {% if pin.pull == 'up' %}GPIO_PULLUP{% else %}GPIO_NOPULL{% endif %};
{% endif %}
    HAL_GPIO_Init(GPIO{{ pin.id[1] }}, &GPIO_InitStruct);

    /* Enable NVIC if EXTI is configured */
    {% if pin.exti and pin.exti.enable %}
    HAL_NVIC_EnableIRQ(
        {%- set pin_num = pin.id[2:] | int -%}
        {%- if pin_num <= 1 %}EXTI0_1_IRQn
        {%- elif pin_num <= 3 %}EXTI2_3_IRQn
        {%- else %}EXTI4_15_IRQn
        {%- endif -%}
    );
    {% endif %}
{% endfor %}
}