#ifndef __EVENT_MGR_H
#define __EVENT_MGR_H

#ifdef TEST
#include "mock_hal.h"
#else
#include "FreeRTOS.h"
#include "queue.h"
#endif

/* ========== 事件枚举 ========== */
typedef enum {
    EVENT_NONE = 0,
    EVENT_MINUTE_TICK,
    EVENT_HOUR_TICK,
    EVENT_BUTTON_PRESS,
    EVENT_RTC_ALARM,
    EVENT_RTC_TICK,
{% for p in peripherals %}
{% if p.type == 'I2C_Sensor_MPU6050' %}
    EVENT_MPU6050_ALERT,
{% endif %}
{% endfor %}

/* ========== 动态定时器事件（从 start_timer 和 after 生成） ========== */
{% set all_timer_events = [] %}
{% macro collect_timer_events(states, prefix='') %}
{% for state in states %}
    {% for trans in state.transitions %}
        {% for action in trans.actions %}
            {% if 'start_timer' in action %}
                {% set evt = 'EVENT_TIMER_EXPIRED_' + action.split(' ')[1] %}
                {% if evt not in all_timer_events %}
                    {% set _ = all_timer_events.append(evt) %}
                {% endif %}
            {% endif %}
        {% endfor %}
    {% endfor %}
    {% for action in state.get('on_entry', []) %}
        {% if 'start_timer' in action %}
            {% set evt = 'EVENT_TIMER_EXPIRED_' + action.split(' ')[1] %}
            {% if evt not in all_timer_events %}
                {% set _ = all_timer_events.append(evt) %}
            {% endif %}
        {% endif %}
    {% endfor %}
    {% for action in state.get('on_exit', []) %}
        {% if 'start_timer' in action %}
            {% set evt = 'EVENT_TIMER_EXPIRED_' + action.split(' ')[1] %}
            {% if evt not in all_timer_events %}
                {% set _ = all_timer_events.append(evt) %}
            {% endif %}
        {% endif %}
    {% endfor %}
    {% if state.after %}
        {% set evt = 'EVENT_TIMER_EXPIRED_' + prefix + state.name + '_timeout' %}
        {% if evt not in all_timer_events %}
            {% set _ = all_timer_events.append(evt) %}
        {% endif %}
    {% endif %}
    {% if state.states %}
        {{ collect_timer_events(state.states, prefix) }}
    {% endif %}
{% endfor %}
{% endmacro %}

{% if business_flow.regions %}
{% for region in business_flow.regions %}
{{ collect_timer_events(region.states, region.name + '_') }}
{% endfor %}
{% else %}
{{ collect_timer_events(business_flow.states) }}
{% endif %}

{% for evt in all_timer_events %}
    {{ evt }},
{% endfor %}

/* ========== 动态发布事件（从 publish 和 publish_async 动作生成） ========== */
{% set published_events = [] %}
{% macro collect_publishes(states) %}
{% for state in states %}
    {% for trans in state.transitions %}
        {% for action in trans.actions %}
            {% if action.startswith('publish ') or action.startswith('publish_async ') %}
                {% set evt = 'EVENT_' + action.split()[-1] | replace(' ', '_') %}
                {% if evt not in published_events %}
                    {% set _ = published_events.append(evt) %}
                {% endif %}
            {% endif %}
        {% endfor %}
    {% endfor %}
    {% for action in state.get('on_entry', []) %}
        {% if action.startswith('publish ') or action.startswith('publish_async ') %}
            {% set evt = 'EVENT_' + action.split()[-1] | replace(' ', '_') %}
            {% if evt not in published_events %}
                {% set _ = published_events.append(evt) %}
            {% endif %}
        {% endif %}
    {% endfor %}
    {% for action in state.get('on_exit', []) %}
        {% if action.startswith('publish ') or action.startswith('publish_async ') %}
            {% set evt = 'EVENT_' + action.split()[-1] | replace(' ', '_') %}
            {% if evt not in published_events %}
                {% set _ = published_events.append(evt) %}
            {% endif %}
        {% endif %}
    {% endfor %}
    {% if state.states %}
        {{ collect_publishes(state.states) }}
    {% endif %}
{% endfor %}
{% endmacro %}

{% if business_flow.regions %}
{% for region in business_flow.regions %}
{{ collect_publishes(region.states) }}
{% endfor %}
{% else %}
{{ collect_publishes(business_flow.states) }}
{% endif %}

{% for evt in published_events %}
    {{ evt }},
{% endfor %}

    EVENT_MAX
} event_id_t;

/* ========== 事件结构体 ========== */
typedef struct {
    event_id_t id;
    uint32_t   param;
} event_t;

extern QueueHandle_t event_queue;

void EventMgr_Init(void);
void EventMgr_Task(void *pvParameters);

#endif /* __EVENT_MGR_H */