{#
    sleep.c.j2 - Low power idle hook template
    Generates: src/sleep.c
    Requires context variables: sleep.mode (optional, currently ignored, always uses __WFI)
    Provides: vApplicationIdleHook() for FreeRTOS idle task.
#}

#include "stm32g0xx_hal.h"
#include "FreeRTOS.h"
#include "task.h"

void vApplicationIdleHook( void )
{
    /* MVP: enter sleep mode using WFI (works on all Cortex-M, no HAL dependency) */
    __WFI();
}