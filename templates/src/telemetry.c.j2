int telemetry_collect(telemetry_snapshot_t *snap)
{
    if (snap == NULL) return -1;

    memset(snap, 0, sizeof(*snap));

#ifndef TEST
    /* ---- Uptime ---- */
    extern uint32_t rtc_uptime_sec;
    snap->uptime_sec = rtc_uptime_sec;

    /* ---- Heartbeat ---- */
    g_telemetry.heartbeat_count++;
    snap->heartbeat_count = g_telemetry.heartbeat_count;

    /* ---- Heap ---- */
    snap->heap_free = xPortGetFreeHeapSize();
    snap->heap_size = configTOTAL_HEAP_SIZE;

    /* Update minimum free heap */
    if (snap->heap_free < g_telemetry.heap_min_free) {
        g_telemetry.heap_min_free = snap->heap_free;
    }
    snap->heap_min_free = g_telemetry.heap_min_free;

    /* ---- Task enumeration ---- */
    {
        TaskStatus_t *task_stats = NULL;
        uint32_t total_run_time;
        uint32_t task_cnt = uxTaskGetNumberOfTasks();

        /* Allocate task status array from stack, clamped to safe size */
        uint32_t count = task_cnt;
        if (count > TELEMETRY_MAX_TASKS) {
            count = TELEMETRY_MAX_TASKS;
        }

        /* Use stack-allocated array (safe up to TELEMETRY_MAX_TASKS * sizeof(TaskStatus_t)) */
        TaskStatus_t stats[TELEMETRY_MAX_TASKS];
        task_stats = stats;

        task_cnt = uxTaskGetSystemState(task_stats, count, &total_run_time);
        if (task_cnt > TELEMETRY_MAX_TASKS) {
            task_cnt = TELEMETRY_MAX_TASKS;
        }
        snap->task_count = task_cnt;

        uint32_t min_watermark = (uint32_t)(-1);

        for (uint32_t i = 0; i < task_cnt; i++) {
            snap->tasks[i].name = task_stats[i].pcTaskName;
            snap->tasks[i].peak_usage = (uint16_t)(
                task_stats[i].usStackHighWaterMark > 0
                ? 0  /* usStackHighWaterMark is remaining, not peak */
                : 0);
            (void)snap->tasks[i].peak_usage;  /* suppressed: not directly available on all configs */

            /* Get stack high-water mark (remaining words) */
            TaskHandle_t handle = xTaskGetHandle(task_stats[i].pcTaskName);
            if (handle != NULL) {
                snap->tasks[i].watermark = (uint16_t)uxTaskGetStackHighWaterMark(handle);
            } else {
                snap->tasks[i].watermark = 0;
            }

            /* Total stack from known allocations */
            snap->tasks[i].total_stack = task_stats[i].usStackHighWaterMark
                                        + snap->tasks[i].watermark;

            if (snap->tasks[i].watermark < min_watermark && snap->tasks[i].watermark > 0) {
                min_watermark = snap->tasks[i].watermark;
            }

            snap->tasks[i].cpu_ticks = task_stats[i].ulRunTimeCounter;
        }

        /* "minimum free stack" = the task with the least remaining stack */
        if (min_watermark != (uint32_t)(-1)) {
            snap->min_stack_free = min_watermark;
        } else {
            snap->min_stack_free = 0;
        }
    }
#else
    /* Test mode: fill with dummy data */
    snap->uptime_sec = 0;
    snap->heartbeat_count = 1;
    snap->heap_free = 1024;
    snap->heap_size = 8192;
    snap->heap_min_free = 1024;
    snap->task_count = 1;
    snap->min_stack_free = 128;
#endif

    /* ---- Component stats ---- */
{% if has_components %}
    {
        snap->comp_total = g_telemetry.comp_total;
        uint32_t running = 0;
        uint32_t errors = 0;
        for (uint32_t i = 0; i < g_telemetry.comp_total && i < component_count(); i++) {
            component_t *c = component_get_by_index(i);
            if (c == NULL) continue;
            if (c->state == COMPONENT_RUNNING) {
                running++;
            } else if (c->state == COMPONENT_ERROR) {
                errors++;
            }
        }
        snap->comp_running = running;
        snap->comp_error = errors;
        snap->total_errors = 0;
        for (uint32_t i = 0; i < g_telemetry.comp_total && i < component_count(); i++) {
            component_t *c = component_get_by_index(i);
            if (c != NULL) {
                snap->total_errors += c->error_count;
            }
        }
    }
{% else %}
    snap->comp_total = 0;
    snap->comp_running = 0;
    snap->comp_error = 0;
    snap->total_errors = 0;
{% endif %}

    /* ---- Notify callbacks ---- */
    for (uint32_t i = 0; i < g_cb_count; i++) {
        if (g_cb[i] != NULL) {
            g_cb[i](snap, g_cb_ctx[i]);
        }
    }

    return 0;
}

void telemetry_log_snapshot(void)
{
    telemetry_snapshot_t snap;
    telemetry_collect(&snap);

{% if has_log %}
    log_info("=== Telemetry Snapshot ===");
    log_info("  Uptime:    %lu s", (unsigned long)snap.uptime_sec);
    log_info("  Heartbeat: %lu", (unsigned long)snap.heartbeat_count);

    log_info("--- Memory ---");
    log_info("  Heap free:     %lu / %lu bytes",
             (unsigned long)snap.heap_free, (unsigned long)snap.heap_size);
    log_info("  Heap min free: %lu bytes", (unsigned long)snap.heap_min_free);

    log_info("--- Tasks (%lu) ---", (unsigned long)snap.task_count);
    for (uint32_t i = 0; i < snap.task_count && i < TELEMETRY_MAX_TASKS; i++) {
        log_info("  %-16s  stack: %u/%u free=%u  runtime=%lu",
                 snap.tasks[i].name,
                 (unsigned int)snap.tasks[i].total_stack,
                 (unsigned int)(snap.tasks[i].total_stack + snap.tasks[i].watermark),
                 (unsigned int)snap.tasks[i].watermark,
                 (unsigned long)snap.tasks[i].cpu_ticks);
    }
    log_info("  Min stack free: %lu words", (unsigned long)snap.min_stack_free);

    log_info("--- Components ---");
    log_info("  Total: %lu  Running: %lu  Error: %lu  TotalErrors: %lu",
             (unsigned long)snap.comp_total,
             (unsigned long)snap.comp_running,
             (unsigned long)snap.comp_error,
             (unsigned long)snap.total_errors);
    log_info("=== End Telemetry ===");
{% else %}
    (void)snap;
{% endif %}
}

