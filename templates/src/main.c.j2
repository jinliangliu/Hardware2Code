#include "stm32g0xx_hal.h"
#include "FreeRTOS.h"
#include "task.h"
#include "queue.h"

/* Include driver headers for each peripheral */
{% for drv in drivers %}
#include "drv_{{ drv.name }}.h"
{% endfor %}

/* Include event manager header (always present) */
#include "event_mgr.h"

{% if has_behavior %}
#include "statemachine.h"
{% endif %}

{% if has_bootloader %}
#include "boot_app.h"
{% endif %}

{% if has_log %}
#include "drv_log.h"
{% endif %}

/* GPIO initialization function */
void MX_GPIO_Init(void);

/* ------- Auto-generated pin definitions ------- */
{% for pin in pins %}
{% if pin.label == 'LED' %}
#define LED_GPIO_Port  GPIO{{ pin.id | pin_port }}
#define LED_GPIO_Pin   GPIO_PIN_{{ pin.id | pin_number }}
{% endif %}
{% endfor %}

/* ------- I2C Handles (if I2C peripherals are used) ------- */
{% for p in peripherals if 'I2C' in p.model.interface %}
I2C_HandleTypeDef hi2c{{ p.bus[-1] }};
{% endfor %}

/* ------- SPI Handles (if SPI peripherals are used) ------- */
{% for p in peripherals if 'SPI' in p.model.interface %}
SPI_HandleTypeDef hspi{{ p.bus[-1] }};
{% endfor %}

/* ------- UART Handles (if UART peripherals are used) ------- */
{% for p in peripherals if p.type == 'UART_Serial' %}
UART_HandleTypeDef huart_{{ p.name }};
{% endfor %}

/* ------- Task handles ------- */
{% for task in app_tasks %}
{% if not (has_fota and task.name == 'fota_task') %}
TaskHandle_t {{ task.name }}_handle = NULL;
{% endif %}
{% endfor %}

/* ------- Task prototypes ------- */
{% for task in app_tasks %}
{% if not (has_fota and task.name == 'fota_task') %}
void {{ task.name }}(void *pvParameters);
{% endif %}
{% endfor %}

{% if has_cli %}
void cli_task(void *arg);
{% endif %}

{% if has_fota %}
void fota_task(void *arg);
{% endif %}

/* ------- System clock configuration (HSI 16MHz default) ------- */
void SystemClock_Config(void)
{
    RCC_OscInitTypeDef RCC_OscInitStruct = {0};
    RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

    RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSI;
    RCC_OscInitStruct.HSIState = RCC_HSI_ON;
    RCC_OscInitStruct.HSICalibrationValue = RCC_HSICALIBRATION_DEFAULT;
    RCC_OscInitStruct.PLL.PLLState = RCC_PLL_NONE;
    if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK) while(1);

    RCC_ClkInitStruct.ClockType = RCC_CLOCKTYPE_HCLK | RCC_CLOCKTYPE_SYSCLK | RCC_CLOCKTYPE_PCLK1;
    RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_HSI;
    RCC_ClkInitStruct.AHBCLKDivider = RCC_SYSCLK_DIV1;
    RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV1;
    if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_0) != HAL_OK) while(1);
}

/* ------- I2C initialization (if peripherals with I2C are present) ------- */
{% for p in peripherals if 'I2C' in p.model.interface %}
static void MX_I2C{{ p.bus[-1] }}_Init(void)
{
    hi2c{{ p.bus[-1] }}.Instance = {{ p.bus }};
{% if p.i2c and p.i2c.timing_r %}
    hi2c{{ p.bus[-1] }}.Init.Timing = {{ p.i2c.timing_r | i2c_timing_hex }};
{% else %}
    hi2c{{ p.bus[-1] }}.Init.Timing = 0x00000F13;  /* 100kHz @ 16MHz (default) */
{% endif %}
    hi2c{{ p.bus[-1] }}.Init.OwnAddress1 = 0;
    hi2c{{ p.bus[-1] }}.Init.AddressingMode = I2C_ADDRESSINGMODE_7BIT;
    hi2c{{ p.bus[-1] }}.Init.DualAddressMode = I2C_DUALADDRESS_DISABLE;
    hi2c{{ p.bus[-1] }}.Init.OwnAddress2 = 0;
    hi2c{{ p.bus[-1] }}.Init.GeneralCallMode = I2C_GENERALCALL_DISABLE;
    hi2c{{ p.bus[-1] }}.Init.NoStretchMode = I2C_NOSTRETCH_DISABLE;
    if (HAL_I2C_Init(&hi2c{{ p.bus[-1] }}) != HAL_OK) while(1);
}
{% endfor %}

/* ------- SPI initialization (if peripherals with SPI are present) ------- */
{% for p in peripherals if 'SPI' in p.model.interface %}
static void MX_SPI{{ p.bus[-1] }}_Init(void)
{
    hspi{{ p.bus[-1] }}.Instance = {{ p.bus }};
    hspi{{ p.bus[-1] }}.Init.Mode = SPI_MODE_MASTER;
    hspi{{ p.bus[-1] }}.Init.Direction = SPI_DIRECTION_2LINES;
    hspi{{ p.bus[-1] }}.Init.DataSize = SPI_DATASIZE_8BIT;
    hspi{{ p.bus[-1] }}.Init.CLKPolarity = SPI_POLARITY_LOW;
    hspi{{ p.bus[-1] }}.Init.CLKPhase = SPI_PHASE_1EDGE;
    hspi{{ p.bus[-1] }}.Init.NSS = SPI_NSS_SOFT;
{% if p.spi and p.spi.prescaler %}
    hspi{{ p.bus[-1] }}.Init.BaudRatePrescaler = {{ p.spi.prescaler | spi_prescaler_code }};
{% else %}
    hspi{{ p.bus[-1] }}.Init.BaudRatePrescaler = SPI_BAUDRATEPRESCALER_8;
{% endif %}
    hspi{{ p.bus[-1] }}.Init.FirstBit = SPI_FIRSTBIT_MSB;
    hspi{{ p.bus[-1] }}.Init.TIMode = SPI_TIMODE_DISABLE;
    hspi{{ p.bus[-1] }}.Init.CRCCalculation = SPI_CRCCALCULATION_DISABLE;
    if (HAL_SPI_Init(&hspi{{ p.bus[-1] }}) != HAL_OK) while(1);
}
{% endfor %}

/* ------- UART initialization (if UART peripherals are present) ------- */
{% for p in peripherals if p.type == 'UART_Serial' %}
static void MX_{{ p.instance }}_UART_Init(void)
{
    __HAL_RCC_{{ p.instance }}_CLK_ENABLE();
    huart_{{ p.name }}.Instance = {{ p.instance }};
    huart_{{ p.name }}.Init.BaudRate = {{ p.extra.baudrate | default(115200) }};
    huart_{{ p.name }}.Init.WordLength = UART_WORDLENGTH_8B;
    huart_{{ p.name }}.Init.StopBits = UART_STOPBITS_1;
    huart_{{ p.name }}.Init.Parity = UART_PARITY_NONE;
    huart_{{ p.name }}.Init.Mode = UART_MODE_TX_RX;
    huart_{{ p.name }}.Init.HwFlowCtl = UART_HWCONTROL_NONE;
    huart_{{ p.name }}.Init.OverSampling = UART_OVERSAMPLING_16;
    if (HAL_UART_Init(&huart_{{ p.name }}) != HAL_OK) while(1);
}
{% endfor %}

/* ------- Main ------- */
int main(void)
{
    HAL_Init();

    /* 使能调试模块在 STOP 模式下的时钟，保持 SWD 连接 */
    DBG->CR |= DBG_CR_DBG_STOP;

    SystemClock_Config();

    /* 系统时钟配置完成后，重新初始化 HAL 时基（TIM14），
       确保 HAL_GetTick() 使用正确的时钟频率。
       RTC_WakeUp_Config 内部调用 HAL_RTCEx_SetWakeUpTimer_IT 会用到 HAL_GetTick */
{% if has_log %}
    /* Clear all NVIC interrupt enables to prevent stale IRQs from
     * previous runs (NVIC ISER persists across system reset).
     * Must be done BEFORE HAL_InitTick() so TIM14 NVIC gets re-enabled. */
    for (int irq = 0; irq < 8; irq++) {
        NVIC->ICER[irq] = 0xFFFFFFFF;
    }
{% endif %}
    HAL_InitTick(TICK_INT_PRIORITY);

{% if has_log %}
    /* Enable global interrupts early so HAL_Delay (TIM14 tick ISR)
       and USART2 TXE ISR (log ring-buffer drain) can fire. */
    __enable_irq();

{% if has_led %}
    /* Quick LED heartbeat to confirm main() entry */
    __HAL_RCC_GPIOC_CLK_ENABLE();
    {
        GPIO_InitTypeDef led_cfg = {0};
        led_cfg.Pin = LED_GPIO_Pin;
        led_cfg.Mode = GPIO_MODE_OUTPUT_PP;
        led_cfg.Pull = GPIO_NOPULL;
        led_cfg.Speed = GPIO_SPEED_FREQ_LOW;
        HAL_GPIO_Init(LED_GPIO_Port, &led_cfg);
        /* 3 quick blinks: main() alive before log_init */
        for (int i = 0; i < 3; i++) {
            HAL_GPIO_WritePin(LED_GPIO_Port, LED_GPIO_Pin, GPIO_PIN_RESET);
            HAL_Delay(50);
            HAL_GPIO_WritePin(LED_GPIO_Port, LED_GPIO_Pin, GPIO_PIN_SET);
            HAL_Delay(50);
        }
    }
{% endif %}
    /* Initialize logging subsystem — USART2 @ 115200, ring buffer, TXE IRQ */
    log_init();
    log_flush();  /* Ensure banner is fully transmitted before proceeding */
    log_info("App main() entry, initialization starting...");
    log_flush();  /* Drain ring buffer completely */
    HAL_Delay(500);  /* Let UART finish all pending transmissions */
{% endif %}

    /* Initialize all configured peripherals */
    MX_GPIO_Init();
{% if has_log %}
    log_info("MX_GPIO_Init() OK");
{% endif %}

{% if has_bootloader %}
    /*
     * App alive heartbeat: 2 quick blinks (100ms on/off each) to confirm App startup.
     * Distinct from Bootloader's 3 slow blinks (200ms). If you see 2 quick blinks after
     * the Bootloader's pattern, the App has started successfully.
     */
    HAL_GPIO_WritePin(LED_GPIO_Port, LED_GPIO_Pin, GPIO_PIN_RESET); /* LED on */
    HAL_Delay(100);
    HAL_GPIO_WritePin(LED_GPIO_Port, LED_GPIO_Pin, GPIO_PIN_SET);   /* LED off */
    HAL_Delay(100);
    HAL_GPIO_WritePin(LED_GPIO_Port, LED_GPIO_Pin, GPIO_PIN_RESET); /* LED on */
    HAL_Delay(100);
    HAL_GPIO_WritePin(LED_GPIO_Port, LED_GPIO_Pin, GPIO_PIN_SET);   /* LED off */
    HAL_Delay(100);
{% endif %}

    /* Initialize the event manager */
    EventMgr_Init();
{% if has_log %}
    log_info("EventMgr_Init() OK");
{% endif %}

{% if has_behavior %}
    statemachine_init();
{% if has_log %}
    log_info("statemachine_init() OK");
{% endif %}
{% endif %}
    
    /* Initialize I2C and internal peripherals */
{% for p in peripherals %}
{% if 'I2C' in p.model.interface %}
    MX_I2C{{ p.bus[-1] }}_Init();
{{ p.name }}_init(&hi2c{{ p.bus[-1] }});
{% elif 'SPI' in p.model.interface %}
    MX_SPI{{ p.bus[-1] }}_Init();
{% if p.type in ('SPI_Flash_W25Q32', 'SPI_Flash_Generic') %}
    spi_flash_init(&hspi{{ p.bus[-1] }});
{% else %}
{{ p.name }}_init(&hspi{{ p.bus[-1] }});
{% endif %}
{% elif p.type == 'Internal_RTC' %}
    RTC_Init();
{% elif p.type == 'UART_Serial' %}
{% if not (has_log and p.instance == 'USART2') %}
    MX_{{ p.instance }}_UART_Init();
{% else %}
    /* USART2 already initialized by log system (drv_log.c),
     * skip duplicate HAL_UART_Init to avoid clearing TXEIE. */
{% endif %}
{% endif %}
{% endfor %}

{% if has_cli %}
    cli_init(&huart_{{ cli_uart_name }});
{% endif %}

{% if has_rtc %}
    RTC_Start();
{% endif %}
{% if has_log %}
    log_info("RTC_Init() OK");
{% endif %}

    /* Create application tasks (user-defined) */
{% for task in app_tasks %}
{% if not (has_fota and task.name == 'fota_task') %}
    xTaskCreate( {{ task.name }}, "{{ task.name }}", {{ task.stack_size | default(128) }}, NULL, {{ task.priority }}, &{{ task.name }}_handle );
{% endif %}
{% endfor %}

{% if has_cli %}
    xTaskCreate(cli_task, "cli", {{ cli_stack_size|default(512) }}, NULL, {{ cli_priority|default(4) }}, NULL);
{% endif %}

{% if has_log %}
    log_info("App tasks created");
{% endif %}



    /* Create the central event manager task (highest priority) */
    xTaskCreate(EventMgr_Task, "event_mgr", 512, NULL, configMAX_PRIORITIES - 1, NULL);
{% if has_log %}
    log_info("EventMgr task created");
{% endif %}

{% if has_fota %}
    /* Initialize FOTA subsystem (protocol state machine + bspatch engine) */
    fota_init();
    xTaskCreate(fota_task, "fota", 512, NULL, 1, NULL);
{% if has_log %}
    log_info("FOTA task created");
{% endif %}
{% endif %}

{% if has_bootloader %}
    /* 初始化 IWDG 看门狗 — App 挂死后硬件复位，Bootloader 检测 boot_ok 缺失 */
    IWDG_Init();
{% if has_log %}
    log_info("IWDG initialized (timeout %lu ms)", {{ boot_config.wdg_timeout_ms | default(5000) }}UL);

    /* Flush all pending logs before touching sensitive TAMP registers */
    log_flush();
{% endif %}

    /* 标记启动成功 — Bootloader 在下次上电时检测此标志 */
    boot_app_mark_ok();
{% endif %}

{% if sleep %}
    /* Enable DBGMCU clock and keep debug interface active during STOP mode */
    __HAL_RCC_DBGMCU_CLK_ENABLE();
    HAL_DBGMCU_EnableDBGStopMode();
{% endif %}

    vTaskStartScheduler();
    while(1);
}

/* ------- Task implementations ------- */
{% for task in app_tasks %}
{% if not (has_fota and task.name == 'fota_task') %}
void {{ task.name }}(void *pvParameters)
{
    {% if task.name == 'led_task' %}
    while(1) {
        ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
        HAL_GPIO_TogglePin( LED_GPIO_Port, LED_GPIO_Pin );
    }
    {% elif task.name == 'mpu6050_alert_task' %}
    {{ peripherals[0].name }}_data_t sensor_data;
    while(1) {
        {{ peripherals[0].name }}_read(&sensor_data);
        if (sensor_data.accel_x > 1.0f || sensor_data.accel_x < -1.0f) {
            event_t evt = { .id = EVENT_MPU6050_ALERT, .param = 0 };
            xQueueSend(event_queue, &evt, 0);
        }
        vTaskDelay(pdMS_TO_TICKS({{ peripherals[0].extra.update_interval_ms | default(1000) }}));
    }
    {% elif task.name == 'rtc_demo_task' %}
    /*
     * RTC tick events are generated by HAL_RTCEx_WakeUpTimerEventCallback (ISR).
     * RTC_ProcessTimers() is called by EventMgr_Task when processing each EVENT_RTC_TICK.
     * rtc_demo_task only handles periodic IWDG refresh — do NOT duplicate tick/processing here.
     */
    while(1) {
{% if has_bootloader %}
        IWDG_Refresh();      /* Feed watchdog — prevent App deadlock from triggering reset */
{% endif %}
        vTaskDelay(pdMS_TO_TICKS(100));
    }
    {% else %}
    while(1) {
        vTaskDelay(1000);
    }
    {% endif %}
}
{% endif %}
{% endfor %}

{% if has_led_task and not test_mode %}
void led_task_notify(void) {
    if (led_task_handle) {
        xTaskNotifyGive(led_task_handle);
    }
}
{% endif %}

{% if has_fota and not test_mode %}
/*
 * FOTA task: polls the protocol state machine.
 * When a FOTA START command is received via UART interrupt,
 * the state machine transitions IDLE → RECEIVING and processes
 * incoming chunks automatically.
 */
void fota_task(void *arg) {
    (void)arg;
    for (;;) {
        fota_process();
        vTaskDelay(pdMS_TO_TICKS(10));
    }
}
{% endif %}