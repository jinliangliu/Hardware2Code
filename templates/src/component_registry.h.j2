/* ---- Component state ---- */
typedef enum {
    COMPONENT_STOPPED  = 0,
    COMPONENT_INIT     = 1,
    COMPONENT_RUNNING  = 2,
    COMPONENT_ERROR    = 3,
} component_state_t;

/* ---- Component descriptor ---- */
typedef struct component component_t;

typedef int  (*comp_init_fn)(component_t *c, void *cfg);
typedef void (*comp_step_fn)(component_t *c);
typedef void (*comp_term_fn)(component_t *c);

struct component {
    const char     *name;
    const char     *type;
    component_state_t state;
    comp_init_fn    init;
    comp_step_fn    step;
    comp_term_fn    terminate;
    void           *ctx;           /* component-private context */
    void           *cfg;           /* init-time config */
    const char     *sleep_compat;  /* max sleep depth tolerated (e.g., "STOP2"), NULL=run only */
    uint32_t        period_ms;     /* 0 = event-driven */
    uint32_t        last_tick;     /* last step() call time */
    uint32_t        error_count;   /* cumulative error counter */
    uint32_t        heartbeat;     /* cumulative step() success count */
};

/* ---- Registry API ---- */

/**
 * @brief  Look up a component by name
 * @return Pointer to component descriptor, or NULL if not found
 */
