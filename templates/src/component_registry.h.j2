 *   - {name}_terminate(ctx)   — cleanup
 *
 * The registry provides:
 *   - component_get(name)     — lookup by name
 *   - component_init_all()    — init in dependency order
 *   - component_step_all()    — call each component's step()
 *
 * Auto-generated — do not edit manually.
 */

#ifndef __COMPONENT_REGISTRY_H
#define __COMPONENT_REGISTRY_H

#include <stdint.h>
#include <stdbool.h>

#ifdef __cplusplus
