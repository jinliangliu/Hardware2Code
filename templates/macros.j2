{#
    macros.j2 - DEPRECATED. All logic moved to generator/jinja_filters.py
    The following custom Jinja2 filters replace the old macros:
      - pin_port(pin_id)           → pin_id | pin_port
      - pin_number(pin_id)         → pin_id | pin_number
      - pin_num_int(pin_id)        → pin_id | pin_num_int
      - hal_pin(pin_id)            → pin_id | hal_pin   (returns GPIO_PIN_N)
      - hal_port(pin_id)           → pin_id | hal_port   (returns GPIOA, GPIOB, ...)
      - exti_irq_name(pin_id)      → pin_id | exti_irq_name
      - exti_handler_name(pin_id)  → pin_id | exti_handler_name
      - event_name(name)           → name | event_name   (replaces spaces with _)
      - event_enum(name)           → name | event_enum   (full EVENT_ prefix)
#}
