{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B", "build",
                "-DCMAKE_TOOLCHAIN_FILE=toolchain.cmake",
                "-G", "Ninja"
            ],
            "group": "none",
            "problemMatcher": [],
            "detail": "Configure project with CMake"
        },
        {
            "label": "build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "detail": "Build project using CMake"
        },
        {
            "label": "rebuild",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build", "--clean-first"
            ],
            "group": "none",
            "problemMatcher": "$gcc",
            "detail": "Clean and rebuild"
        },
        {
            "label": "flash",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build", "--target", "flash"
            ],
            "group": "none",
            "problemMatcher": [],
            "detail": "Flash via ST-Link (STM32_Programmer_CLI)"
        },
        {
            "label": "flash-daplink",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build", "--target", "flash-daplink"
            ],
            "group": "none",
            "problemMatcher": [],
            "detail": "Flash via DAP-Link (OpenOCD)"
        }
    ]
}
