led_component.c.j2 - LED component implementation (multi-instance)

Discovers all pins with label matching "LED" from hardware YAML.
Auto-generated — do not edit manually.
#}
/**
 * @file  led_component.c
 * @brief LED component — multi-instance LED pattern driver (generated by hw2c)
 *
 * Each LED-labeled pin in hardware.yaml becomes an instance.
 * The component's step() is called at period_ms (e.g. 50ms),
 * driving all LEDs simultaneously.
 */

#include "component_registry.h"
#include "led_component.h"

#ifdef TEST
#include "mock_hal.h"
#else
#include "stm32g0xx_hal.h"
#endif
#include <stddef.h>
#include <string.h>

/* ---- LED instance descriptor ---- */
typedef struct {
    const char  *name;          /* pin label from hardware.yaml */
    GPIO_TypeDef *port;
    uint16_t     pin;
    uint32_t     pattern;       /* current pattern (0-3) */
    uint32_t     tick;          /* internal 50ms tick counter */
    uint8_t      active_low;    /* 1 = active low, 0 = active high */
} led_instance_t;

/* ---- Auto-generated instance array ---- */
static led_instance_t g_led_instances[LED_INSTANCE_COUNT] = {
{% for lp in led_pins %}
    {
        .name        = "{{ lp.label }}",
        .port        = GPIO{{ lp.id | pin_port }},
        .pin         = GPIO_PIN_{{ lp.id | pin_number }},
        .pattern     = 0,
        .tick        = 0,
        .active_low  = {{ 1 if lp.get('active_level', 'high').lower() == 'low' else 0 }},
    }{% if not loop.last %},{% endif %}
{% endfor %}
};

/* ---- Component-private context ---- */
struct led_ctx {
    int initialized;
};

static struct led_ctx g_led_ctx;

/* ==================== Public API ==================== */

/**
 * @brief  Set LED pattern by instance index
 */
void led_set_pattern_by_index(uint32_t index, uint32_t pattern)
{
    if (index < LED_INSTANCE_COUNT && pattern <= LED_PATTERN_FAULT) {
        if (g_led_instances[index].pattern != pattern) {
            g_led_instances[index].pattern = pattern;
            g_led_instances[index].tick = 0;
        }
    }
}

/**
 * @brief  Set LED pattern by pin label name
 */
void led_set_pattern_by_name(const char *name, uint32_t pattern)
{
    for (uint32_t i = 0; i < LED_INSTANCE_COUNT; i++) {
        if (strcmp(g_led_instances[i].name, name) == 0) {
            led_set_pattern_by_index(i, pattern);
            return;
        }
    }
}

/**
 * @brief  Toggle LED once (for legacy toggle_led action)
 */
void led_toggle(uint32_t index)
{
    if (index < LED_INSTANCE_COUNT) {
        HAL_GPIO_TogglePin(g_led_instances[index].port,
                           g_led_instances[index].pin);
    }
}

/* ==================== Component Lifecycle ==================== */

/**
 * @brief  Initialize all LED instances — configure GPIOs
 */
int led_init(component_t *c, void *cfg)
{
    (void)cfg;

    __HAL_RCC_GPIOC_CLK_ENABLE();
{% for port_char in led_pins | map(attribute='id') | map('pin_port') | unique | list %}
    __HAL_RCC_GPIO{{ port_char }}_CLK_ENABLE();
{% endfor %}

    for (uint32_t i = 0; i < LED_INSTANCE_COUNT; i++) {
        GPIO_InitTypeDef gpio_cfg = {0};
        gpio_cfg.Pin   = g_led_instances[i].pin;
        gpio_cfg.Mode  = GPIO_MODE_OUTPUT_PP;
        gpio_cfg.Pull  = GPIO_NOPULL;
        gpio_cfg.Speed = GPIO_SPEED_FREQ_LOW;
        HAL_GPIO_Init(g_led_instances[i].port, &gpio_cfg);

        /* Set initial state: off */
        GPIO_PinState off_state = g_led_instances[i].active_low
                                  ? GPIO_PIN_SET : GPIO_PIN_RESET;
        HAL_GPIO_WritePin(g_led_instances[i].port, g_led_instances[i].pin, off_state);
    }

    g_led_ctx.initialized = 1;
    c->ctx = &g_led_ctx;
    return 0;
}

/**
 * @brief  Periodic step — drive all LED patterns at 50ms granularity
 */
void led_step(component_t *c)
{
    struct led_ctx *ctx = (struct led_ctx *)c->ctx;
    if (ctx == NULL || !ctx->initialized) return;

    for (uint32_t i = 0; i < LED_INSTANCE_COUNT; i++) {
        led_instance_t *led = &g_led_instances[i];
        GPIO_PinState state;

        /* Determine off-state polarity */
        GPIO_PinState off_state = led->active_low ? GPIO_PIN_SET : GPIO_PIN_RESET;
        GPIO_PinState on_state  = led->active_low ? GPIO_PIN_RESET : GPIO_PIN_SET;

        state = off_state;

        switch (led->pattern) {
        case LED_PATTERN_OFF:
            break;  /* stays off */
        case LED_PATTERN_FAST_BLINK:
            if ((led->tick & 1u) == 0u) state = on_state;
            break;
        case LED_PATTERN_SLOW_BLINK:
            if ((led->tick % 10u) < 5u) state = on_state;
            break;
        case LED_PATTERN_FAULT: {
            uint32_t phase = led->tick % 32u;
            if (phase < 2u || (phase >= 4u && phase < 6u) || (phase >= 8u && phase < 10u))
                state = on_state;
            else if (phase >= 12u && phase < 22u)
                state = on_state;
            break;
        }
        }

        HAL_GPIO_WritePin(led->port, led->pin, state);
        led->tick++;
    }
}

/**
 * @brief  Terminate — turn off all LEDs
 */
void led_terminate(component_t *c)
{
    struct led_ctx *ctx = (struct led_ctx *)c->ctx;
    if (ctx == NULL) return;

    for (uint32_t i = 0; i < LED_INSTANCE_COUNT; i++) {
        GPIO_PinState off_state = g_led_instances[i].active_low
                                  ? GPIO_PIN_SET : GPIO_PIN_RESET;
        HAL_GPIO_WritePin(g_led_instances[i].port, g_led_instances[i].pin, off_state);
        g_led_instances[i].pattern = LED_PATTERN_OFF;
    }

    ctx->initialized = 0;
}
