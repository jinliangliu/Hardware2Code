/**
 * @file  btn_component.c
 * @brief Button component — multi-instance gesture detector (generated by hw2c)
 *
 * Each BUTTON-labeled pin with EXTI enable in hardware.yaml becomes an instance.
 * Raw BUTTON_PRESS/RELEASE events arrive via a shared btn_queue (filled by ISR).
 * The component's step() drains the queue and advances per-instance state machines.
 */

#include "component_registry.h"
#include "btn_component.h"
#include "event_mgr.h"

#ifdef TEST
#include "mock_hal.h"
#else
#include "stm32g0xx_hal.h"

#include "FreeRTOS.h"
#include "task.h"
#include "queue.h"
#endif

{% if has_params %}
#include "param_registry.h"
{% endif %}

#include <stddef.h>
#include <stdio.h>
#include <string.h>

/* ---- Button state machine states ---- */
typedef enum {
    BTN_STATE_IDLE,
    BTN_STATE_PRESSED,
    BTN_STATE_WAIT_DOUBLE
} btn_state_t;

/* ---- Button instance descriptor ---- */
typedef struct {
    const char  *name;           /* pin label from hardware.yaml */
    uint16_t     pin_mask;       /* GPIO pin mask for identification */
    btn_state_t  state;          /* current state machine state */
    uint32_t     press_tick;     /* tick when press started */
    uint32_t     release_tick;   /* tick when release occurred */
    uint32_t     long_press_ms;  /* long press threshold */
    uint32_t     double_click_ms;/* double-click window */
} btn_instance_t;

/* ---- Shared button queue (filled by EXTI ISR) ---- */
extern QueueHandle_t btn_queue;

/* ---- Auto-generated instance array ---- */
static btn_instance_t g_btn_instances[BTN_INSTANCE_COUNT] = {
{% for bp in btn_pins %}
    {
        .name            = "{{ bp.label }}",
        .pin_mask        = GPIO_PIN_{{ bp.id | pin_number }},
        .state           = BTN_STATE_IDLE,
        .press_tick      = 0,
        .release_tick    = 0,
        .long_press_ms   = 1000,
        .double_click_ms = 500,
    }{% if not loop.last %},{% endif %}
{% endfor %}
};

/* ---- Component-private context ---- */
struct btn_ctx {
    int initialized;
};

static struct btn_ctx g_btn_ctx;

/* ---- Helper: find instance by pin mask ---- */
static btn_instance_t *btn_find_by_pin(uint16_t pin_mask)
{
    for (uint32_t i = 0; i < BTN_INSTANCE_COUNT; i++) {
        if (g_btn_instances[i].pin_mask == pin_mask) {
            return &g_btn_instances[i];
        }
    }
    return NULL;
}

/* ---- Helper: convert pin mask to instance index ---- */
static uint32_t btn_index_by_pin(uint16_t pin_mask)
{
    for (uint32_t i = 0; i < BTN_INSTANCE_COUNT; i++) {
        if (g_btn_instances[i].pin_mask == pin_mask) {
            return i;
        }
    }
    return 0;
}

/* ==================== Component Lifecycle ==================== */

/**
 * @brief  Initialize button component — read params, configure ISR routing
 */
int btn_init(component_t *c, void *cfg)
{
    (void)cfg;

{% if has_params %}
    /* Load per-instance timing params from registry */
    for (uint32_t i = 0; i < BTN_INSTANCE_COUNT; i++) {
        param_t *p;
        char key[32];

        /* btn_<name>_long_press_ms */
        snprintf(key, sizeof(key), "btn_%s_long_press_ms", g_btn_instances[i].name);
        p = param_get(key);
        if (p) param_get_uint32(p, &g_btn_instances[i].long_press_ms);

        /* btn_<name>_double_click_ms */
        snprintf(key, sizeof(key), "btn_%s_double_click_ms", g_btn_instances[i].name);
        p = param_get(key);
        if (p) param_get_uint32(p, &g_btn_instances[i].double_click_ms);
    }
{% endif %}

    g_btn_ctx.initialized = 1;
    c->ctx = &g_btn_ctx;
    return 0;
}

/**
 * @brief  Periodic step — drain btn_queue, advance per-instance state machines
 *
 * Uses non-blocking queue reads (0 timeout) so step() never stalls.
 */
void btn_step(component_t *c)
{
    struct btn_ctx *ctx = (struct btn_ctx *)c->ctx;
    if (ctx == NULL || !ctx->initialized) return;

    /* Drain all pending raw button events from the queue */
    event_t raw;
    while (xQueueReceive(btn_queue, &raw, 0) == pdTRUE) {
        btn_instance_t *btn = btn_find_by_pin((uint16_t)raw.param);
        if (btn == NULL) continue;

        uint32_t now = xTaskGetTickCount();

        if (raw.id == EVENT_BUTTON_PRESS) {
            switch (btn->state) {
            case BTN_STATE_IDLE:
                btn->press_tick = now;
                btn->state = BTN_STATE_PRESSED;
                break;

            case BTN_STATE_WAIT_DOUBLE:
                if ((now - btn->release_tick) < pdMS_TO_TICKS(btn->double_click_ms)) {
                    event_t evt = {
                        .id    = EVENT_BUTTON_DOUBLE_PRESS,
                        .param = btn_index_by_pin(btn->pin_mask)
                    };
                    xQueueSend(event_queue, &evt, 0);
                    btn->state = BTN_STATE_IDLE;
                } else {
                    btn->press_tick = now;
                    btn->state = BTN_STATE_PRESSED;
                }
                break;

            case BTN_STATE_PRESSED:
                break;  /* bounce */
            }

        } else if (raw.id == EVENT_BUTTON_RELEASE) {
            if (btn->state == BTN_STATE_PRESSED) {
                btn->release_tick = now;
                uint32_t hold = now - btn->press_tick;

                if (hold >= pdMS_TO_TICKS(btn->long_press_ms)) {
                    event_t evt = {
                        .id    = EVENT_BUTTON_LONG_PRESS,
                        .param = btn_index_by_pin(btn->pin_mask)
                    };
                    xQueueSend(event_queue, &evt, 0);
                    btn->state = BTN_STATE_IDLE;
                } else {
                    btn->state = BTN_STATE_WAIT_DOUBLE;
                }
            }
            /* Release in IDLE/WAIT_DOUBLE: bounce, ignore */
        }
    }

    /*
     * Check double-click timeouts: if any instance in WAIT_DOUBLE
     * has exceeded its double_click_ms window, emit SHORT_PRESS.
     */
    uint32_t now = xTaskGetTickCount();
    for (uint32_t i = 0; i < BTN_INSTANCE_COUNT; i++) {
        btn_instance_t *btn = &g_btn_instances[i];
        if (btn->state == BTN_STATE_WAIT_DOUBLE) {
            if ((now - btn->release_tick) >= pdMS_TO_TICKS(btn->double_click_ms)) {
                event_t evt = {
                    .id    = EVENT_BUTTON_SHORT_PRESS,
                    .param = i
                };
                xQueueSend(event_queue, &evt, 0);
                btn->state = BTN_STATE_IDLE;
            }
        }
    }
}

/**
 * @brief  Terminate — nothing to clean up (GPIO managed by EXTI)
 */
void btn_terminate(component_t *c)
{
    struct btn_ctx *ctx = (struct btn_ctx *)c->ctx;
    if (ctx == NULL) return;
    ctx->initialized = 0;
}
