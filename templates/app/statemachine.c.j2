#ifdef TEST
#include "mock_hal.h"
{% if has_rtc %}
#include "drv_rtc.h"
{% endif %}
#else
#include "FreeRTOS.h"
#include "task.h"
{% if has_rtc %}
#include "drv_rtc.h"
{% endif %}
#endif

#include "statemachine.h"



/* ========== 全局变量 ========== */
{% for var in business_flow.get('variables', []) %}
static {{ var.type }} {{ var.name }} = {{ var.initial }};
{% endfor %}

/* ========== 区域级变量 ========== */
{% if business_flow.regions %}
{% for region in business_flow.regions %}
{% for var in region.get('variables', []) %}
static {{ var.type }} {{ region.name }}_{{ var.name }} = {{ var.initial }};
{% endfor %}
{% endfor %}
{% endif %}

/* ========== 状态枚举 ========== */
{% if business_flow.regions %}
{% for region in business_flow.regions %}
{% for state in region.states %}
#define STATE_{{ region.name }}_{{ state.name }} {{ loop.index0 }}
{% if state.states %}
{% for nested in state.states %}
#define STATE_{{ region.name }}_{{ state.name }}_{{ nested.name }} {{ loop.index0 }}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
{% else %}
{% for state in business_flow.states %}
#define STATE_{{ state.name }} {{ loop.index0 }}
{% if state.states %}
{% for nested in state.states %}
#define STATE_{{ state.name }}_{{ nested.name }} {{ loop.index0 }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

/* ========== 当前状态变量 ========== */
{% if business_flow.regions %}
{% for region in business_flow.regions %}
static uint32_t current_state_{{ region.name }};
{% for state in region.states %}
{% if state.states %}
static uint32_t current_state_{{ region.name }}_{{ state.name }};
{% endif %}
{% endfor %}
{% endfor %}
{% else %}
static uint32_t current_state;
{% for state in business_flow.states %}
{% if state.states %}
static uint32_t current_state_{{ state.name }};
{% endif %}
{% endfor %}
{% endif %}

/* ========== 历史状态变量 ========== */
{% if business_flow.regions %}
{% for region in business_flow.regions %}
{% for state in region.states %}
{% if state.states and state.history %}
static uint32_t current_state_{{ region.name }}_{{ state.name }}_history = STATE_{{ region.name }}_{{ state.name }}_{{ state.initial_state or state.states[0].name }};
{% endif %}
{% endfor %}
{% endfor %}
{% else %}
{% for state in business_flow.states %}
{% if state.states and state.history %}
static uint32_t current_state_{{ state.name }}_history = STATE_{{ state.name }}_{{ state.initial_state or state.states[0].name }};
{% endif %}
{% endfor %}
{% endif %}

/* ========== 动作实现宏 ========== */
{% macro action_impl(action, region_name='') -%}
{% if action == 'toggle_led' %}
extern void led_task_notify(void);
led_task_notify();
{% elif 'start_timer' in action %}
{
    uint32_t period = {{ action.split(' ')[2] }};
    {% set timer_name = action.split(' ')[1] %}
    if ({{ timer_name }}_handle) {
        RTC_TimerDelete({{ timer_name }}_handle);
        {{ timer_name }}_handle = NULL;
    }
    rtc_timer_handle_t h = RTC_TimerCreate(period, RTC_TIMER_MODE_ONE_SHOT,
                                           {{ timer_name }}_cb, NULL);
    {{ timer_name }}_handle = h;
    RTC_TimerStart(h);
}
{% elif 'stop_timer' in action %}
{
    {% set timer_name = action.split(' ')[1] %}
    if ({{ timer_name }}_handle) {
        RTC_TimerStop({{ timer_name }}_handle);
        RTC_TimerDelete({{ timer_name }}_handle);
        {{ timer_name }}_handle = NULL;
    }
}
{% elif action.startswith('set ') %}
{
{% set parts = action.split(' ') %}
{% if parts[2] == 'inc' %}
    {{ region_name }}{{ parts[1] }}++;
{% elif parts[2] == 'dec' %}
    {{ region_name }}{{ parts[1] }}--;
{% else %}
    {{ region_name }}{{ parts[1] }} = {{ parts[2] }};
{% endif %}
}
{% elif action.startswith('calc ') %}
{
    {{ action.split(' ',1)[1] }};
}
{% elif action.startswith('publish_async ') %}
{
    event_t evt_pub = { .id = EVENT_{{ action.split(' ',1)[1] | replace(' ', '_') }}, .param = 0 };
    xQueueSend(event_queue, &evt_pub, 0);
}
{% elif action.startswith('publish ') %}
{
    event_t evt_pub = { .id = EVENT_{{ action.split(' ',1)[1] | replace(' ', '_') }}, .param = 0 };
    statemachine_process(&evt_pub);
}
{% elif action.startswith('when ') %}
{
    {% set parts = action.split('=>', 1) %}
    {% if parts|length == 2 %}
    if ({{ parts[0].replace('when ', '') }}) {
        {{ action_impl(parts[1].strip(), region_name) }}
    }
    {% endif %}
}
{% elif action.startswith('send_to ') %}
{
    {% set parts = action.split(' ', 2) %}
    event_t evt_pub = { .id = EVENT_{{ parts[2] | replace(' ', '_') }}, .param = 0 };
    xQueueSend(event_queue, &evt_pub, 0);
}
{% elif action == 'return' %}
{
    event_t evt_pub = { .id = EVENT_RETURN, .param = 0 };
    statemachine_process(&evt_pub);
}
{% endif %}
{%- endmacro %}

/* ========== 动作列表处理宏 ========== */
{% macro process_actions(actions) %}
{% for action in actions %}
{{ action_impl(action, '') }}
{%- endfor %}
{% endmacro %}

{% macro process_actions_for_region(region_name, actions) %}
{% for action in actions %}
{{ action_impl(action, region_name + '_') }}
{%- endfor %}
{% endmacro %}

/* ========== 定时器收集宏（排除 defer 生成的定时器） ========== */
{% set all_actions = [] %}
{% macro collect_timers(states, region_name='') %}
{% for state in states %}
    {% for trans in state.transitions %}
        {% for action in trans.actions %}
            {% if 'start_timer' in action and not action.split(' ')[1].startswith('defer_') %}
                {% set _ = all_actions.append(action) %}
            {% endif %}
        {% endfor %}
    {% endfor %}
    {% for action in state.get('on_entry', []) %}
        {% if 'start_timer' in action and not action.split(' ')[1].startswith('defer_') %}
            {% set _ = all_actions.append(action) %}
        {% endif %}
    {% endfor %}
    {% for action in state.get('on_exit', []) %}
        {% if 'start_timer' in action and not action.split(' ')[1].startswith('defer_') %}
            {% set _ = all_actions.append(action) %}
        {% endif %}
    {% endfor %}
    {% if state.after %}
        {% set timer_name = region_name + state.name + '_timeout' %}
        {% set _ = all_actions.append('start_timer ' + timer_name + ' ' + state.after|string) %}
    {% endif %}
    {% if state.states %}
        {{ collect_timers(state.states, region_name) }}
    {% endif %}
{% endfor %}
{% endmacro %}

{% if business_flow.regions %}
{% for region in business_flow.regions %}
{{ collect_timers(region.states, region.name + '_') }}
{% endfor %}
{% else %}
{{ collect_timers(business_flow.states) }}
{% endif %}

/* ========== 用户定时器 + 状态超时定时器的句柄与回调 ========== */
{% for action in all_actions %}
static rtc_timer_handle_t {{ action.split(' ')[1] }}_handle = NULL;
static void {{ action.split(' ')[1] }}_cb(void *arg) {
    event_t evt = { .id = EVENT_TIMER_EXPIRED_{{ action.split(' ')[1] }}, .param = 0 };
    statemachine_process(&evt);
}
{% endfor %}

/* ========== 延迟动作定时器回调 ========== */
{% for d in defer_actions %}
static rtc_timer_handle_t {{ d.timer_name }}_handle = NULL;
static void {{ d.timer_name }}_cb(void *arg) {
{{ action_impl(d.sub_action, '') | indent(4, true) }}
}
{% endfor %}

/* ========== 初始化 ========== */
void statemachine_init(void) {
{% if business_flow.regions %}
{% for region in business_flow.regions %}
    current_state_{{ region.name }} = STATE_{{ region.name }}_{{ region.initial_state }};
{% for state in region.states %}
{% if state.states %}
{% if state.history %}
    current_state_{{ region.name }}_{{ state.name }} = current_state_{{ region.name }}_{{ state.name }}_history;
{% else %}
    current_state_{{ region.name }}_{{ state.name }} = STATE_{{ region.name }}_{{ state.name }}_{{ state.initial_state or state.states[0].name }};
{% endif %}
{% endif %}
{% endfor %}
{% for var in region.get('variables', []) %}
    {{ region.name }}_{{ var.name }} = {{ var.initial }};
{% endfor %}
    /* 执行初始状态的进入动作并启动时间序列 */
{% for state in region.states %}
{% if state.name == region.initial_state %}
{% if state.on_entry %}
{{ process_actions_for_region(region.name, state.on_entry) | indent(4, true) }}
{% endif %}
{% if state.after %}
    {
        uint32_t period = {{ state.after }};
        rtc_timer_handle_t h = RTC_TimerCreate(period, RTC_TIMER_MODE_ONE_SHOT,
                                               {{ region.name }}_{{ state.name }}_timeout_cb, NULL);
        {{ region.name }}_{{ state.name }}_timeout_handle = h;
        RTC_TimerStart(h);
    }
{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
{% else %}
    current_state = STATE_{{ business_flow.initial_state }};
{% for state in business_flow.states %}
{% if state.states %}
{% if state.history %}
    current_state_{{ state.name }} = current_state_{{ state.name }}_history;
{% else %}
    current_state_{{ state.name }} = STATE_{{ state.name }}_{{ state.initial_state or state.states[0].name }};
{% endif %}
{% endif %}
{% endfor %}
{% for var in business_flow.get('variables', []) %}
    {{ var.name }} = {{ var.initial }};
{% endfor %}
    /* 执行初始状态的进入动作并启动时间序列 */
{% for state in business_flow.states %}
{% if state.name == business_flow.initial_state %}
{% if state.on_entry %}
{{ process_actions(state.on_entry) | indent(4, true) }}
{% endif %}
{% if state.after %}
    {
        uint32_t period = {{ state.after }};
        rtc_timer_handle_t h = RTC_TimerCreate(period, RTC_TIMER_MODE_ONE_SHOT,
                                               {{ state.name }}_timeout_cb, NULL);
        {{ state.name }}_timeout_handle = h;
        RTC_TimerStart(h);
    }
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
}

/* ========== 事件处理 ========== */
void statemachine_process(event_t *evt) {
{% if business_flow.regions %}
    /* 并行区域：每个区域独立处理事件 */
{% for region in business_flow.regions %}
    {
        uint32_t *p_curr = &current_state_{{ region.name }};
        switch (*p_curr) {
{% for state in region.states %}
        case STATE_{{ region.name }}_{{ state.name }}:
{% if state.states %}
            /* 嵌套子状态优先 */
            {
                int handled = 0;
                uint32_t *p_nested = &current_state_{{ region.name }}_{{ state.name }};
                switch (*p_nested) {
{% for nested in state.states %}
                case STATE_{{ region.name }}_{{ state.name }}_{{ nested.name }}:
{% for trans in nested.transitions %}
                    if (evt->id == EVENT_{{ trans.event | replace(' ', '_') }}) {
{{ process_actions_for_region(region.name, trans.actions) | indent(24, true) }}
{% if trans.target %}
                        *p_nested = STATE_{{ region.name }}_{{ state.name }}_{{ trans.target }};
{% endif %}
                        handled = 1;
                        break;
                    }
{% endfor %}
                    break;
{% endfor %}
                }
                if (handled) break;
            }
{% endif %}
            /* 父状态转换 */
{% for trans in state.transitions %}
{% if loop.first %}
            if (
{% else %}
            else if (
{% endif %}
{% if trans.guard %}
                ({{ trans.guard }}) &&
{% endif %}
                (evt->id == EVENT_{{ trans.event | replace(' ', '_') }})
            ) {
{% if state.on_exit %}
{{ process_actions_for_region(region.name, state.on_exit) | indent(16, true) }}
{% endif %}
{% if state.states and state.history %}
                current_state_{{ region.name }}_{{ state.name }}_history = current_state_{{ region.name }}_{{ state.name }};
{% endif %}
                /* 停止并删除当前状态的超时定时器 */
{% if state.after %}
                if ({{ region.name }}_{{ state.name }}_timeout_handle) {
                    RTC_TimerStop({{ region.name }}_{{ state.name }}_timeout_handle);
                    RTC_TimerDelete({{ region.name }}_{{ state.name }}_timeout_handle);
                    {{ region.name }}_{{ state.name }}_timeout_handle = NULL;
                }
{% endif %}
                /* 停止并删除所有 defer 定时器 */
{% for timer_name in defer_timer_names %}
                if ({{ timer_name }}_handle) {
                    RTC_TimerStop({{ timer_name }}_handle);
                    RTC_TimerDelete({{ timer_name }}_handle);
                    {{ timer_name }}_handle = NULL;
                }
{% endfor %}
{{ process_actions_for_region(region.name, trans.actions) | indent(16, true) }}
                *p_curr = STATE_{{ region.name }}_{{ trans.target }};
                /* 执行目标状态的进入动作并启动时间序列 */
{% for s in region.states %}
{% if s.name == trans.target %}
{% if s.on_entry %}
{{ process_actions_for_region(region.name, s.on_entry) | indent(16, true) }}
{% endif %}
{% if s.after %}
                {
                    uint32_t period = {{ s.after }};
                    rtc_timer_handle_t h = RTC_TimerCreate(period, RTC_TIMER_MODE_ONE_SHOT,
                                                           {{ region.name }}_{{ s.name }}_timeout_cb, NULL);
                    {{ region.name }}_{{ s.name }}_timeout_handle = h;
                    RTC_TimerStart(h);
                }
{% endif %}
{% endif %}
{% endfor %}
{% if state.states %}
                /* 若目标也是复合状态，初始化子状态（考虑历史） */
{% for s in region.states %}
{% if s.name == trans.target and s.states %}
{% if s.history %}
                current_state_{{ region.name }}_{{ s.name }} = current_state_{{ region.name }}_{{ s.name }}_history;
{% else %}
                current_state_{{ region.name }}_{{ s.name }} = STATE_{{ region.name }}_{{ s.name }}_{{ s.initial_state or s.states[0].name }};
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
            }
{% endfor %}
            break;
{% endfor %}
        }
    }
{% endfor %}
{% else %}
    /* 单区域状态机（传统模式） */
    switch (current_state) {
{% for state in business_flow.states %}
    case STATE_{{ state.name }}:
{% if state.states %}
        {
            int handled = 0;
            switch (current_state_{{ state.name }}) {
{% for nested in state.states %}
            case STATE_{{ state.name }}_{{ nested.name }}:
{% for trans in nested.transitions %}
                if (evt->id == EVENT_{{ trans.event | replace(' ', '_') }}) {
{{ process_actions(trans.actions) | indent(20, true) }}
{% if trans.target %}
                    current_state_{{ state.name }} = STATE_{{ state.name }}_{{ trans.target }};
{% endif %}
                    handled = 1;
                    break;
                }
{% endfor %}
                break;
{% endfor %}
            }
            if (handled) break;
        }
{% endif %}
{% for trans in state.transitions %}
{% if loop.first %}
        if (
{% else %}
        else if (
{% endif %}
{% if trans.guard %}
            ({{ trans.guard }}) &&
{% endif %}
            (evt->id == EVENT_{{ trans.event | replace(' ', '_') }})
        ) {
{% if state.on_exit %}
{{ process_actions(state.on_exit) | indent(12, true) }}
{% endif %}
{% if state.states and state.history %}
            current_state_{{ state.name }}_history = current_state_{{ state.name }};
{% endif %}
            /* 停止并删除当前状态的超时定时器 */
{% if state.after %}
            if ({{ state.name }}_timeout_handle) {
                RTC_TimerStop({{ state.name }}_timeout_handle);
                RTC_TimerDelete({{ state.name }}_timeout_handle);
                {{ state.name }}_timeout_handle = NULL;
            }
{% endif %}
            /* 停止并删除所有 defer 定时器 */
{% for timer_name in defer_timer_names %}
            if ({{ timer_name }}_handle) {
                RTC_TimerStop({{ timer_name }}_handle);
                RTC_TimerDelete({{ timer_name }}_handle);
                {{ timer_name }}_handle = NULL;
            }
{% endfor %}
{{ process_actions(trans.actions) | indent(12, true) }}
            current_state = STATE_{{ trans.target }};
            /* 执行目标状态的进入动作并启动时间序列 */
{% for s in business_flow.states %}
{% if s.name == trans.target %}
{% if s.on_entry %}
{{ process_actions(s.on_entry) | indent(12, true) }}
{% endif %}
{% if s.after %}
            {
                uint32_t period = {{ s.after }};
                rtc_timer_handle_t h = RTC_TimerCreate(period, RTC_TIMER_MODE_ONE_SHOT,
                                                       {{ s.name }}_timeout_cb, NULL);
                {{ s.name }}_timeout_handle = h;
                RTC_TimerStart(h);
            }
{% endif %}
{% endif %}
{% endfor %}
{% if state.states %}
            /* 若目标也是复合状态，初始化子状态（考虑历史） */
{% for s in business_flow.states %}
{% if s.name == trans.target and s.states %}
{% if s.history %}
            current_state_{{ s.name }} = current_state_{{ s.name }}_history;
{% else %}
            current_state_{{ s.name }} = STATE_{{ s.name }}_{{ s.initial_state or s.states[0].name }};
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
        }
{% endfor %}
        break;
{% endfor %}
    }
{% endif %}
