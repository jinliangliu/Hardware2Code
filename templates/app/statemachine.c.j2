/* ========== 自定义类型定义 / Custom Type Definitions ========== */
{%- if behavior.types %}
{%- for tdef in behavior.types %}

{%- if tdef.struct is defined and tdef.struct %}
#pragma pack(push, 1)
typedef struct {
{%- for field in tdef.struct %}
{%- if field.fields is defined and field.fields %}
    struct {
{%- for nested in field.fields %}
        {{ nested.type }} {{ nested.name }};
{%- endfor %}
    } {{ field.name }};
{%- else %}
    {{ field.type }} {{ field.name }}{% if field.array is defined and field.array %}[{{ field.array }}]{% endif %};
{%- endif %}
{%- endfor %}
} {{ tdef.name }};
#pragma pack(pop)

{%- elif tdef.enum is defined and tdef.enum %}
typedef enum {
{%- for ev in tdef.enum %}
    {{ ev.name }}{% if ev.value is defined %} = {{ ev.value }}{% endif %},
{%- endfor %}
} {{ tdef.name }};

{%- elif tdef.union is defined and tdef.union %}
typedef union {
{%- for field in tdef.union %}
    {{ field.type }} {{ field.name }}{% if field.array is defined and field.array %}[{{ field.array }}]{% endif %};
{%- endfor %}
} {{ tdef.name }};

{%- elif tdef.bitfield is defined and tdef.bitfield %}
typedef struct {
    {%- set current_byte = namespace(used=0) %}
{%- for bf in tdef.bitfield %}
    uint8_t {{ bf.name }} : {{ bf.width }};
{%- endfor %}
} {{ tdef.name }};

{%- endif %}
{%- endfor %}
{%- endif %}

/* ========== 全局变量 ========== */
{% for var in behavior.get('variables', []) %}
static {{ var.type }} {{ var.name }}{% if var.array is defined and var.array %}[{{ var.array }}]{% endif %} = {{ var.initial }};
{% endfor %}

/* ========== 区域级变量 ========== */
{% if behavior.regions %}
{% for region in behavior.regions %}
{% for var in region.get('variables', []) %}
static {{ var.type }} {{ region.name }}_{{ var.name }}{% if var.array is defined and var.array %}[{{ var.array }}]{% endif %} = {{ var.initial }};
{% endfor %}
{% endfor %}
{% endif %}

/* ========== 状态枚举 ========== */
{% if behavior.regions %}
{% for region in behavior.regions %}
{% for state in region.states %}
#define STATE_{{ region.name }}_{{ state.name }} {{ state._enum }}
{% if state.states %}
{% for nested in state.states %}
#define STATE_{{ region.name }}_{{ state.name }}_{{ nested.name }} {{ nested._enum }}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
{% else %}
{% for state in behavior.states %}
#define STATE_{{ state.name }} {{ state._enum }}
{% if state.states %}
{% for nested in state.states %}
#define STATE_{{ state.name }}_{{ nested.name }} {{ nested._enum }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

/* ========== 当前状态变量 ========== */
{% if behavior.regions %}
{% for region in behavior.regions %}
static uint32_t current_state_{{ region.name }};
{% for state in region.states %}
{% if state.states %}
static uint32_t current_state_{{ region.name }}_{{ state.name }};
{% endif %}
{% endfor %}
{% endfor %}
{% else %}
static uint32_t current_state;
{% for state in behavior.states %}
{% if state.states %}
static uint32_t current_state_{{ state.name }};
{% endif %}
{% endfor %}
{% endif %}

/* ========== 历史状态变量 ========== */
{% if behavior.regions %}
{% for region in behavior.regions %}
{% for state in region.states %}
{% if state.states and state.history %}
static uint32_t current_state_{{ region.name }}_{{ state.name }}_history = STATE_{{ region.name }}_{{ state.name }}_{{ state.initial_state or state.states[0].name }};
{% endif %}
{% endfor %}
{% endfor %}
{% else %}
{% for state in behavior.states %}
{% if state.states and state.history %}
static uint32_t current_state_{{ state.name }}_history = STATE_{{ state.name }}_{{ state.initial_state or state.states[0].name }};
{% endif %}
{% endfor %}
{% endif %}

/* ========== 动作实现宏 ========== */
{% macro action_impl(action, region_name='') -%}
{% if action == 'toggle_led' %}
{% if has_led_task %}
extern void led_task_notify(void);
led_task_notify();
{% elif has_led %}
HAL_GPIO_TogglePin(LED_GPIO_Port, LED_GPIO_Pin);
