/**
 * @file  attitude.c
 * @brief Attitude estimation implementation (generated by hw2c)
 */

#include "attitude.h"
#include <math.h>

#ifndef ATT_RAD2DEG
#define ATT_RAD2DEG (180.0f / 3.14159265358979f)
#endif

/* Gravity-magnitude trust window: within +/-25% of 1g the accelerometer
 * is treated as an attitude reference; outside it (linear acceleration,
 * vibration) the filter falls back to pure gyro integration. */
#define ATT_TRUST_WINDOW 0.25f

void attitude_init(attitude_t *a, float roll_deg, float pitch_deg, float yaw_deg)
{
    if (a == NULL) {
        return;
    }
    a->roll_deg       = roll_deg;
    a->pitch_deg      = pitch_deg;
    a->yaw_deg        = yaw_deg;
    a->alpha          = 0.98f;
    a->last_tick_ms   = 0;
    a->initialized    = 0;
}

void attitude_reset(attitude_t *a)
{
    if (a == NULL) {
        return;
    }
    a->roll_deg     = 0.0f;
    a->pitch_deg    = 0.0f;
    a->yaw_deg      = 0.0f;
    a->last_tick_ms = 0;
    a->initialized  = 0;
}

void attitude_set_alpha(attitude_t *a, float alpha)
{
    if (a == NULL) {
        return;
    }
    if (alpha < 0.0f)      alpha = 0.0f;
    if (alpha > 1.0f)      alpha = 1.0f;
    a->alpha = alpha;
}

void attitude_update(attitude_t *a, uint32_t now_ms,
                     float gx_dps, float gy_dps, float gz_dps,
                     float ax_g, float ay_g, float az_g)
{
    float dt, dt_ms, acc_roll, acc_pitch, mag, trust, w, yaw;

    if (a == NULL) {
        return;
    }
    if (!a->initialized) {
        a->last_tick_ms = now_ms;
        a->initialized  = 1;
        return;
    }

    dt_ms = (uint32_t)(now_ms - a->last_tick_ms);
    a->last_tick_ms = now_ms;
    if (dt_ms == 0) {
        return;
    }
    if (dt_ms > 1000) {
        dt_ms = 1000;              /* clamp long stalls (sleep etc.) */
    }
    dt = (float)dt_ms / 1000.0f;

    /* Accelerometer reference attitude. */
    acc_roll  = atan2f(ay_g, az_g) * ATT_RAD2DEG;
    acc_pitch = atan2f(-ax_g, sqrtf(ay_g * ay_g + az_g * az_g)) * ATT_RAD2DEG;

    /* Trust accelerometer only near 1 g. */
    mag = sqrtf(ax_g * ax_g + ay_g * ay_g + az_g * az_g);
    trust = 1.0f - fabsf(mag - 1.0f) / ATT_TRUST_WINDOW;
    if (trust < 0.0f) {
        trust = 0.0f;
    } else if (trust > 1.0f) {
        trust = 1.0f;
    }
    w = 1.0f - (1.0f - a->alpha) * trust;   /* gyro weight */

    /* Complementary fusion: gyro integration blended with accel ref. */
    a->roll_deg  = w * (a->roll_deg  + gx_dps * dt) + (1.0f - w) * acc_roll;
    a->pitch_deg = w * (a->pitch_deg + gy_dps * dt) + (1.0f - w) * acc_pitch;

    /* Yaw: pure gyro integration (no magnetometer). */
    a->yaw_deg += gz_dps * dt;

    /* Keep yaw in [-180, 180). */
    yaw = a->yaw_deg;
    yaw = yaw - 360.0f * floorf(yaw / 360.0f + 0.5f);
    a->yaw_deg = yaw;
}

void attitude_get(const attitude_t *a, float *roll_deg, float *pitch_deg, float *yaw_deg)
{
    if (a == NULL) {
        return;
    }
    if (roll_deg)  *roll_deg  = a->roll_deg;
    if (pitch_deg) *pitch_deg = a->pitch_deg;
    if (yaw_deg)   *yaw_deg   = a->yaw_deg;
}
